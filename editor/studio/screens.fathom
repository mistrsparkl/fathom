to on window key, given event (a number):
  set key to key of the event event
  if the focused element is catcher: cease
  if paused and key is one of ("F5", "F10", "F11"):
    hold back the event event
    if key is "F5" and not shift held in the event event: debug say with "go"
    otherwise if key is "F10": debug say with "over"
    otherwise if key is "F11" and shift held in the event event: debug say with "out"
    otherwise if key is "F11": debug say with "step"
  otherwise if key is "F9":
    hold back the event event
    start running with "debug"
  otherwise if key is one of ("F5", "F6", "F7", "F8"):
    hold back the event event
    if shift held in the event event and key is "F5": stop running
    otherwise if key is "F5": start running with "run"
    otherwise if key is "F6": start running with "watch"
    otherwise if key is "F7": start running with "test"
    otherwise: start running with "build"
  if control held in the event event and key is one of ("s", "S"):
    hold back the event event
    save the sheet

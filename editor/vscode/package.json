{
  "name": "stellanova",
  "displayName": "Stellanova",
  "description": "Colours, indenting, shortcuts, mistakes shown while typing, word completion and help on hover for the Stellanova language (.stella files).",
  "version": "0.4.0",
  "publisher": "speda",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "stellanova",
        "aliases": [
          "Stellanova"
        ],
        "extensions": [
          ".stella"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stellanova",
        "scopeName": "source.stellanova",
        "path": "./syntaxes/stellanova.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "stellanova",
        "path": "./snippets.json"
      }
    ],
    "configurationDefaults": {
      "[stellanova]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "configuration": {
      "title": "Stellanova",
      "properties": {
        "stellanova.home": {
          "type": "string",
          "default": "",
          "description": "The folder holding stellanova.py. Empty: the folder on PATH that has it."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:stellanova"
  ]
}

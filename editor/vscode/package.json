{
  "name": "cosmonova",
  "displayName": "Cosmonova",
  "description": "Colours, indenting and shortcuts for the Cosmonova language (.cosmos files).",
  "version": "0.3.0",
  "publisher": "speda",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cosmonova",
        "aliases": [
          "Cosmonova"
        ],
        "extensions": [
          ".cosmos"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cosmonova",
        "scopeName": "source.cosmonova",
        "path": "./syntaxes/cosmonova.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cosmonova",
        "path": "./snippets.json"
      }
    ],
    "configurationDefaults": {
      "[cosmonova]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    }
  }
}
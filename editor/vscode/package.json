{
  "name": "fathom",
  "displayName": "Fathom",
  "description": "Colours, indenting, shortcuts, mistakes shown while typing, word completion and help on hover for the Fathom language (.fathom files).",
  "version": "0.4.0",
  "publisher": "speda",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fathom",
        "aliases": [
          "Fathom"
        ],
        "extensions": [
          ".fathom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fathom",
        "scopeName": "source.fathom",
        "path": "./syntaxes/fathom.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fathom",
        "path": "./snippets.json"
      }
    ],
    "configurationDefaults": {
      "[fathom]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "configuration": {
      "title": "Fathom",
      "properties": {
        "fathom.home": {
          "type": "string",
          "default": "",
          "description": "The folder holding fathom.py. Empty: the folder on PATH that has it."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:fathom"
  ]
}

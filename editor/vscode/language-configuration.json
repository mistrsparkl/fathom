{
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": ":\\s*$",
    "decreaseIndentPattern": "^\\s*(otherwise\\b.*:|if that went wrong:)\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": ":\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "comments": {
    "lineComment": "whisper:"
  }
}
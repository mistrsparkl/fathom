note: Words for being a web server: other programs (and web browsers) on this computer can ask it for pages.
note: Use them in a program with:  use: server
note: The command it is given gets the address asked for (like "/hello" or "/scores?top=3") and gives back the page, as text.
note: What a page is (a web page, a style sheet, a script, a picture) is told to the browser from the address's ending (.css, .js, .png ...).
note: An answer that is saved text (starting with { or [) goes as data. 'answer with the status 404' says the page isn't there.

code:
  #define NOMINMAX
include: "sockets.h"
include: <filesystem>
include: <fstream>
link: ws2_32

code:
  namespace stellanova_server
  {
  	inline std::string message;  // what was sent with the request being answered ('the web message')
  	inline std::string file_asked;  // 'answer with the file': sent instead of the answer's text
  	inline std::string way;  // 'the web way': GET, POST...
  	inline double status = 200;  // 'answer with the status 404'

  	inline std::string status_words(double code)
  	{
  		static const std::pair<int, const char*> words[] = {{200, "OK"}, {201, "Created"}, {204, "No Content"}, {301, "Moved Permanently"},
  			{302, "Found"}, {400, "Bad Request"}, {401, "Unauthorized"}, {403, "Forbidden"}, {404, "Not Found"}, {405, "Method Not Allowed"},
  			{500, "Internal Server Error"}};
  		for (const auto& [n, w] : words)
  			if (n == (int)code)
  				return w;
  		return "Answer";
  	}
  	inline bool looks_like_data(const std::string& page)  // saved text ('book as saved text') goes as data, not as a web page
  	{
  		size_t k = page.find_first_not_of(" \t\r\n");
  		return k != std::string::npos && (page[k] == '{' || page[k] == '[');
  	}

  	inline std::string kind_of_page(const std::string& path)
  	{
  		std::string name = path.substr(0, path.find('?'));
  		std::string end = name.substr(name.find_last_of('.') == std::string::npos ? name.size() : name.find_last_of('.'));
  		static const std::pair<const char*, const char*> kinds[] = {
  			{".css", "text/css; charset=utf-8"}, {".js", "text/javascript; charset=utf-8"}, {".json", "application/json; charset=utf-8"},
  			{".svg", "image/svg+xml"}, {".png", "image/png"}, {".jpg", "image/jpeg"}, {".jpeg", "image/jpeg"}, {".gif", "image/gif"},
  			{".ico", "image/x-icon"}, {".woff2", "font/woff2"}, {".woff", "font/woff"}, {".ttf", "font/ttf"}, {".mp3", "audio/mpeg"},
  			{".wav", "audio/wav"}, {".txt", "text/plain; charset=utf-8"}, {".webp", "image/webp"}};
  		for (const auto& [e, k] : kinds)
  			if (stellanova::lower(end) == e)
  				return k;
  		return "text/html; charset=utf-8";
  	}

  	inline std::string decoded(const std::string& s)
  	{
  		std::string out;
  		for (size_t i = 0; i < s.size(); ++i)
  		{
  			if (s[i] == '+')
  				out += ' ';
  			else if (s[i] == '%' && i + 2 < s.size() && std::isxdigit((unsigned char)s[i + 1]) && std::isxdigit((unsigned char)s[i + 2]))
  			{
  				out += (char)std::stoi(s.substr(i + 1, 2), nullptr, 16);
  				i += 2;
  			}
  			else
  				out += s[i];
  		}
  		return out;
  	}

  	inline std::string encoded(const std::string& s)
  	{
  		static const char* hex = "0123456789ABCDEF";
  		std::string out;
  		for (unsigned char c : s)
  		{
  			if (std::isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~')
  				out += (char)c;
  			else
  			{
  				out += '%';
  				out += hex[c >> 4];
  				out += hex[c & 15];
  			}
  		}
  		return out;
  	}

  	// The file in folder that path names, if there is one (and it is inside the folder).
  	inline bool file_for(const std::string& folder, const std::string& path, std::string& bytes)
  	{
  		if (folder.empty())
  			return false;
  		std::string name = decoded(path.substr(0, path.find('?')));
  		if (name == "/")
  			name = "/index.html";
  		if (name.find("..") != std::string::npos)
  			return false;
  		std::filesystem::path file = std::filesystem::u8path(folder + name);
  		std::error_code e;
  		if (!std::filesystem::is_regular_file(file, e))
  			return false;
  		std::ifstream in(file, std::ios::binary);
  		bytes.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
  		return true;
  	}

  	inline void serve_from(double port, const std::string& folder, const std::function<std::string(std::string)>& answer, int line)
  	{
  		WSADATA data;
  		WSAStartup(MAKEWORD(2, 2), &data);
  		SOCKET listener = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
  #ifndef _WIN32
  		int again = 1;  // Linux: the port again straight after another server closed it (as Python's server does)
  		setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &again, sizeof again);
  #endif
  		sockaddr_in where{};
  		where.sin_family = AF_INET;
  		where.sin_port = htons((u_short)port);
  		where.sin_addr.s_addr = htonl(INADDR_LOOPBACK);  // this computer only, so Windows doesn't ask about its firewall
  		if (listener == INVALID_SOCKET || bind(listener, (sockaddr*)&where, sizeof where) != 0 || listen(listener, 16) != 0)
  			stellanova::fail(line, "I couldn't serve the web on port " + stellanova::text(port) + " (is something else using it?).");
  		for (;;)
  		{
  			SOCKET client = accept(listener, nullptr, nullptr);
  			if (client == INVALID_SOCKET)
  				continue;
  			std::string asked;
  			char chunk[4096];
  			while (asked.find("\r\n\r\n") == std::string::npos)
  			{
  				int got = recv(client, chunk, sizeof chunk, 0);
  				if (got <= 0)
  					break;
  				asked.append(chunk, got);
  			}
  			size_t head_end = asked.find("\r\n\r\n");
  			size_t length = 0;
  			std::string low = stellanova::lower(asked.substr(0, head_end));
  			size_t at = low.find("content-length:");
  			if (at != std::string::npos)
  				length = (size_t)std::strtoul(low.c_str() + at + 15, nullptr, 10);
  			message = head_end == std::string::npos ? "" : asked.substr(head_end + 4);
  			while (message.size() < length)
  			{
  				int got = recv(client, chunk, sizeof chunk, 0);
  				if (got <= 0)
  					break;
  				message.append(chunk, got);
  			}
  			size_t a = asked.find(' '), b = a == std::string::npos ? a : asked.find(' ', a + 1);
  			std::string path = b == std::string::npos ? "/" : asked.substr(a + 1, b - a - 1);
  			way = a == std::string::npos ? "GET" : asked.substr(0, a);
  			status = 200;
  			std::string page, kind = kind_of_page(path == "/" && !folder.empty() ? "/index.html" : path);
  			if (!file_for(folder, path, page))
  			{
  				file_asked.clear();
  				page = stellanova::invoke(answer, line, path);
  				if (kind.rfind("text/html", 0) == 0 && looks_like_data(page))
  					kind = "application/json; charset=utf-8";
  				if (!file_asked.empty())
  				{
  					std::ifstream in(std::filesystem::u8path(file_asked), std::ios::binary);
  					page.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
  					kind = kind_of_page(file_asked);
  				}
  			}
  			std::string reply = "HTTP/1.1 " + std::to_string((int)status) + " " + status_words(status) + "\r\nContent-Type: " + kind +
  				"\r\nCache-Control: no-store\r\nContent-Length: " + std::to_string(page.size()) + "\r\nConnection: close\r\n\r\n" + page;
  			for (size_t sent = 0; sent < reply.size();)
  			{
  				int put = send(client, reply.data() + sent, (int)(reply.size() - sent), 0);
  				if (put <= 0)
  					break;
  				sent += put;
  			}
  			shutdown(client, SD_SEND);
  			closesocket(client);
  		}
  	}
  	inline void answer_with(const std::string& name, int line)
  	{
  		std::error_code e;
  		if (!std::filesystem::is_regular_file(std::filesystem::u8path(name), e))
  			stellanova::fail(line, "there is no file called " + name + ".");
  		file_asked = name;
  	}
  	inline void answer_with_status(double code, int line)
  	{
  		if (std::floor(code) != code || code < 100 || code > 599)
  			stellanova::fail(line, "a web status is a whole number from 100 to 599, like 404, not " + stellanova::text(code) + ".");
  		status = code;
  	}
  	inline void serve(double port, const std::function<std::string(std::string)>& answer, int line) { serve_from(port, "", answer, line); }
  }

python:
  import http.server, os.path, urllib.parse
  MESSAGE = [""]
  FILE_ASKED = [""]
  WAY = ["GET"]
  STATUS = [200]
  def answer_with_status(code):
      if code != int(code) or not 100 <= code <= 599:
          raise RunError(0, "a web status is a whole number from 100 to 599, like 404, not " + text(code) + ".")
      STATUS[0] = int(code)
  def looks_like_data(page):
      return page.lstrip()[:1] in ("{", "[")
  def answer_with(name):
      if not os.path.isfile(name):
          raise RunError(0, "there is no file called " + name + ".")
      FILE_ASKED[0] = name
  KINDS = {".css": "text/css; charset=utf-8", ".js": "text/javascript; charset=utf-8", ".json": "application/json; charset=utf-8",
           ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
           ".ico": "image/x-icon", ".woff2": "font/woff2", ".woff": "font/woff", ".ttf": "font/ttf", ".mp3": "audio/mpeg",
           ".wav": "audio/wav", ".txt": "text/plain; charset=utf-8", ".webp": "image/webp"}
  def kind_of_page(path):
      return KINDS.get(os.path.splitext(path.split("?")[0])[1].lower(), "text/html; charset=utf-8")
  def file_for(folder, path):
      if not folder:
          return None
      name = urllib.parse.unquote_plus(path.split("?")[0])
      if name == "/":
          name = "/index.html"
      if ".." in name:
          return None
      file = folder + name
      if not os.path.isfile(file):
          return None
      with open(file, "rb") as f:
          return f.read()
  def serve_from(port, folder, answer):
      class Handler(http.server.BaseHTTPRequestHandler):
          def do_GET(self):
              length = int(self.headers.get("Content-Length") or 0)
              MESSAGE[0] = self.rfile.read(length).decode("utf-8", "replace") if length else ""
              page = file_for(folder, self.path)
              kind = kind_of_page("/index.html" if self.path == "/" and folder else self.path)
              WAY[0], STATUS[0] = self.command, 200
              if page is None:
                  FILE_ASKED[0] = ""
                  said = answer(self.path)
                  if kind.startswith("text/html") and looks_like_data(said):
                      kind = "application/json; charset=utf-8"
                  page = said.encode("utf-8", "surrogateescape")
                  if FILE_ASKED[0]:
                      with open(FILE_ASKED[0], "rb") as f:
                          page = f.read()
                      kind = kind_of_page(FILE_ASKED[0])
              self.send_response(STATUS[0])
              self.send_header("Content-Type", kind)
              self.send_header("Cache-Control", "no-store")
              self.send_header("Content-Length", str(len(page)))
              self.send_header("Connection", "close")
              self.end_headers()
              self.wfile.write(page)
          do_POST = do_PUT = do_DELETE = do_PATCH = do_GET
          def log_message(self, *args):
              pass
      try:
          server = http.server.HTTPServer(("127.0.0.1", int(port)), Handler)
      except OSError:
          raise RunError(0, "I couldn't serve the web on port " + text(port) + " (is something else using it?).")
      server.serve_forever()

to serve the web, given port (a number) and answer (a command given text returning text) = stellanova_server::serve({port}, {answer}, {line})
  runs: serve_from({port}, "", {answer})
  web: await stellanova_server_web.serve({port}, "", {answer}, {line})
to serve the web from the folder, given port (a number) and folder (text) and answer (a command given text returning text) = stellanova_server::serve_from({port}, {folder}, {answer}, {line})
  runs: serve_from({port}, {folder}, {answer})
  web: await stellanova_server_web.serve({port}, {folder}, {answer}, {line})
the web message = stellanova_server::message, text, read only
  runs: MESSAGE[0]
  web: stellanova_server_web.message
the web way = stellanova_server::way, text, read only
  runs: WAY[0]
  web: stellanova_server_web.way
to answer with the status, given code (a number) = stellanova_server::answer_with_status({code}, {line})
  runs: answer_with_status({code})
  web: stellanova_server_web.answerWithStatus({code}, {line})
to web decoded, given piece (text), returning text = stellanova_server::decoded({piece})
  runs: urllib.parse.unquote_plus({piece})
  web: stellanova_server_web::decoded({piece})
to web encoded, given piece (text), returning text = stellanova_server::encoded({piece})
  runs: urllib.parse.quote({piece}, safe="-_.~")
  web: encodeURIComponent({piece})
to answer with the file, given name (text) = stellanova_server::answer_with({name}, {line})
  runs: answer_with({name})
  web: stellanova_server_web.answerWith({name}, {line})

javascript:
  const stellanova_server_web = {
    message: "",
    asked: "",
    way: "GET",
    status: 200,
    answerWithStatus(code, line) {
      if (Math.floor(code) !== code || code < 100 || code > 599)
        stellanova.fail(line, `a web status is a whole number from 100 to 599, like 404, not ${stellanova.text(code)}.`);
      this.status = code;
    },
    decoded(piece) {
      try {
        return decodeURIComponent(piece.replace(/\+/g, " "));
      } catch {
        return piece;
      }
    },
    kinds: { ".css": "text/css; charset=utf-8", ".js": "text/javascript; charset=utf-8", ".json": "application/json; charset=utf-8",
             ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
             ".ico": "image/x-icon", ".woff2": "font/woff2", ".woff": "font/woff", ".ttf": "font/ttf", ".mp3": "audio/mpeg",
             ".wav": "audio/wav", ".txt": "text/plain; charset=utf-8", ".webp": "image/webp" },
    kindOf(path) {
      const m = /\.[^./]*$/.exec(path.split("?")[0]);
      return (m && this.kinds[m[0].toLowerCase()]) || "text/html; charset=utf-8";
    },
    answerWith(name, line) {
      const fs = require("fs");
      let file = false;
      try { file = fs.statSync(name).isFile(); } catch {}
      if (!file) stellanova.fail(line, `there is no file called ${name}.`);
      this.asked = name;
    },
    fileFor(folder, path) {
      if (!folder) return null;
      let name = this.decoded(path.split("?")[0]);
      if (name === "/") name = "/index.html";
      if (name.includes("..")) return null;
      try { return require("fs").readFileSync(folder + name); } catch { return null; }
    },
    serve(port, folder, answer, line) {
      if (typeof require !== "function") stellanova.fail(line, "a web page can't serve the web (this works with node).");
      const http = require("http"), fs = require("fs");
      let turn = Promise.resolve();  // one request at a time, so 'the web message' is the one being answered
      const server = http.createServer((request, response) => {
        const parts = [];
        request.on("data", (d) => parts.push(d));
        request.on("end", () => {
          turn = turn.then(async () => {
            this.message = Buffer.concat(parts).toString("utf8");
            this.way = request.method;
            this.status = 200;
            let page = this.fileFor(folder, request.url), kind = this.kindOf(request.url === "/" && folder ? "/index.html" : request.url);
            if (page === null) {
              this.asked = "";
              try {
                const said = String(await answer(request.url));
                if (kind.startsWith("text/html") && /^\s*[\[{]/.test(said)) kind = "application/json; charset=utf-8";
                page = Buffer.from(said, "utf8");
              } catch (e) {
                stellanova.report(e);
                page = Buffer.from("", "utf8");
              }
              if (this.asked) page = fs.readFileSync(this.asked), kind = this.kindOf(this.asked);
            }
            response.writeHead(this.status, { "Content-Type": kind, "Cache-Control": "no-store", "Content-Length": page.length, Connection: "close" });
            response.end(page);
          });
        });
      });
      return new Promise((resolve, reject) => {  // it never ends: serving is all it does
        server.once("error", () => reject(new stellanova.Problem(line, `I couldn't serve the web on port ${stellanova.text(port)} (is something else using it?).`)));
        server.listen(port, "127.0.0.1");
      });
    },
  };

note: Numbers behind letters. Use: use: letters

code:
  namespace fathom_letters
  {
  	inline double code_of(const std::string& s, int line)
  	{
  		if (s.empty())
  			fathom::fail(line, "'code of the letter' needs a letter, but the text is empty.");
  		unsigned char c = (unsigned char)s[0];
  		int extra = c < 0x80 ? 0 : c < 0xE0 ? 1 : c < 0xF0 ? 2 : 3;
  		unsigned code = extra == 0 ? c : extra == 1 ? c & 0x1F : extra == 2 ? c & 0x0F : c & 0x07;
  		for (int k = 1; k <= extra && k < (int)s.size(); ++k)
  			code = (code << 6) | ((unsigned char)s[k] & 0x3F);
  		return (double)code;
  	}
  	inline std::string letter_with(double number, int line)
  	{
  		if (number < 0 || number > 0x10FFFF || number != (double)(long long)number || (number >= 0xD800 && number <= 0xDFFF))
  			fathom::fail(line, "there is no letter with the code " + fathom::text(number) + ".");
  		unsigned c = (unsigned)number;
  		std::string out;
  		if (c < 0x80)
  			out += (char)c;
  		else if (c < 0x800)
  			out += (char)(0xC0 | (c >> 6)), out += (char)(0x80 | (c & 0x3F));
  		else if (c < 0x10000)
  			out += (char)(0xE0 | (c >> 12)), out += (char)(0x80 | ((c >> 6) & 0x3F)), out += (char)(0x80 | (c & 0x3F));
  		else
  			out += (char)(0xF0 | (c >> 18)), out += (char)(0x80 | ((c >> 12) & 0x3F)), out += (char)(0x80 | ((c >> 6) & 0x3F)), out += (char)(0x80 | (c & 0x3F));
  		return out;
  	}
  	inline std::vector<double> bytes_of(const std::string& s)
  	{
  		std::vector<double> out;
  		for (unsigned char c : s)
  			out.push_back((double)c);
  		return out;
  	}
  	inline std::string text_of(const std::vector<double>& bytes, int line)
  	{
  		std::string out;
  		for (double x : bytes)
  		{
  			if (x < 0 || x > 255 || x != (double)(int)x)
  				fathom::fail(line, "a byte is a whole number from 0 to 255, not " + fathom::text(x) + ".");
  			out += (char)(unsigned char)x;
  		}
  		return out;
  	}
  }

python:
  def code_of(s):
      if not s:
          raise RunError(0, "'code of the letter' needs a letter, but the text is empty.")
      return float(ord(s[0]))
  def letter_with(number):
      if number < 0 or number > 0x10FFFF or number != int(number) or 0xD800 <= number <= 0xDFFF:
          raise RunError(0, "there is no letter with the code " + text(number) + ".")
      return chr(int(number))
  def text_of(numbers):
      for x in numbers:
          if x < 0 or x > 255 or x != int(x):
              raise RunError(0, "a byte is a whole number from 0 to 255, not " + text(x) + ".")
      return bytes(int(x) for x in numbers).decode("utf-8", "replace")

to code of the letter, given letter (text), returning a number = fathom_letters::code_of({letter}, {line})
  runs: code_of({letter})
  web: fathom_letters::code_of({letter}, {line})
to the letter with code, given code (a number), returning text = fathom_letters::letter_with({code}, {line})
  runs: letter_with({code})
  web: fathom_letters::letter_with({code}, {line})
to the bytes of the text, given words (text), returning a list of numbers = fathom_letters::bytes_of({words})
  runs: [float(b) for b in {words}.encode("utf-8")]
  web: Array.from(new TextEncoder().encode({words}))
to the text of the bytes, given bytes (a list of numbers), returning text = fathom_letters::text_of({bytes}, {line})
  runs: text_of({bytes})
  web: fathom_letters.text_of({bytes}, {line})

javascript:
  const fathom_letters = {
    code_of(s, line) {
      if (!s) fathom.fail(line, "'code of the letter' needs a letter, but the text is empty.");
      return s.codePointAt(0);
    },
    letter_with(n, line) {
      if (n < 0 || n > 0x10FFFF || n !== Math.trunc(n) || (n >= 0xD800 && n <= 0xDFFF))
        fathom.fail(line, "there is no letter with the code " + fathom.text(n) + ".");
      return String.fromCodePoint(n);
    },
    text_of(bytes, line) {
      for (const x of bytes) if (x < 0 || x > 255 || x !== Math.trunc(x)) fathom.fail(line, "a byte is a whole number from 0 to 255, not " + fathom.text(x) + ".");
      return new TextDecoder().decode(new Uint8Array(bytes));
    },
  };

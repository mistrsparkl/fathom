javascript:
  const fathom_folders = {
    fs(line) {
      if (typeof require !== "function") fathom.fail(line, "a web page has no folders (this works with node).");
      return require("fs");
    },
    isDir(fs, p) { try { return fs.statSync(p).isDirectory(); } catch { return false; } },
    isFile(fs, p) { try { return fs.statSync(p).isFile(); } catch { return false; } },
    inside(folder, folders, line) {
      const fs = this.fs(line), path = require("path");
      if (!this.isDir(fs, folder)) fathom.fail(line, `there is no folder called "${folder}".`);
      let names;
      try { names = fs.readdirSync(folder); } catch { fathom.fail(line, `I couldn't look inside the folder "${folder}".`); }
      return names.filter((n) => this.isDir(fs, path.join(folder, n)) === folders).sort();
    },
    isFolder(folder, line) { return this.isDir(this.fs(line), folder); },
    make(folder, line) {
      try { this.fs(line).mkdirSync(folder, { recursive: true }); } catch { fathom.fail(line, `I couldn't make the folder "${folder}".`); }
    },
    erase(name, line) {
      const fs = this.fs(line);
      try { if (!this.isFile(fs, name)) throw 0; fs.unlinkSync(name); } catch { fathom.fail(line, `I couldn't erase the file "${name}".`); }
    },
    eraseFolder(name, line) {
      const fs = this.fs(line);
      try { if (!this.isDir(fs, name)) throw 0; fs.rmSync(name, { recursive: true }); } catch { fathom.fail(line, `I couldn't erase the folder "${name}".`); }
    },
    move(a, b, line) {
      const fs = this.fs(line);
      try { if (!fs.existsSync(a) || fs.existsSync(b)) throw 0; fs.renameSync(a, b); } catch { fathom.fail(line, `I couldn't move "${a}" to "${b}".`); }
    },
    copy(a, b, line) {
      const fs = this.fs(line);
      try { if (!this.isFile(fs, a)) throw 0; fs.copyFileSync(a, b); } catch { fathom.fail(line, `I couldn't copy "${a}" to "${b}".`); }
    },
    size(name, line) {
      try { return this.fs(line).statSync(name).size; } catch { fathom.fail(line, `there is no file called "${name}".`); }
    },
    bytesOf(name, line) {
      let b;
      try { b = this.fs(line).readFileSync(name); } catch { fathom.fail(line, `there is no file called "${name}".`); }
      return Array.from(b);
    },
    fill(name, numbers, line) {
      for (const x of numbers) if (x < 0 || x > 255 || x !== Math.floor(x)) fathom.fail(line, `a byte is a whole number from 0 to 255, not ${fathom.text(x)}.`);
      try { this.fs(line).writeFileSync(name, Buffer.from(numbers)); } catch { fathom.fail(line, `I couldn't write the file "${name}".`); }
    },
  };

note: Parts of a path.
code:
  namespace fathom_folders
  {
  	inline std::string path_part(const std::string& p, int which)  // 0: file name, 1: extension, 2: folder holding it
  	{
  		size_t cut = p.find_last_of("/\\");
  		std::string file = cut == std::string::npos ? p : p.substr(cut + 1);
  		if (which == 2)
  			return cut == std::string::npos ? "" : p.substr(0, cut);
  		if (which == 0)
  			return file;
  		size_t dot = file.rfind('.');
  		return dot == std::string::npos || dot == 0 ? "" : file.substr(dot + 1);
  	}
  	inline double last_change(const std::string& name, int line)
  	{
  		std::error_code problem;
  		auto when = fs::last_write_time(path(name), problem);
  		if (problem || !fs::is_regular_file(path(name), problem))
  			fathom::fail(line, "there is no file called \"" + name + "\".");
  		auto now = std::chrono::system_clock::now() + (when - fs::file_time_type::clock::now());
  		return std::floor(std::chrono::duration<double>(now.time_since_epoch()).count());
  	}
  }

python:
  def path_part(p, which):
      cut = max(p.rfind("/"), p.rfind("\\"))
      file = p[cut + 1:]
      if which == 2:
          return p[:cut] if cut >= 0 else ""
      if which == 0:
          return file
      dot = file.rfind(".")
      return file[dot + 1:] if dot > 0 else ""
  def last_change(name):
      if not os.path.isfile(name):
          raise RunError(0, 'there is no file called "' + name + '".')
      return float(int(os.path.getmtime(name)))

to file name of, given path (text), returning text = fathom_folders::path_part({path}, 0)
  runs: path_part({path}, 0)
  web: fathom_folders.pathPart({path}, 0)

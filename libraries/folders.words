to last change of the file, given name (text), returning a number = fathom_folders::last_change({name}, {line})
  runs: last_change({name})
  web: fathom_folders.lastChange({name}, {line})

javascript:
  Object.assign(fathom_folders, {
    pathPart(p, which) {
      const cut = Math.max(p.lastIndexOf("/"), p.lastIndexOf("\\")), file = p.slice(cut + 1);
      if (which === 2) return cut >= 0 ? p.slice(0, cut) : "";
      if (which === 0) return file;
      const dot = file.lastIndexOf(".");
      return dot > 0 ? file.slice(dot + 1) : "";
    },
    lastChange(name, line) {
      const fs = this.fs(line);
      if (!this.isFile(fs, name)) fathom.fail(line, `there is no file called "${name}".`);
      return Math.floor(fs.statSync(name).mtimeMs / 1000);
    },
  });

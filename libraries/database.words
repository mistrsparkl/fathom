note: Words for databases (SQLite files, which many programs can read). Use them in a program with:  use: database
note: Write a ? where a value goes and give the values as a list of text, so text from people can't change the command.
note: Answers come back as text, one list per row ("" for an empty cell).
note: shortcut: each word opens and closes the file, fine for small programs; keep it open between words if they need to be faster.
note: On the web this works with node (its own SQLite); a web page has no databases.

code:
  #ifdef _WIN32
  #include <winsqlite/winsqlite3.h>
  #elif defined(__linux__)
  // Linux: the system's own SQLite (libsqlite3.so.0), whose header may not be there
  extern "C"
  {
  	struct sqlite3;
  	struct sqlite3_stmt;
  	int sqlite3_open(const char*, sqlite3**);
  	int sqlite3_close(sqlite3*);
  	const char* sqlite3_errmsg(sqlite3*);
  	int sqlite3_prepare_v2(sqlite3*, const char*, int, sqlite3_stmt**, const char**);
  	int sqlite3_bind_parameter_count(sqlite3_stmt*);
  	int sqlite3_bind_text(sqlite3_stmt*, int, const char*, int, void (*)(void*));
  	int sqlite3_step(sqlite3_stmt*);
  	int sqlite3_column_count(sqlite3_stmt*);
  	int sqlite3_column_type(sqlite3_stmt*, int);
  	double sqlite3_column_double(sqlite3_stmt*, int);
  	const unsigned char* sqlite3_column_text(sqlite3_stmt*, int);
  	int sqlite3_finalize(sqlite3_stmt*);
  }
  #define SQLITE_OK 0
  #define SQLITE_ROW 100
  #define SQLITE_DONE 101
  #define SQLITE_INTEGER 1
  #define SQLITE_FLOAT 2
  #define SQLITE_TRANSIENT ((void (*)(void*)) - 1)
  #endif
link: winsqlite3
linux link: :libsqlite3.so.0

code:
  namespace stellanova_database
  {
  	inline std::vector<std::vector<std::string>> run(const std::string& file, const std::string& command,
  		const std::vector<std::string>& values, int line)
  	{
  		sqlite3* db = nullptr;
  		if (sqlite3_open(file.c_str(), &db) != SQLITE_OK)
  		{
  			std::string why = db ? sqlite3_errmsg(db) : "no memory";
  			sqlite3_close(db);
  			stellanova::fail(line, "I couldn't open the database \"" + file + "\": " + why + ".");
  		}
  		std::vector<std::vector<std::string>> rows;
  		const char* rest = command.c_str();
  		size_t used = 0;
  		while (*rest)
  		{
  			sqlite3_stmt* step = nullptr;
  			const char* next = nullptr;
  			if (sqlite3_prepare_v2(db, rest, -1, &step, &next) != SQLITE_OK)
  			{
  				std::string why = sqlite3_errmsg(db);
  				sqlite3_close(db);
  				stellanova::fail(line, "the database said: " + why + ".");
  			}
  			rest = next;
  			if (!step)
  				continue;  // only spaces or a note
  			int holes = sqlite3_bind_parameter_count(step);
  			for (int k = 1; k <= holes; ++k, ++used)
  				if (used < values.size())
  					sqlite3_bind_text(step, k, values[used].c_str(), -1, SQLITE_TRANSIENT);
  			int status;
  			while ((status = sqlite3_step(step)) == SQLITE_ROW)
  			{
  				std::vector<std::string> row;
  				for (int c = 0; c < sqlite3_column_count(step); ++c)
  				{
  					int type = sqlite3_column_type(step, c);
  					const unsigned char* cell = sqlite3_column_text(step, c);
  					if (type == SQLITE_INTEGER || type == SQLITE_FLOAT)  // numbers written as Stellanova writes them
  						row.push_back(stellanova::text(sqlite3_column_double(step, c)));
  					else
  						row.push_back(cell ? reinterpret_cast<const char*>(cell) : "");
  				}
  				rows.push_back(row);
  			}
  			sqlite3_finalize(step);
  			if (status != SQLITE_DONE)
  			{
  				std::string why = sqlite3_errmsg(db);
  				sqlite3_close(db);
  				stellanova::fail(line, "the database said: " + why + ".");
  			}
  		}
  		sqlite3_close(db);
  		if (used != values.size())
  			stellanova::fail(line, "the command has " + std::to_string(used) + " ?, but there are " + std::to_string(values.size()) + " values.");
  		return rows;
  	}
  }

python:
  import sqlite3
  def database(file, command, values):
      try:
          db = sqlite3.connect(file, isolation_level=None)
      except sqlite3.Error as why:
          raise RunError(0, "I couldn't open the database \"" + file + "\": " + str(why) + ".")
      rows, used = [], 0
      try:
          for part in split_commands(command):
              holes = part.count("?")
              cur = db.execute(part, values[used:used + holes])
              used += holes
              rows += [["" if c is None else text(float(c)) if isinstance(c, (int, float)) and not isinstance(c, bool) else str(c) for c in row]
                       for row in cur.fetchall()]
      except sqlite3.Error as why:
          raise RunError(0, "the database said: " + str(why) + ".")
      except (IndexError, sqlite3.ProgrammingError):
          raise RunError(0, "the command has " + str(command.count("?")) + " ?, but there are " + str(len(values)) + " values.")
      finally:
          db.close()
      if used != len(values):
          raise RunError(0, "the command has " + str(used) + " ?, but there are " + str(len(values)) + " values.")
      return rows
  def split_commands(command):
      parts, now = [], ""
      for piece in command.split(";"):
          now += piece
          if sqlite3.complete_statement(now + ";"):
              if now.strip():
                  parts.append(now)
              now = ""
          else:
              now += ";"
      if now.strip():
          parts.append(now)
      return parts

to change the database, given file (text) and command (text) = stellanova_database::run({file}, {command}, {}, {line})
  runs: database({file}, {command}, [])
  web: stellanova_database.run({file}, {command}, [], {line})
to change the database with values, given file (text) and command (text) and values (a list of text) = stellanova_database::run({file}, {command}, {values}, {line})
  runs: database({file}, {command}, {values})
  web: stellanova_database.run({file}, {command}, {values}, {line})
to rows from the database, given file (text) and question (text), returning a list of lists of text = stellanova_database::run({file}, {question}, {}, {line})
  runs: database({file}, {question}, [])
  web: stellanova_database.run({file}, {question}, [], {line})
to rows from the database with values, given file (text) and question (text) and values (a list of text), returning a list of lists of text = stellanova_database::run({file}, {question}, {values}, {line})
  runs: database({file}, {question}, {values})
  web: stellanova_database.run({file}, {question}, {values}, {line})

javascript:
  const stellanova_database = {
    split(command) {  // shortcut: splits at ; outside quotes and notes, so a trigger's BEGIN ... END breaks; use exec for those if needed
      const parts = [];
      let now = "", quote = null;
      for (let k = 0; k < command.length; k++) {
        const c = command[k];
        if (quote) {
          now += c;
          if (quote === "\n" ? c === "\n" : quote === "*/" ? c === "/" && command[k - 1] === "*" : c === quote) quote = null;
        } else if (c === "'" || c === '"' || c === "`" || c === "[") { quote = c === "[" ? "]" : c; now += c; }
        else if (c === "-" && command[k + 1] === "-") { quote = "\n"; now += c; }
        else if (c === "/" && command[k + 1] === "*") { quote = "*/"; now += c + "*"; k++; }
        else if (c === ";") { if (now.trim()) parts.push(now); now = ""; }
        else now += c;
      }
      if (now.trim() && !/^(\s|--[^\n]*(\n|$)|\/\*[\s\S]*?\*\/)*$/.test(now)) parts.push(now);
      return parts;
    },
    run(file, command, values, line) {
      if (typeof require !== "function") stellanova.fail(line, "a web page has no databases (this works with node).");
      let db;
      try {
        const { DatabaseSync } = require("node:sqlite");
        db = new DatabaseSync(file);
      } catch (e) {
        stellanova.fail(line, `I couldn't open the database "${file}": ${e.message}.`);
      }
      const rows = [];
      let used = 0;
      try {
        for (const part of this.split(command)) {
          let step;
          try { step = db.prepare(part); } catch (e) { stellanova.fail(line, `the database said: ${e.message}.`); }
          const holes = (part.match(/\?/g) || []).length;
          if (used + holes > values.length) stellanova.fail(line, `the command has ${(command.match(/\?/g) || []).length} ?, but there are ${values.length} values.`);
          const given = values.slice(used, used + holes);
          used += holes;
          let got;
          try {
            if (step.columns().length) { step.setReturnArrays(true); got = step.all(...given); }
            else { step.run(...given); got = []; }
          } catch (e) { stellanova.fail(line, `the database said: ${e.message}.`); }
          for (const row of got)
            rows.push(row.map((c) => (c === null ? "" : typeof c === "number" || typeof c === "bigint" ? stellanova.text(Number(c)) : c instanceof Uint8Array ? Buffer.from(c).toString("latin1") : String(c))));
        }
      } finally {
        db.close();
      }
      if (used !== values.length) stellanova.fail(line, `the command has ${used} ?, but there are ${values.length} values.`);
      return rows;
    },
  };

note: SQLite databases. Use: use: database  Put ? where a value goes.

code:
  #ifdef _WIN32
  #include <winsqlite/winsqlite3.h>
  #elif defined(__linux__)
  // Linux: the system's SQLite
  extern "C"
  {
  	struct sqlite3;
  	struct sqlite3_stmt;
  	int sqlite3_open(const char*, sqlite3**);
  	int sqlite3_close(sqlite3*);
  	const char* sqlite3_errmsg(sqlite3*);
  	int sqlite3_prepare_v2(sqlite3*, const char*, int, sqlite3_stmt**, const char**);
  	int sqlite3_bind_parameter_count(sqlite3_stmt*);
  	int sqlite3_bind_text(sqlite3_stmt*, int, const char*, int, void (*)(void*));
  	int sqlite3_step(sqlite3_stmt*);
  	int sqlite3_column_count(sqlite3_stmt*);
  	int sqlite3_column_type(sqlite3_stmt*, int);
  	double sqlite3_column_double(sqlite3_stmt*, int);
  	const unsigned char* sqlite3_column_text(sqlite3_stmt*, int);
  	int sqlite3_finalize(sqlite3_stmt*);
  }
  #define SQLITE_OK 0
  #define SQLITE_ROW 100
  #define SQLITE_DONE 101
  #define SQLITE_INTEGER 1
  #define SQLITE_FLOAT 2
  #define SQLITE_TRANSIENT ((void (*)(void*)) - 1)
  #endif
link: winsqlite3
linux link: :libsqlite3.so.0

code:
  #include <array>
  namespace fathom_database
  {
  	inline std::string plainly(const std::string& why)  // what failed, in plain words, then the database's own
  	{
  		static const std::vector<std::array<std::string, 3>> rules = {
  			{"no such table: ", "", "there is no table called \"{x}\", so make it first with CREATE TABLE"},
  			{"no such column: ", "", "there is no column called \"{x}\""},
  			{"table ", " already exists", "there is already a table called \"{x}\"; CREATE TABLE IF NOT EXISTS makes it only once"},
  			{"UNIQUE constraint failed: ", "", "another row already has the same {x}"},
  			{"NOT NULL constraint failed: ", "", "{x} must be given a value"},
  			{"near ", ": syntax error", "the command isn't written the way the database reads it, near {x}"},
  			{"database is locked", "", "another program is using the database just now"},
  		};
  		for (const auto& r : rules)
  			if (why.rfind(r[0], 0) == 0 && why.size() >= r[0].size() + r[1].size() && why.compare(why.size() - r[1].size(), r[1].size(), r[1]) == 0)
  			{
  				std::string x = why.substr(r[0].size(), why.size() - r[0].size() - r[1].size()), out = r[2];
  				size_t at = out.find("{x}");
  				if (at != std::string::npos)
  					out.replace(at, 3, x);
  				return "the database couldn't do it: " + out + " (it said: " + why + ").";
  			}
  		return "the database couldn't do it (it said: " + why + ").";
  	}
  	inline std::vector<std::vector<std::string>> run(const std::string& file, const std::string& command,
  		const std::vector<std::string>& values, int line)
  	{
  		sqlite3* db = nullptr;
  		if (sqlite3_open(file.c_str(), &db) != SQLITE_OK)
  		{
  			std::string why = db ? sqlite3_errmsg(db) : "no memory";
  			sqlite3_close(db);
  			fathom::fail(line, "I couldn't open the database \"" + file + "\": " + why + ".");
  		}
  		std::vector<std::vector<std::string>> rows;
  		const char* rest = command.c_str();
  		size_t used = 0;
  		while (*rest)
  		{
  			sqlite3_stmt* step = nullptr;
  			const char* next = nullptr;
  			if (sqlite3_prepare_v2(db, rest, -1, &step, &next) != SQLITE_OK)
  			{
  				std::string why = sqlite3_errmsg(db);
  				sqlite3_close(db);
  				fathom::fail(line, plainly(why));
  			}
  			rest = next;
  			if (!step)
  				continue;  // only spaces or a note
  			int holes = sqlite3_bind_parameter_count(step);
  			for (int k = 1; k <= holes; ++k, ++used)
  				if (used < values.size())
  					sqlite3_bind_text(step, k, values[used].c_str(), -1, SQLITE_TRANSIENT);
  			int status;
  			while ((status = sqlite3_step(step)) == SQLITE_ROW)
  			{
  				std::vector<std::string> row;
  				for (int c = 0; c < sqlite3_column_count(step); ++c)
  				{
  					int type = sqlite3_column_type(step, c);
  					const unsigned char* cell = sqlite3_column_text(step, c);
  					if (type == SQLITE_INTEGER || type == SQLITE_FLOAT)  // numbers written as Fathom writes them
  						row.push_back(fathom::text(sqlite3_column_double(step, c)));
  					else
  						row.push_back(cell ? reinterpret_cast<const char*>(cell) : "");
  				}
  				rows.push_back(row);
  			}
  			sqlite3_finalize(step);
  			if (status != SQLITE_DONE)
  			{
  				std::string why = sqlite3_errmsg(db);
  				sqlite3_close(db);
  				fathom::fail(line, plainly(why));
  			}
  		}
  		sqlite3_close(db);
  		if (used != values.size())
  			fathom::fail(line, "the command has " + std::to_string(used) + " ?, but there are " + std::to_string(values.size()) + " values.");
  		return rows;
  	}
  }

python:
  import sqlite3
  PLAIN = [('no such table: ', '', 'there is no table called "{x}", so make it first with CREATE TABLE'), ('no such column: ', '', 'there is no column called "{x}"'), ('table ', ' already exists', 'there is already a table called "{x}"; CREATE TABLE IF NOT EXISTS makes it only once'), ('UNIQUE constraint failed: ', '', 'another row already has the same {x}'), ('NOT NULL constraint failed: ', '', '{x} must be given a value'), ('near ', ': syntax error', "the command isn't written the way the database reads it, near {x}"), ('database is locked', '', 'another program is using the database just now')]
  def plainly(why):
      for start, end, plain in PLAIN:
          if why.startswith(start) and why.endswith(end) and len(why) >= len(start) + len(end):
              return "the database couldn't do it: " + plain.replace("{x}", why[len(start):len(why) - len(end)]) + " (it said: " + why + ")."
      return "the database couldn't do it (it said: " + why + ")."
  def database(file, command, values):
      try:
          db = sqlite3.connect(file, isolation_level=None)
      except sqlite3.Error as why:
          raise RunError(0, "I couldn't open the database \"" + file + "\": " + str(why) + ".")
      rows, used = [], 0
      try:
          for part in split_commands(command):
              holes = part.count("?")
              cur = db.execute(part, values[used:used + holes])
              used += holes
              rows += [["" if c is None else text(float(c)) if isinstance(c, (int, float)) and not isinstance(c, bool) else str(c) for c in row]
                       for row in cur.fetchall()]
      except sqlite3.Error as why:
          raise RunError(0, plainly(str(why)))
      except (IndexError, sqlite3.ProgrammingError):
          raise RunError(0, "the command has " + str(command.count("?")) + " ?, but there are " + str(len(values)) + " values.")
      finally:
          db.close()
      if used != len(values):
          raise RunError(0, "the command has " + str(used) + " ?, but there are " + str(len(values)) + " values.")
      return rows
  def split_commands(command):
      parts, now = [], ""
      for piece in command.split(";"):
          now += piece
          if sqlite3.complete_statement(now + ";"):
              if now.strip():
                  parts.append(now)
              now = ""
          else:
              now += ";"
      if now.strip():
          parts.append(now)
      return parts

to change the database, given file (text) and command (text) = fathom_database::run({file}, {command}, {}, {line})
  runs: database({file}, {command}, [])
  web: fathom_database.run({file}, {command}, [], {line})
to change the database with values, given file (text) and command (text) and values (a list of text) = fathom_database::run({file}, {command}, {values}, {line})
  runs: database({file}, {command}, {values})
  web: fathom_database.run({file}, {command}, {values}, {line})
to rows from the database, given file (text) and question (text), returning a list of lists of text = fathom_database::run({file}, {question}, {}, {line})
  runs: database({file}, {question}, [])
  web: fathom_database.run({file}, {question}, [], {line})
to rows from the database with values, given file (text) and question (text) and values (a list of text), returning a list of lists of text = fathom_database::run({file}, {question}, {values}, {line})
  runs: database({file}, {question}, {values})
  web: fathom_database.run({file}, {question}, {values}, {line})

javascript:
  const fathom_database = {
    split(command) {  // shortcut: splits at ; so BEGIN ... END breaks
      const parts = [];
      let now = "", quote = null;
      for (let k = 0; k < command.length; k++) {
        const c = command[k];
        if (quote) {
          now += c;
          if (quote === "\n" ? c === "\n" : quote === "*/" ? c === "/" && command[k - 1] === "*" : c === quote) quote = null;
        } else if (c === "'" || c === '"' || c === "`" || c === "[") { quote = c === "[" ? "]" : c; now += c; }
        else if (c === "-" && command[k + 1] === "-") { quote = "\n"; now += c; }
        else if (c === "/" && command[k + 1] === "*") { quote = "*/"; now += c + "*"; k++; }
        else if (c === ";") { if (now.trim()) parts.push(now); now = ""; }
        else now += c;
      }
      if (now.trim() && !/^(\s|--[^\n]*(\n|$)|\/\*[\s\S]*?\*\/)*$/.test(now)) parts.push(now);
      return parts;
    },
    plain: [["no such table: ", "", "there is no table called \"{x}\", so make it first with CREATE TABLE"], ["no such column: ", "", "there is no column called \"{x}\""], ["table ", " already exists", "there is already a table called \"{x}\"; CREATE TABLE IF NOT EXISTS makes it only once"], ["UNIQUE constraint failed: ", "", "another row already has the same {x}"], ["NOT NULL constraint failed: ", "", "{x} must be given a value"], ["near ", ": syntax error", "the command isn't written the way the database reads it, near {x}"], ["database is locked", "", "another program is using the database just now"]],
    plainly(why) {
      for (const [start, end, plain] of this.plain)
        if (why.startsWith(start) && why.endsWith(end) && why.length >= start.length + end.length)
          return `the database couldn't do it: ${plain.replace("{x}", why.slice(start.length, why.length - end.length))} (it said: ${why}).`;
      return `the database couldn't do it (it said: ${why}).`;
    },
    run(file, command, values, line) {
      if (typeof require !== "function") fathom.fail(line, "a web page has no databases (this works with node).");
      let db;
      try {
        const { DatabaseSync } = require("node:sqlite");
        db = new DatabaseSync(file);
      } catch (e) {
        fathom.fail(line, `I couldn't open the database "${file}": ${e.message}.`);
      }
      const rows = [];
      let used = 0;
      try {
        for (const part of this.split(command)) {
          let step;
          try { step = db.prepare(part); } catch (e) { fathom.fail(line, fathom_database.plainly(e.message)); }
          const holes = (part.match(/\?/g) || []).length;
          if (used + holes > values.length) fathom.fail(line, `the command has ${(command.match(/\?/g) || []).length} ?, but there are ${values.length} values.`);
          const given = values.slice(used, used + holes);
          used += holes;
          let got;
          try {
            if (step.columns().length) { step.setReturnArrays(true); got = step.all(...given); }
            else { step.run(...given); got = []; }
          } catch (e) { fathom.fail(line, fathom_database.plainly(e.message)); }
          for (const row of got)
            rows.push(row.map((c) => (c === null ? "" : typeof c === "number" || typeof c === "bigint" ? fathom.text(Number(c)) : c instanceof Uint8Array ? Buffer.from(c).toString("latin1") : String(c))));
        }
      } finally {
        db.close();
      }
      if (used !== values.length) fathom.fail(line, `the command has ${used} ?, but there are ${values.length} values.`);
      return rows;
    },
  };

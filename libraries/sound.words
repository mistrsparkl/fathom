note: Words for sound (Windows). Use them in a program with:  use: sound
note: Sound files can be .wav or .mp3 files. Paths are from the folder the program runs in.
note: Sounds play on top of each other, so a game can have many at once.

code:
  #define NOMINMAX
include: <winsock2.h>
include: <windows.h>
include: <mmsystem.h>
link: winmm

code:
  namespace stellanova_sound
  {
  	inline std::wstring wide(const std::string& s)
  	{
  		std::wstring out(MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0), L'\0');
  		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), out.data(), (int)out.size());
  		return out;
  	}

  	inline std::vector<std::wstring> playing;  // the players opened so far
  	inline int made = 0;

  	inline bool done(const std::wstring& alias)
  	{
  		wchar_t mode[64] = L"";
  		mciSendStringW((L"status " + alias + L" mode").c_str(), mode, 64, nullptr);
  		return std::wstring(mode) != L"playing";
  	}

  	inline void play(const std::string& file, bool wait, bool loop, int line)
  	{
  		std::wstring path = wide(file);
  		if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES)
  			stellanova::fail(line, "there is no sound file called \"" + file + "\".");
  		for (size_t k = 0; k < playing.size();)  // close the ones that have finished
  			if (done(playing[k]))
  			{
  				mciSendStringW((L"close " + playing[k]).c_str(), nullptr, 0, nullptr);
  				playing.erase(playing.begin() + k);
  			}
  			else
  				++k;
  		wchar_t full[MAX_PATH * 4];
  		GetFullPathNameW(path.c_str(), MAX_PATH * 4, full, nullptr);
  		std::wstring alias = L"stellanova_sound_" + std::to_wstring(++made);
  		if (mciSendStringW((L"open \"" + std::wstring(full) + L"\" type mpegvideo alias " + alias).c_str(), nullptr, 0, nullptr) != 0)
  			stellanova::fail(line, "I couldn't play \"" + file + "\" (it must be a .wav or .mp3 file).");
  		playing.push_back(alias);
  		mciSendStringW((L"play " + alias + (loop ? L" repeat" : L"") + (wait ? L" wait" : L"")).c_str(), nullptr, 0, nullptr);
  	}

  	inline void stop()
  	{
  		for (const auto& alias : playing)
  			mciSendStringW((L"close " + alias).c_str(), nullptr, 0, nullptr);
  		playing.clear();
  	}

  	// one song at a time, that can be paused, moved about in and made quieter
  	inline bool song_open = false;
  	inline std::wstring song_status(const wchar_t* what)
  	{
  		wchar_t said[128] = L"";
  		if (song_open)
  			mciSendStringW((std::wstring(L"status stellanova_song ") + what).c_str(), said, 128, nullptr);
  		return said;
  	}
  	inline void song_stop()
  	{
  		if (song_open)
  			mciSendStringW(L"close stellanova_song", nullptr, 0, nullptr);
  		song_open = false;
  	}
  	inline void song_play(const std::string& file, int line)
  	{
  		song_stop();
  		if (GetFileAttributesW(wide(file).c_str()) == INVALID_FILE_ATTRIBUTES)
  			stellanova::fail(line, "there is no sound file called \"" + file + "\".");
  		if (mciSendStringW((L"open \"" + wide(file) + L"\" type mpegvideo alias stellanova_song").c_str(), nullptr, 0, nullptr) != 0)
  			stellanova::fail(line, "I couldn't play \"" + file + "\" (it must be a .wav or .mp3 file).");
  		song_open = true;
  		mciSendStringW(L"set stellanova_song time format milliseconds", nullptr, 0, nullptr);
  		mciSendStringW(L"play stellanova_song", nullptr, 0, nullptr);
  	}
  	inline void song_say(const std::wstring& what)
  	{
  		if (song_open)
  			mciSendStringW((L"" + what).c_str(), nullptr, 0, nullptr);
  	}
  	inline double song_number(const wchar_t* what) { return _wtof(song_status(what).c_str()) / 1000.0; }
  	inline void song_seek(double seconds)
  	{
  		bool was = song_status(L"mode") == L"playing";
  		song_say(L"seek stellanova_song to " + std::to_wstring((long long)(seconds * 1000)));
  		if (was)
  			song_say(L"play stellanova_song");
  	}
  }

python:
  import ctypes
  mci = ctypes.windll.winmm.mciSendStringW
  playing = []
  made = [0]
  def done(alias):
      mode = ctypes.create_unicode_buffer(64)
      mci(f"status {alias} mode", mode, 64, None)
      return mode.value != "playing"
  def play(file, wait, loop):
      if not os.path.exists(file):
          raise RunError(0, f'there is no sound file called "{file}".')
      for alias in [a for a in playing if done(a)]:  # close the ones that have finished
          mci(f"close {alias}", None, 0, None)
          playing.remove(alias)
      made[0] += 1
      alias = f"stellanova_sound_{made[0]}"
      if mci(f'open "{os.path.abspath(file)}" type mpegvideo alias {alias}', None, 0, None) != 0:
          raise RunError(0, f'I couldn\'t play "{file}" (it must be a .wav or .mp3 file).')
      playing.append(alias)
      mci(f"play {alias}" + (" repeat" if loop else "") + (" wait" if wait else ""), None, 0, None)
  def stop():
      for alias in playing:
          mci(f"close {alias}", None, 0, None)
      playing.clear()
  song = {"open": False}
  def song_status(what):
      said = ctypes.create_unicode_buffer(128)
      if song["open"]:
          mci(f"status stellanova_song {what}", said, 128, None)
      return said.value
  def song_stop():
      if song["open"]:
          mci("close stellanova_song", None, 0, None)
      song["open"] = False
  def song_play(file):
      song_stop()
      if not os.path.exists(file):
          raise RunError(0, f'there is no sound file called "{file}".')
      if mci(f'open "{os.path.abspath(file)}" type mpegvideo alias stellanova_song', None, 0, None) != 0:
          raise RunError(0, f"I couldn't play '{file}' (it must be a .wav or .mp3 file).")
      song["open"] = True
      mci("set stellanova_song time format milliseconds", None, 0, None)
      mci("play stellanova_song", None, 0, None)
  def song_say(what):
      if song["open"]:
          mci(what, None, 0, None)
  def song_number(what):
      try:
          return float(song_status(what) or 0) / 1000
      except ValueError:
          return 0.0
  def song_seek(seconds):
      was = song_status("mode") == "playing"
      song_say(f"seek stellanova_song to {int(max(0, seconds) * 1000)}")
      if was:
          song_say("play stellanova_song")

to play the sound, given file (text) = stellanova_sound::play({file}, false, false, {line})
  runs: play({file}, False, False)
  web: await stellanova_sound_web.play({file}, false, false, {line})
to play the sound and wait, given file (text) = stellanova_sound::play({file}, true, false, {line})
  runs: play({file}, True, False)
  web: await stellanova_sound_web.play({file}, true, false, {line})
to play the sound again and again, given file (text) = stellanova_sound::play({file}, false, true, {line})
  runs: play({file}, False, True)
  web: await stellanova_sound_web.play({file}, false, true, {line})
to stop the sound = stellanova_sound::stop()
  runs: stop()
  web: stellanova_sound_web.stop()
to play the song, given file (text) = stellanova_sound::song_play({file}, {line})
  runs: song_play({file})
  web: await stellanova_sound_web.songPlay({file}, {line})
to pause the song = stellanova_sound::song_say(L"pause stellanova_song")
  runs: song_say("pause stellanova_song")
  web: stellanova_sound_web.songPause()
to carry on the song = stellanova_sound::song_say(L"resume stellanova_song")
  runs: song_say("resume stellanova_song")
  web: stellanova_sound_web.songResume()
to stop the song = stellanova_sound::song_stop()
  runs: song_stop()
  web: stellanova_sound_web.songStop()
the song is playing = (stellanova_sound::song_status(L"mode") == L"playing"), yes or no, read only
  runs: song_status("mode") == "playing"
  web: stellanova_sound_web.songPlaying()
the song has ended = (stellanova_sound::song_open && stellanova_sound::song_status(L"mode") == L"stopped" && stellanova_sound::song_number(L"position") + 0.3 >= stellanova_sound::song_number(L"length")), yes or no, read only
  runs: song["open"] and song_status("mode") == "stopped" and song_number("position") + 0.3 >= song_number("length")
  web: stellanova_sound_web.songEnded()
song time = stellanova_sound::song_number(L"position"), number, read only
  runs: song_number("position")
  web: stellanova_sound_web.songTime()
song length = stellanova_sound::song_number(L"length"), number, read only
  runs: song_number("length")
  web: stellanova_sound_web.songLength()
to set the song time to, given seconds (a number) = stellanova_sound::song_seek({seconds})
  runs: song_seek({seconds})
  web: stellanova_sound_web.songSeek({seconds})
to set the song loudness to, given level (a number) = stellanova_sound::song_say(L"setaudio stellanova_song volume to " + std::to_wstring((int)(std::clamp({level}, 0.0, 1.0) * 1000)))
  runs: song_say(f"setaudio stellanova_song volume to {int(max(0, min(1, {level})) * 1000)}")
  web: stellanova_sound_web.songLoudness({level})

javascript:
  const stellanova_sound_web = {
    // On a web page sounds play through the browser. With node nothing is heard: files are checked, and waiting takes as long as the sound.
    page: typeof document !== "undefined",
    playing: [],
    now() { return Date.now() / 1000; },
    async check(file, line) {  // the file's length in seconds (0 if unknown)
      let b;
      if (this.page) {
        const r = await fetch(file).catch(() => null);
        if (!r || !r.ok) stellanova.fail(line, `there is no sound file called "${file}".`);
        b = new Uint8Array(await r.arrayBuffer());
      } else {
        const fs = require("fs");
        if (!fs.existsSync(file)) stellanova.fail(line, `there is no sound file called "${file}".`);
        b = fs.readFileSync(file);  // a Buffer is bytes too
      }
      const ascii = (at, n) => String.fromCharCode(...b.slice(at, at + n));
      if (ascii(0, 4) === "RIFF" && ascii(8, 4) === "WAVE") {
        let at = 12, rate = 0, size = 0;
        while (at + 8 <= b.length) {
          const kind = ascii(at, 4), n = b[at + 4] | (b[at + 5] << 8) | (b[at + 6] << 16) | (b[at + 7] << 24);
          if (kind === "fmt ") rate = (b[at + 16] | (b[at + 17] << 8) | (b[at + 18] << 16) | (b[at + 19] << 24)) >>> 0;  // bytes each second
          if (kind === "data") { size = n >>> 0; break; }
          at += 8 + n + (n & 1);
        }
        return rate ? size / rate : 0;
      }
      if (ascii(0, 3) === "ID3" || (b[0] === 0xff && (b[1] & 0xe0) === 0xe0)) return 0;
      stellanova.fail(line, `I couldn't play "${file}" (it must be a .wav or .mp3 file).`);
    },
    async play(file, wait, loop, line) {
      const seconds = await this.check(file, line);
      if (!this.page) {
        if (wait) await new Promise((r) => setTimeout(r, seconds * 1000));
        return;
      }
      const a = new Audio(file);
      a.loop = loop;
      this.playing = this.playing.filter((p) => !p.ended);
      this.playing.push(a);
      try { await a.play(); } catch { stellanova.fail(line, `I couldn't play "${file}" (it must be a .wav or .mp3 file).`); }
      if (wait && !loop) await new Promise((r) => (a.onended = r));
    },
    stop() {
      for (const a of this.playing) a.pause();
      this.playing = [];
    },
    song: null,
    async songPlay(file, line) {
      this.songStop();
      const length = await this.check(file, line);
      if (this.page) {
        const a = new Audio(file);
        try { await a.play(); } catch { stellanova.fail(line, `I couldn't play '${file}' (it must be a .wav or .mp3 file).`); }
        this.song = { a };
      } else this.song = { length, at: 0, since: this.now(), paused: false, loud: 1 };
    },
    songPause() {
      const s = this.song;
      if (!s) return;
      if (s.a) s.a.pause();
      else if (!s.paused) s.at = this.songTime(), s.paused = true;
    },
    songResume() {
      const s = this.song;
      if (!s) return;
      if (s.a) s.a.play().catch(() => {});
      else if (s.paused) s.since = this.now(), s.paused = false;
    },
    songStop() {
      if (this.song && this.song.a) this.song.a.pause();
      this.song = null;
    },
    songTime() {
      const s = this.song;
      if (!s) return 0;
      if (s.a) return s.a.currentTime;
      return Math.min(s.length, s.paused ? s.at : s.at + this.now() - s.since);
    },
    songLength() {
      const s = this.song;
      if (!s) return 0;
      return s.a ? (Number.isFinite(s.a.duration) ? s.a.duration : 0) : s.length;
    },
    songPlaying() {
      const s = this.song;
      if (!s) return false;
      return s.a ? !s.a.paused && !s.a.ended : !s.paused && this.songTime() < s.length;
    },
    songEnded() {
      const s = this.song;
      if (!s) return false;
      return s.a ? s.a.ended : this.songTime() + 0.3 >= s.length && !s.paused;
    },
    songSeek(seconds) {
      const s = this.song;
      if (!s) return;
      if (s.a) s.a.currentTime = Math.max(0, seconds);
      else s.at = Math.min(s.length, Math.max(0, seconds)), s.since = this.now();
    },
    songLoudness(level) {
      if (this.song && this.song.a) this.song.a.volume = Math.max(0, Math.min(1, level));
    },
  };

  import ctypes
  if sys.platform.startswith("linux"):  # the same mixer as built programs: one PulseAudio stream
      import array as _array, struct as _struct, threading as _threading, time as _time
      _lock = _threading.Condition()
      _voices, _song, _loaded = [], {"v": None}, {}
      def _stereo(samples, channels, rate):
          frames = len(samples) // channels if channels else 0
          out = int(frames * 44100 / rate) if rate > 0 else 0
          made = _array.array("f", bytes(out * 8))
          for k in range(out):
              where = k * rate / 44100
              a = int(where); b = min(a + 1, frames - 1); t = where - a
              for side in (0, 1):
                  c = min(side, channels - 1)
                  made[k * 2 + side] = samples[a * channels + c] * (1 - t) + samples[b * channels + c] * t
          return made
      def _read_wav(data):
          if data[:4] != b"RIFF" or data[8:12] != b"WAVE":
              return None
          at, fmt, channels, rate, bits = 12, 0, 0, 0, 0
          while at + 8 <= len(data):
              kind, size = data[at:at + 4], _struct.unpack("<I", data[at + 4:at + 8])[0]
              if kind == b"fmt " and at + 24 <= len(data):
                  fmt, channels, rate = _struct.unpack("<HHI", data[at + 8:at + 16])
                  bits = _struct.unpack("<H", data[at + 22:at + 24])[0]
              if kind == b"data" and channels and fmt in (1, 3, 0xFFFE):
                  body, n = data[at + 8:at + 8 + size], bits // 8
                  if not 1 <= n <= 4:
                      return None
                  body = body[:len(body) - len(body) % n]
                  if fmt == 3 and n == 4:
                      samples = _array.array("f", body)
                  elif n == 1:
                      samples = [(x - 128) / 128 for x in body]
                  elif n == 2:
                      samples = [x / 32768 for x in _array.array("h", body)]
                  elif n == 4:
                      samples = [x / 2147483648 for x in _array.array("i", body)]
                  else:
                      samples = [int.from_bytes(body[k:k + 3], "little", signed=True) / 8388608 for k in range(0, len(body), 3)]
                  return _stereo(samples, channels, rate)
              at += 8 + size + (size & 1)
          return None
      def _read_mp3(file):
          try:
              lib = ctypes.CDLL("libmpg123.so.0")
          except OSError:
              return None
          lib.mpg123_new.restype = ctypes.c_void_p
          lib.mpg123_new.argtypes = [ctypes.c_char_p, ctypes.c_void_p]
          for name in ("mpg123_open", "mpg123_getformat", "mpg123_format_none", "mpg123_format", "mpg123_read", "mpg123_close"):
              getattr(lib, name).restype = ctypes.c_int
          lib.mpg123_open.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
          lib.mpg123_getformat.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
          lib.mpg123_format_none.argtypes = [ctypes.c_void_p]
          lib.mpg123_format.argtypes = [ctypes.c_void_p, ctypes.c_long, ctypes.c_int, ctypes.c_int]
          lib.mpg123_read.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
          lib.mpg123_close.argtypes = lib.mpg123_delete.argtypes = [ctypes.c_void_p]
          lib.mpg123_param.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_long, ctypes.c_double]
          lib.mpg123_init()
          mh = lib.mpg123_new(None, None)
          if not mh:
              return None
          lib.mpg123_param(mh, 2, 0x20, 0)  # MPG123_ADD_FLAGS, MPG123_QUIET: say nothing about files that aren't MP3s
          rate, channels, enc = ctypes.c_long(), ctypes.c_int(), ctypes.c_int()
          made = None
          if lib.mpg123_open(mh, file.encode()) == 0 and lib.mpg123_getformat(mh, ctypes.byref(rate), ctypes.byref(channels), ctypes.byref(enc)) == 0:
              lib.mpg123_format_none(mh)
              lib.mpg123_format(mh, rate.value, channels.value, 0x200)  # MPG123_ENC_FLOAT_32
              chunk, got, samples = ctypes.create_string_buffer(16384), ctypes.c_size_t(), _array.array("f")
              while True:
                  said = lib.mpg123_read(mh, chunk, len(chunk), ctypes.byref(got))
                  samples.frombytes(chunk.raw[:got.value - got.value % 4])
                  if said not in (0, -11) or (said == 0 and not got.value):
                      break
              if samples:
                  made = _stereo(samples, channels.value, rate.value)
              lib.mpg123_close(mh)
          lib.mpg123_delete(mh)
          return made
      def _clip(file):
          if file in _loaded:
              return _loaded[file]
          try:
              with open(file, "rb") as f:
                  data = f.read()
          except OSError:
              raise RunError(0, f'there is no sound file called "{file}".')
          made = _read_wav(data)
          if made is None:
              made = _read_mp3(file)
          if made is None:
              raise RunError(0, f'I couldn\'t play "{file}" (it must be a .wav or .mp3 file).')
          _loaded[file] = made
          return made
      def _mixing():
          class SPEC(ctypes.Structure):
              _fields_ = [("format", ctypes.c_int), ("rate", ctypes.c_uint32), ("channels", ctypes.c_uint8)]
          class ATTR(ctypes.Structure):
              _fields_ = [(n, ctypes.c_uint32) for n in ("maxlength", "tlength", "prebuf", "minreq", "fragsize")]
          out = None
          try:
              pulse = ctypes.CDLL("libpulse-simple.so.0")
              pulse.pa_simple_new.restype = ctypes.c_void_p
              pulse.pa_simple_new.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_char_p,
                                              ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
              pulse.pa_simple_write.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
              spec, attr = SPEC(5, 44100, 2), ATTR(0xFFFFFFFF, 44100 * 2 * 4 // 20, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)  # FLOAT32LE
              out = pulse.pa_simple_new(None, b"Stellanova", 1, None, b"sound", ctypes.byref(spec), None, ctypes.byref(attr), None)
          except OSError:
              pass
          while True:
              mix = [0.0] * 2048
              with _lock:
                  for v in _voices + ([_song["v"]] if _song["v"] else []):
                      frames, f = len(v["clip"]) // 2, v["clip"]
                      k = 0
                      while k < 1024 and not v["done"] and not v["paused"]:
                          if v["at"] >= frames:
                              if not v["loop"] or not frames:
                                  v["done"] = True
                                  break
                              v["at"] = 0
                          take = min(1024 - k, frames - v["at"])
                          g, at = v["loud"], v["at"] * 2
                          for j in range(take * 2):
                              mix[k * 2 + j] += f[at + j] * g
                          k += take
                          v["at"] += take
                      if v["at"] >= frames and not v["loop"]:
                          v["done"] = True
                  _voices[:] = [v for v in _voices if not v["done"]]
                  _lock.notify_all()
              block = _array.array("f", (max(-1.0, min(1.0, x)) for x in mix)).tobytes()
              if not out or pulse.pa_simple_write(out, block, len(block), None) < 0:
                  _time.sleep(1024 / 44100)
      _going = []
      def _start():
          if not _going:
              _going.append(_threading.Thread(target=_mixing, daemon=True))
              _going[0].start()
      def _voice(file, loop):
          return {"clip": _clip(file), "at": 0, "loop": loop, "paused": False, "done": False, "loud": 1.0}
      def play(file, wait, loop):
          v = _voice(file, loop)
          _start()
          with _lock:
              _voices.append(v)
              while wait and not v["done"]:
                  _lock.wait()
      def stop():
          with _lock:
              _voices.clear()
      def song_stop():
          with _lock:
              _song["v"] = None
      def song_play(file):
          song_stop()
          v = _voice(file, False)
          _start()
          with _lock:
              _song["v"] = v
      def song_pause(paused):
          with _lock:
              if _song["v"] and not _song["v"]["done"]:
                  _song["v"]["paused"] = paused
      def song_playing():
          v = _song["v"]
          return bool(v) and not v["paused"] and not v["done"]
      def song_ended():
          return bool(_song["v"]) and _song["v"]["done"]
      def song_time():
          return _song["v"]["at"] / 44100 if _song["v"] else 0.0
      def song_length():
          return len(_song["v"]["clip"]) / 2 / 44100 if _song["v"] else 0.0
      def song_seek(seconds):
          with _lock:
              v = _song["v"]
              if v:
                  frames = len(v["clip"]) // 2
                  v["at"] = min(frames, int(max(0, seconds) * 44100))
                  v["done"] = v["at"] >= frames
      def song_loudness(level):
          with _lock:
              if _song["v"]:
                  _song["v"]["loud"] = max(0.0, min(1.0, level))
  else:
      mci = ctypes.windll.winmm.mciSendStringW
      playing = []
      made = [0]
      def done(alias):
          mode = ctypes.create_unicode_buffer(64)
          mci(f"status {alias} mode", mode, 64, None)
          return mode.value != "playing"
      def play(file, wait, loop):
          if not os.path.exists(file):
              raise RunError(0, f'there is no sound file called "{file}".')
          for alias in [a for a in playing if done(a)]:  # close the ones that have finished
              mci(f"close {alias}", None, 0, None)
              playing.remove(alias)
          made[0] += 1
          alias = f"stellanova_sound_{made[0]}"
          if mci(f'open "{os.path.abspath(file)}" type mpegvideo alias {alias}', None, 0, None) != 0:
              raise RunError(0, f'I couldn\'t play "{file}" (it must be a .wav or .mp3 file).')
          playing.append(alias)
          mci(f"play {alias}" + (" repeat" if loop else "") + (" wait" if wait else ""), None, 0, None)
      def stop():
          for alias in playing:
              mci(f"close {alias}", None, 0, None)
          playing.clear()
      song = {"open": False}
      def song_status(what):
          said = ctypes.create_unicode_buffer(128)
          if song["open"]:
              mci(f"status stellanova_song {what}", said, 128, None)
          return said.value
      def song_stop():
          if song["open"]:
              mci("close stellanova_song", None, 0, None)
          song["open"] = False
      def song_play(file):
          song_stop()
          if not os.path.exists(file):
              raise RunError(0, f'there is no sound file called "{file}".')
          if mci(f'open "{os.path.abspath(file)}" type mpegvideo alias stellanova_song', None, 0, None) != 0:
              raise RunError(0, f"I couldn't play '{file}' (it must be a .wav or .mp3 file).")
          song["open"] = True
          mci("set stellanova_song time format milliseconds", None, 0, None)
          mci("play stellanova_song", None, 0, None)
      def song_say(what):
          if song["open"]:
              mci(what, None, 0, None)
      def song_number(what):
          try:
              return float(song_status(what) or 0) / 1000
          except ValueError:
              return 0.0
      def song_seek(seconds):
          was = song_status("mode") == "playing"
          song_say(f"seek stellanova_song to {int(max(0, seconds) * 1000)}")
          if was:
              song_say("play stellanova_song")
      def song_pause(paused):
          song_say("pause stellanova_song" if paused else "resume stellanova_song")
      def song_playing():
          return song_status("mode") == "playing"
      def song_ended():
          return song["open"] and song_status("mode") == "stopped" and song_number("position") + 0.3 >= song_number("length")
      def song_time():
          return song_number("position")
      def song_length():
          return song_number("length")
      def song_loudness(level):
          song_say(f"setaudio stellanova_song volume to {int(max(0, min(1, level)) * 1000)}")

to play the sound, given file (text) = stellanova_sound::play({file}, false, false, {line})
  runs: play({file}, False, False)
  web: await stellanova_sound_web.play({file}, false, false, {line})
to play the sound and wait, given file (text) = stellanova_sound::play({file}, true, false, {line})
  runs: play({file}, True, False)
  web: await stellanova_sound_web.play({file}, true, false, {line})
to play the sound again and again, given file (text) = stellanova_sound::play({file}, false, true, {line})
  runs: play({file}, False, True)
  web: await stellanova_sound_web.play({file}, false, true, {line})
to stop the sound = stellanova_sound::stop()
  runs: stop()
  web: stellanova_sound_web.stop()
to play the song, given file (text) = stellanova_sound::song_play({file}, {line})
  runs: song_play({file})
  web: await stellanova_sound_web.songPlay({file}, {line})
to pause the song = stellanova_sound::song_pause(true)
  runs: song_pause(True)
  web: stellanova_sound_web.songPause()
to carry on the song = stellanova_sound::song_pause(false)
  runs: song_pause(False)
  web: stellanova_sound_web.songResume()
to stop the song = stellanova_sound::song_stop()
  runs: song_stop()
  web: stellanova_sound_web.songStop()
the song is playing = stellanova_sound::song_playing(), yes or no, read only
  runs: song_playing()
  web: stellanova_sound_web.songPlaying()
the song has ended = stellanova_sound::song_ended(), yes or no, read only
  runs: song_ended()
  web: stellanova_sound_web.songEnded()
song time = stellanova_sound::song_time(), number, read only
  runs: song_time()
  web: stellanova_sound_web.songTime()
song length = stellanova_sound::song_length(), number, read only
  runs: song_length()
  web: stellanova_sound_web.songLength()
to set the song time to, given seconds (a number) = stellanova_sound::song_seek({seconds})
  runs: song_seek({seconds})
  web: stellanova_sound_web.songSeek({seconds})
to set the song loudness to, given level (a number) = stellanova_sound::song_loudness({level})
  runs: song_loudness({level})
  web: stellanova_sound_web.songLoudness({level})

javascript:
  const stellanova_sound_web = {
    // On the web sounds play through the browser.
    page: typeof document !== "undefined",
    playing: [],
    now() { return Date.now() / 1000; },
    async check(file, line) {  // the file's length in seconds (0 if unknown)
      let b;
      if (this.page) {
        const r = await fetch(file).catch(() => null);
        if (!r || !r.ok) stellanova.fail(line, `there is no sound file called "${file}".`);
        b = new Uint8Array(await r.arrayBuffer());
      } else {
        const fs = require("fs");
        if (!fs.existsSync(file)) stellanova.fail(line, `there is no sound file called "${file}".`);
        b = fs.readFileSync(file);  // a Buffer is bytes too
      }
      const ascii = (at, n) => String.fromCharCode(...b.slice(at, at + n));
      if (ascii(0, 4) === "RIFF" && ascii(8, 4) === "WAVE") {
        let at = 12, rate = 0, size = 0;
        while (at + 8 <= b.length) {
          const kind = ascii(at, 4), n = b[at + 4] | (b[at + 5] << 8) | (b[at + 6] << 16) | (b[at + 7] << 24);
          if (kind === "fmt ") rate = (b[at + 16] | (b[at + 17] << 8) | (b[at + 18] << 16) | (b[at + 19] << 24)) >>> 0;  // bytes each second
          if (kind === "data") { size = n >>> 0; break; }
          at += 8 + n + (n & 1);
        }
        return rate ? size / rate : 0;
      }
      if (ascii(0, 3) === "ID3" || (b[0] === 0xff && (b[1] & 0xe0) === 0xe0)) return 0;
      stellanova.fail(line, `I couldn't play "${file}" (it must be a .wav or .mp3 file).`);
    },
    async play(file, wait, loop, line) {
      const seconds = await this.check(file, line);
      if (!this.page) {
        if (wait) await new Promise((r) => setTimeout(r, seconds * 1000));
        return;
      }
      const a = new Audio(file);
      a.loop = loop;
      this.playing = this.playing.filter((p) => !p.ended);
      this.playing.push(a);
      try { await a.play(); } catch { stellanova.fail(line, `I couldn't play "${file}" (it must be a .wav or .mp3 file).`); }
      if (wait && !loop) await new Promise((r) => (a.onended = r));
    },
    stop() {
      for (const a of this.playing) a.pause();
      this.playing = [];
    },
    song: null,
    async songPlay(file, line) {
      this.songStop();
      const length = await this.check(file, line);
      if (this.page) {
        const a = new Audio(file);
        try { await a.play(); } catch { stellanova.fail(line, `I couldn't play '${file}' (it must be a .wav or .mp3 file).`); }
        this.song = { a };
      } else this.song = { length, at: 0, since: this.now(), paused: false, loud: 1 };
    },
    songPause() {
      const s = this.song;
      if (!s) return;
      if (s.a) s.a.pause();
      else if (!s.paused) s.at = this.songTime(), s.paused = true;
    },
    songResume() {
      const s = this.song;
      if (!s) return;
      if (s.a) s.a.play().catch(() => {});
      else if (s.paused) s.since = this.now(), s.paused = false;
    },
    songStop() {
      if (this.song && this.song.a) this.song.a.pause();
      this.song = null;
    },
    songTime() {
      const s = this.song;
      if (!s) return 0;
      if (s.a) return s.a.currentTime;
      return Math.min(s.length, s.paused ? s.at : s.at + this.now() - s.since);
    },
    songLength() {
      const s = this.song;
      if (!s) return 0;
      return s.a ? (Number.isFinite(s.a.duration) ? s.a.duration : 0) : s.length;
    },
    songPlaying() {
      const s = this.song;
      if (!s) return false;
      return s.a ? !s.a.paused && !s.a.ended : !s.paused && this.songTime() < s.length;
    },
    songEnded() {
      const s = this.song;
      if (!s) return false;
      return s.a ? s.a.ended : this.songTime() + 0.3 >= s.length && !s.paused;
    },
    songSeek(seconds) {
      const s = this.song;
      if (!s) return;
      if (s.a) s.a.currentTime = Math.max(0, seconds);
      else s.at = Math.min(s.length, Math.max(0, seconds)), s.since = this.now();
    },
    songLoudness(level) {
      if (this.song && this.song.a) this.song.a.volume = Math.max(0, Math.min(1, level));
    },
  };

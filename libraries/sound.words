  #ifdef _WIN32
  #define NOMINMAX
  #include <winsock2.h>
  #include <windows.h>
  #include <mmsystem.h>
  #elif defined(__linux__)
  #include <pulse/simple.h>
  #include <condition_variable>
  #include <fstream>
  #include <memory>
  #include <mutex>
  #include <thread>
  #include <cstring>
  #include <sys/types.h>
  extern "C"  // the system's MP3 reader
  {
  	struct mpg123_handle_struct;
  	int mpg123_init();
  	mpg123_handle_struct* mpg123_new(const char*, int*);
  	int mpg123_open(mpg123_handle_struct*, const char*);
  	int mpg123_getformat(mpg123_handle_struct*, long*, int*, int*);
  	int mpg123_format_none(mpg123_handle_struct*);
  	int mpg123_format(mpg123_handle_struct*, long, int, int);
  	int mpg123_read(mpg123_handle_struct*, void*, size_t, size_t*);
  	int mpg123_close(mpg123_handle_struct*);
  	void mpg123_delete(mpg123_handle_struct*);
  	int mpg123_param(mpg123_handle_struct*, int, long, double);
  	void cn_park();  // (machine code's: waiting here mustn't hold up the collector)
  	void cn_unpark();
  }
  #endif

code:
  #ifdef __linux__
  namespace stellanova_sound
  {
  	// Linux: everything playing, mixed into one PulseAudio stream
  	struct Clip { std::vector<float> frames; };  // left, right, left, right...
  	struct Voice
  	{
  		std::shared_ptr<Clip> clip;
  		size_t at = 0;  // the frame it is up to
  		bool loop = false, paused = false, done = false;
  		float loudness = 1;
  	};
  	inline std::mutex lock;
  	inline std::condition_variable changed;
  	inline std::vector<std::shared_ptr<Voice>> voices;
  	inline std::shared_ptr<Voice> song;
  	inline bool song_open = false;

  	inline std::shared_ptr<Clip> stereo(const std::vector<float>& in, int channels, long rate)  // to two sides at 44100
  	{
  		auto clip = std::make_shared<Clip>();
  		size_t frames = channels ? in.size() / channels : 0;
  		size_t out = rate > 0 ? (size_t)(frames * 44100.0 / rate) : 0;
  		clip->frames.resize(out * 2);
  		for (size_t k = 0; k < out; ++k)
  		{
  			double where = k * (double)rate / 44100.0;
  			size_t a = (size_t)where, b = std::min(a + 1, frames - 1);
  			double t = where - a;
  			for (int side = 0; side < 2; ++side)
  			{
  				int c = std::min(side, channels - 1);
  				clip->frames[k * 2 + side] = (float)(in[a * channels + c] * (1 - t) + in[b * channels + c] * t);
  			}
  		}
  		return clip;
  	}
  	inline std::shared_ptr<Clip> read_wav(const std::string& all)
  	{
  		if (all.size() < 12 || all.compare(0, 4, "RIFF") || all.compare(8, 4, "WAVE"))
  			return nullptr;
  		auto word = [&](size_t at, int n) { uint32_t v = 0; for (int k = n - 1; k >= 0; --k) v = v << 8 | (unsigned char)all[at + k]; return v; };
  		int format = 0, channels = 0, bits = 0;
  		long rate = 0;
  		for (size_t at = 12; at + 8 <= all.size();)
  		{
  			std::string kind = all.substr(at, 4);
  			size_t size = word(at + 4, 4);
  			if (kind == "fmt " && at + 24 <= all.size())
  				format = word(at + 8, 2), channels = word(at + 10, 2), rate = word(at + 12, 4), bits = word(at + 22, 2);
  			if (kind == "data" && channels > 0 && (format == 1 || format == 3 || format == 0xFFFE))
  			{
  				size_t end = std::min(all.size(), at + 8 + size), bytes = bits / 8;
  				if (bytes < 1 || bytes > 4)
  					return nullptr;
  				std::vector<float> in;
  				for (size_t k = at + 8; k + bytes <= end; k += bytes)
  				{
  					uint32_t v = word(k, (int)bytes);
  					if (format == 3 && bytes == 4) { float f; std::memcpy(&f, &v, 4); in.push_back(f); }
  					else if (bytes == 1) in.push_back(((int)v - 128) / 128.0f);
  					else { int shift = 32 - 8 * (int)bytes; in.push_back((float)((int32_t)(v << shift) / 2147483648.0)); }
  				}
  				return stereo(in, channels, rate);
  			}
  			at += 8 + size + (size & 1);
  		}
  		return nullptr;
  	}
  	inline std::shared_ptr<Clip> read_mp3(const std::string& file)
  	{
  		static bool started = mpg123_init() == 0;
  		if (!started)
  			return nullptr;
  		mpg123_handle_struct* mh = mpg123_new(nullptr, nullptr);
  		if (!mh)
  			return nullptr;
  		mpg123_param(mh, 2, 0x20, 0);  // quiet about files that aren't MP3s
  		long rate = 0;
  		int channels = 0, encoding = 0;
  		std::shared_ptr<Clip> clip;
  		if (mpg123_open(mh, file.c_str()) == 0 && mpg123_getformat(mh, &rate, &channels, &encoding) == 0)
  		{
  			mpg123_format_none(mh);
  			mpg123_format(mh, rate, channels, 0x200);  // MPG123_ENC_FLOAT_32
  			std::vector<float> in;
  			float chunk[4096];
  			size_t got = 0;
  			int said;
  			while ((said = mpg123_read(mh, chunk, sizeof chunk, &got)) == 0 || said == -11 || got)  // -11: the format changed
  			{
  				in.insert(in.end(), chunk, chunk + got / sizeof(float));
  				if (said != 0 && said != -11)
  					break;
  			}
  			if (!in.empty())
  				clip = stereo(in, channels, rate);
  			mpg123_close(mh);
  		}
  		mpg123_delete(mh);
  		return clip;
  	}
  	inline std::shared_ptr<Clip> clip(const std::string& file, int line)
  	{
  		static std::map<std::string, std::shared_ptr<Clip>> loaded;
  		{
  			std::lock_guard<std::mutex> hold(lock);
  			if (loaded.count(file))
  				return loaded[file];
  		}
  		std::ifstream in(file, std::ios::binary);
  		if (!in)
  			stellanova::fail(line, "there is no sound file called \"" + file + "\".");
  		std::string all((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
  		auto made = read_wav(all);
  		if (!made)
  			made = read_mp3(file);
  		if (!made)
  			stellanova::fail(line, "I couldn't play \"" + file + "\" (it must be a .wav or .mp3 file).");
  		std::lock_guard<std::mutex> hold(lock);
  		return loaded[file] = made;
  	}
  	inline void mixing()  // the thread that feeds the speakers
  	{
  		pa_sample_spec spec{PA_SAMPLE_FLOAT32LE, 44100, 2};
  		pa_buffer_attr wanted{(uint32_t)-1, 44100 * 2 * 4 / 20, (uint32_t)-1, (uint32_t)-1, (uint32_t)-1};  // a 20th of a second ahead
  		pa_simple* out = pa_simple_new(nullptr, "Stellanova", PA_STREAM_PLAYBACK, nullptr, "sound", &spec, nullptr, &wanted, nullptr);
  		std::vector<float> mix(1024 * 2);
  		for (;;)
  		{
  			std::fill(mix.begin(), mix.end(), 0.0f);
  			{
  				std::lock_guard<std::mutex> hold(lock);
  				auto add = [&](Voice& v) {
  					const auto& f = v.clip->frames;
  					size_t frames = f.size() / 2;
  					for (size_t k = 0; k < 1024 && !v.done && !v.paused; ++k)
  					{
  						if (v.at >= frames)
  						{
  							if (!v.loop || !frames) { v.done = true; break; }
  							v.at = 0;
  						}
  						mix[k * 2] += f[v.at * 2] * v.loudness;
  						mix[k * 2 + 1] += f[v.at * 2 + 1] * v.loudness;
  						++v.at;
  					}
  					if (v.at >= frames && !v.loop)
  						v.done = true;
  				};
  				for (auto& v : voices)
  					add(*v);
  				if (song)
  					add(*song);
  				voices.erase(std::remove_if(voices.begin(), voices.end(), [](const auto& v) { return v->done; }), voices.end());
  			}
  			changed.notify_all();
  			for (float& x : mix)
  				x = std::clamp(x, -1.0f, 1.0f);
  			if (!out || pa_simple_write(out, mix.data(), mix.size() * sizeof(float), nullptr) < 0)
  				std::this_thread::sleep_for(std::chrono::milliseconds(23));  // no speakers: time still passes
  		}
  	}
  	inline void start()
  	{
  		static bool going = [] { std::thread(mixing).detach(); return true; }();
  		(void)going;
  	}

  	inline void play(const std::string& file, bool wait, bool loop, int line)
  	{
  		auto v = std::make_shared<Voice>();
  		v->clip = clip(file, line);
  		v->loop = loop;
  		start();
  		std::unique_lock<std::mutex> hold(lock);
  		voices.push_back(v);
  		if (wait)
  		{
  			cn_park();
  			changed.wait(hold, [&] { return v->done; });
  			hold.unlock();
  			cn_unpark();
  		}
  	}
  	inline void stop()
  	{
  		std::lock_guard<std::mutex> hold(lock);
  		voices.clear();
  	}
  	inline void song_stop()
  	{
  		std::lock_guard<std::mutex> hold(lock);
  		song = nullptr;
  		song_open = false;
  	}
  	inline void song_play(const std::string& file, int line)
  	{
  		song_stop();
  		auto v = std::make_shared<Voice>();
  		v->clip = clip(file, line);
  		start();
  		std::lock_guard<std::mutex> hold(lock);
  		song = v;
  		song_open = true;
  	}
  	inline void song_pause(bool paused)
  	{
  		std::lock_guard<std::mutex> hold(lock);
  		if (song && !song->done)
  			song->paused = paused;
  	}
  	inline bool song_playing() { std::lock_guard<std::mutex> hold(lock); return song && !song->paused && !song->done; }
  	inline bool song_ended() { std::lock_guard<std::mutex> hold(lock); return song && song->done; }
  	inline double song_time() { std::lock_guard<std::mutex> hold(lock); return song ? song->at / 44100.0 : 0; }
  	inline double song_length() { std::lock_guard<std::mutex> hold(lock); return song ? song->clip->frames.size() / 2 / 44100.0 : 0; }
  	inline void song_seek(double seconds)
  	{
  		std::lock_guard<std::mutex> hold(lock);
  		if (!song)
  			return;
  		size_t frames = song->clip->frames.size() / 2;
  		song->at = std::min(frames, (size_t)(std::max(0.0, seconds) * 44100));
  		song->done = song->at >= frames;
  	}
  	inline void song_loudness(double level)
  	{
  		std::lock_guard<std::mutex> hold(lock);
  		if (song)
  			song->loudness = (float)std::clamp(level, 0.0, 1.0);
  	}
  }
  #else
  namespace stellanova_sound
  {
  	inline std::wstring wide(const std::string& s)
  	{
  		std::wstring out(MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0), L'\0');
  		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), out.data(), (int)out.size());
  		return out;
  	}

  	inline std::vector<std::wstring> playing;  // the players opened so far
  	inline int made = 0;

  	inline bool done(const std::wstring& alias)
  	{
  		wchar_t mode[64] = L"";
  		mciSendStringW((L"status " + alias + L" mode").c_str(), mode, 64, nullptr);
  		return std::wstring(mode) != L"playing";
  	}

  	inline void play(const std::string& file, bool wait, bool loop, int line)
  	{
  		std::wstring path = wide(file);
  		if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES)
  			stellanova::fail(line, "there is no sound file called \"" + file + "\".");
  		for (size_t k = 0; k < playing.size();)  // close the ones that have finished
  			if (done(playing[k]))
  			{
  				mciSendStringW((L"close " + playing[k]).c_str(), nullptr, 0, nullptr);
  				playing.erase(playing.begin() + k);
  			}
  			else
  				++k;
  		wchar_t full[MAX_PATH * 4];
  		GetFullPathNameW(path.c_str(), MAX_PATH * 4, full, nullptr);
  		std::wstring alias = L"stellanova_sound_" + std::to_wstring(++made);
  		if (mciSendStringW((L"open \"" + std::wstring(full) + L"\" type mpegvideo alias " + alias).c_str(), nullptr, 0, nullptr) != 0)
  			stellanova::fail(line, "I couldn't play \"" + file + "\" (it must be a .wav or .mp3 file).");
  		playing.push_back(alias);
  		mciSendStringW((L"play " + alias + (loop ? L" repeat" : L"") + (wait ? L" wait" : L"")).c_str(), nullptr, 0, nullptr);
  	}

  	inline void stop()
  	{
  		for (const auto& alias : playing)
  			mciSendStringW((L"close " + alias).c_str(), nullptr, 0, nullptr);
  		playing.clear();
  	}

  	// one song at a time
  	inline bool song_open = false;
  	inline std::wstring song_status(const wchar_t* what)
  	{
  		wchar_t said[128] = L"";
  		if (song_open)
  			mciSendStringW((std::wstring(L"status stellanova_song ") + what).c_str(), said, 128, nullptr);
  		return said;
  	}
  	inline void song_stop()
  	{
  		if (song_open)
  			mciSendStringW(L"close stellanova_song", nullptr, 0, nullptr);
  		song_open = false;
  	}
  	inline void song_play(const std::string& file, int line)
  	{
  		song_stop();
  		if (GetFileAttributesW(wide(file).c_str()) == INVALID_FILE_ATTRIBUTES)
  			stellanova::fail(line, "there is no sound file called \"" + file + "\".");
  		if (mciSendStringW((L"open \"" + wide(file) + L"\" type mpegvideo alias stellanova_song").c_str(), nullptr, 0, nullptr) != 0)
  			stellanova::fail(line, "I couldn't play \"" + file + "\" (it must be a .wav or .mp3 file).");
  		song_open = true;
  		mciSendStringW(L"set stellanova_song time format milliseconds", nullptr, 0, nullptr);
  		mciSendStringW(L"play stellanova_song", nullptr, 0, nullptr);
  	}
  	inline void song_say(const std::wstring& what)
  	{
  		if (song_open)
  			mciSendStringW((L"" + what).c_str(), nullptr, 0, nullptr);
  	}
  	inline double song_number(const wchar_t* what) { return _wtof(song_status(what).c_str()) / 1000.0; }
  	inline void song_seek(double seconds)
  	{
  		bool was = song_status(L"mode") == L"playing";
  		song_say(L"seek stellanova_song to " + std::to_wstring((long long)(seconds * 1000)));
  		if (was)
  			song_say(L"play stellanova_song");
  	}
  	inline void song_pause(bool paused) { song_say(paused ? L"pause stellanova_song" : L"resume stellanova_song"); }
  	inline bool song_playing() { return song_status(L"mode") == L"playing"; }
  	inline bool song_ended() { return song_open && song_status(L"mode") == L"stopped" && song_number(L"position") + 0.3 >= song_number(L"length"); }
  	inline double song_time() { return song_number(L"position"); }
  	inline double song_length() { return song_number(L"length"); }
  	inline void song_loudness(double level) { song_say(L"setaudio stellanova_song volume to " + std::to_wstring((int)(std::clamp(level, 0.0, 1.0) * 1000))); }
  }
  #endif


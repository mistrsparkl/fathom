the day of the week = stellanova_time::weekday(), text, read only
  runs: ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")[time.localtime().tm_wday]
  web: stellanova_time::weekday()
seconds since 1970 = (double)std::time(nullptr), number, read only
  runs: float(int(time.time()))

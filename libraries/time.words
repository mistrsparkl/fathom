note: Words for time. Use them in a program with:  use: time

include: <chrono>
include: <ctime>
include: <thread>

code:
  namespace stellanova_time
  {
  	inline void local(std::tm& parts, std::time_t now)  // the clock's parts here (Windows and WebAssembly say it differently)
  	{
  #ifdef _WIN32
  		localtime_s(&parts, &now);
  #else
  		localtime_r(&now, &parts);
  #endif
  	}
  	inline const auto started = std::chrono::steady_clock::now();
  	inline double since_start() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count(); }
  	inline double part_of_today(int which)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		local(parts, now);
  		int values[] = {parts.tm_hour, parts.tm_min, parts.tm_sec, parts.tm_mday, parts.tm_mon + 1, parts.tm_year + 1900};
  		return values[which];
  	}
  }

python:
  started = time.monotonic()
  def part_of_today(which):
      t = time.localtime()
      return float((t.tm_hour, t.tm_min, t.tm_sec, t.tm_mday, t.tm_mon, t.tm_year)[which])

to wait, given seconds (a number) = std::this_thread::sleep_for(std::chrono::duration<double>({seconds}))
  runs: time.sleep(max(0.0, {seconds}))
  web: (await stellanova_time::wait({seconds}))

seconds since the start = stellanova_time::since_start(), number, read only
  runs: time.monotonic() - started
  web: stellanova_time::since_start()
the current hour = stellanova_time::part_of_today(0), number, read only
  runs: part_of_today(0)
  web: new Date().getHours()
the current minute = stellanova_time::part_of_today(1), number, read only
  runs: part_of_today(1)
  web: new Date().getMinutes()
the current second = stellanova_time::part_of_today(2), number, read only
  runs: part_of_today(2)
  web: new Date().getSeconds()
the day of the month = stellanova_time::part_of_today(3), number, read only
  runs: part_of_today(3)
  web: new Date().getDate()
the current month = stellanova_time::part_of_today(4), number, read only
  runs: part_of_today(4)
  web: (new Date().getMonth() + 1)
the current year = stellanova_time::part_of_today(5), number, read only
  runs: part_of_today(5)
  web: new Date().getFullYear()

code:
  namespace stellanova_time
  {
  	inline std::string stamp(const char* shape)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		local(parts, now);
  		char out[64];
  		std::strftime(out, sizeof out, shape, &parts);
  		return out;
  	}
  	inline std::string weekday()
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		local(parts, now);
  		const char* names[] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
  		return names[parts.tm_wday];
  	}
  }

today = stellanova_time::stamp("%Y-%m-%d"), text, read only
  runs: time.strftime("%Y-%m-%d")
  web: stellanova_time::stamp(true)
the time now = stellanova_time::stamp("%H:%M:%S"), text, read only
  runs: time.strftime("%H:%M:%S")
  web: stellanova_time::stamp(false)
the day of the week = stellanova_time::weekday(), text, read only
  runs: ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")[time.localtime().tm_wday]
  web: stellanova_time::weekday()
seconds since 1970 = (double)std::time(nullptr), number, read only
  runs: float(int(time.time()))
  web: Math.floor(Date.now() / 1000)

javascript:
  const stellanova_time = {
    started: Date.now(),
    wait: (seconds) => new Promise((done) => setTimeout(done, Math.max(0, seconds) * 1000)),
    since_start: () => (Date.now() - stellanova_time.started) / 1000,
    stamp(day) {
      const d = new Date(), two = (n) => String(n).padStart(2, "0");
      return day ? `${d.getFullYear()}-${two(d.getMonth() + 1)}-${two(d.getDate())}` : `${two(d.getHours())}:${two(d.getMinutes())}:${two(d.getSeconds())}`;
    },
    weekday: () => ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][new Date().getDay()],
  };

note: Dates are text, written like 2026-11-13 (as 'today' gives them), so they sort, compare and save as they are.
code:
  namespace stellanova_time
  {
  	// days since 1970-01-01 (Howard Hinnant's days_from_civil), so dates can be counted between
  	inline long long day_number(const std::string& date, int line)
  	{
  		int y = 0, m = 0, d = 0;
  		char extra = 0;
  		if (date.size() != 10 || std::sscanf(date.c_str(), "%4d-%2d-%2d%c", &y, &m, &d, &extra) != 3 || m < 1 || m > 12 || d < 1
  			|| d > (m == 2 ? 28 + ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) : 30 + ((m + (m > 7)) % 2)))
  			stellanova::fail(line, "'" + date + "' isn't a date: dates are written like 2026-11-13.");
  		y -= m <= 2;
  		long long era = (y >= 0 ? y : y - 399) / 400, yoe = y - era * 400;
  		long long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1, doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  		return era * 146097 + doe - 719468;
  	}
  	inline std::string date_of(long long z)
  	{
  		z += 719468;
  		long long era = (z >= 0 ? z : z - 146096) / 146097, doe = z - era * 146097;
  		long long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365, doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  		long long mp = (5 * doy + 2) / 153, d = doy - (153 * mp + 2) / 5 + 1, m = mp < 10 ? mp + 3 : mp - 9, y = yoe + era * 400 + (m <= 2);
  		char out[32];
  		std::snprintf(out, sizeof out, "%04lld-%02lld-%02lld", y, m, d);
  		return out;
  	}
  	inline double days_between(const std::string& a, const std::string& b, int line) { return (double)(day_number(b, line) - day_number(a, line)); }
  	inline std::string date_plus_days(const std::string& date, double days, int line)
  	{
  		if (std::floor(days) != days)
  			stellanova::fail(line, "'date plus days' needs a whole number of days, not " + stellanova::text(days) + ".");
  		return date_of(day_number(date, line) + (long long)days);
  	}
  	inline std::string weekday_of(const std::string& date, int line)
  	{
  		const char* names[] = {"Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"};
  		long long k = day_number(date, line) % 7;
  		return names[k < 0 ? k + 7 : k];
  	}
  }

python:
  import datetime
  def day_of(date):
      try:
          if len(date) != 10:
              raise ValueError
          return datetime.date.fromisoformat(date)
      except ValueError:
          raise RunError(0, "'" + date + "' isn't a date: dates are written like 2026-11-13.")
  def date_plus_days(date, days):
      if days != int(days):
          raise RunError(0, "'date plus days' needs a whole number of days, not " + text(days) + ".")
      return (day_of(date) + datetime.timedelta(days=int(days))).isoformat()

to days between, given first (text) and last (text), returning a number = stellanova_time::days_between({first}, {last}, {line})
  runs: float((day_of({last}) - day_of({first})).days)
  web: stellanova_time::days_between({first}, {last}, {line})
to days until, given date (text), returning a number = stellanova_time::days_between(stellanova_time::stamp("%Y-%m-%d"), {date}, {line})
  runs: float((day_of({date}) - datetime.date.today()).days)
  web: stellanova_time::days_between(stellanova_time::stamp(true), {date}, {line})
to date plus days, given date (text) and days (a number), returning text = stellanova_time::date_plus_days({date}, {days}, {line})
  runs: date_plus_days({date}, {days})
  web: stellanova_time::date_plus_days({date}, {days}, {line})
to weekday of, given date (text), returning text = stellanova_time::weekday_of({date}, {line})
  runs: ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")[day_of({date}).weekday()]
  web: stellanova_time::weekday_of({date}, {line})

javascript:
  Object.assign(stellanova_time, {
    day_number(date, line) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
      const t = m && Date.UTC(+m[1], +m[2] - 1, +m[3]);
      if (!m || new Date(t).getUTCDate() !== +m[3] || new Date(t).getUTCMonth() !== +m[2] - 1)
        stellanova.fail(line, `'${date}' isn't a date: dates are written like 2026-11-13.`);
      return Math.round(t / 86400000);
    },
    days_between: (a, b, line) => stellanova_time.day_number(b, line) - stellanova_time.day_number(a, line),
    date_plus_days(date, days, line) {
      if (Math.floor(days) !== days) stellanova.fail(line, `'date plus days' needs a whole number of days, not ${days}.`);
      return new Date((stellanova_time.day_number(date, line) + days) * 86400000).toISOString().slice(0, 10);
    },
    weekday_of: (date, line) => ["Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"][((stellanova_time.day_number(date, line) % 7) + 7) % 7],
  });

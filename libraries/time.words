javascript:
  Object.assign(stellanova_time, {
    month_names: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
    date_in_words(date, line) {
      const day = stellanova_time.weekday_of(date, line), [y, m, d] = date.split("-").map(Number);
      return `${day} ${d} ${stellanova_time.month_names[m - 1]} ${y}`;
    },
    date_plus_months(date, months, line) {
      if (Math.floor(months) !== months) stellanova.fail(line, `'date plus months' needs a whole number of months, not ${months}.`);
      stellanova_time.day_number(date, line);
      const [y, m, d] = date.split("-").map(Number), k = y * 12 + m - 1 + months, ny = Math.floor(k / 12), nm = k - ny * 12;
      const at = (day) => { const t = new Date(0); t.setUTCFullYear(ny, nm, day); return t; };  // setUTCFullYear: years below 100 stay as they are
      const last = 32 - at(32).getUTCDate();  // day 32 runs over into the next month by as many days as it is short
      const t = at(Math.min(d, last)), two = (n) => String(n).padStart(2, "0");
      return `${String(t.getUTCFullYear()).padStart(4, "0")}-${two(t.getUTCMonth() + 1)}-${two(t.getUTCDate())}`;
    },
    moment(seconds, day) {
      const t = new Date(Math.floor(seconds) * 1000), two = (n) => String(n).padStart(2, "0");
      return day ? `${t.getFullYear()}-${two(t.getMonth() + 1)}-${two(t.getDate())}` : `${two(t.getHours())}:${two(t.getMinutes())}:${two(t.getSeconds())}`;
    },
    seconds_at(date, clock, line) {
      stellanova_time.day_number(date, line);
      const c = /^(\d\d):(\d\d):(\d\d)$/.exec(clock);
      if (!c || +c[1] > 23 || +c[2] > 59 || +c[3] > 59) stellanova.fail(line, `'${clock}' isn't a time: times are written like 14:05:00.`);
      const [y, m, d] = date.split("-").map(Number), t = new Date(0);
      t.setFullYear(y, m - 1, d);
      t.setHours(+c[1], +c[2], +c[3], 0);
      return t.getTime() / 1000;
    },
  });

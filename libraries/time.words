note: Words for time. Use them in a program with:  use: time

include: <chrono>
include: <ctime>
include: <thread>

code:
  namespace stellanova_time
  {
  	inline void local(std::tm& parts, std::time_t now)  // the clock's parts here (Windows and WebAssembly say it differently)
  	{
  #ifdef _WIN32
  		localtime_s(&parts, &now);
  #else
  		localtime_r(&now, &parts);
  #endif
  	}
  	inline const auto started = std::chrono::steady_clock::now();
  	inline double since_start() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count(); }
  	inline double part_of_today(int which)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		local(parts, now);
  		int values[] = {parts.tm_hour, parts.tm_min, parts.tm_sec, parts.tm_mday, parts.tm_mon + 1, parts.tm_year + 1900};
  		return values[which];
  	}
  }

python:
  started = time.monotonic()
  def part_of_today(which):
      t = time.localtime()
      return float((t.tm_hour, t.tm_min, t.tm_sec, t.tm_mday, t.tm_mon, t.tm_year)[which])


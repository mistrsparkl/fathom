javascript:
  const stellanova_time = {
    started: Date.now(),
    wait: (seconds) => new Promise((done) => setTimeout(done, Math.max(0, seconds) * 1000)),
    since_start: () => (Date.now() - stellanova_time.started) / 1000,
    stamp(day) {
      const d = new Date(), two = (n) => String(n).padStart(2, "0");
      return day ? `${d.getFullYear()}-${two(d.getMonth() + 1)}-${two(d.getDate())}` : `${two(d.getHours())}:${two(d.getMinutes())}:${two(d.getSeconds())}`;
    },
    weekday: () => ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][new Date().getDay()],
  };

note: Dates are text, written like 2026-11-13 (as 'today' gives them), so they sort, compare and save as they are.
code:
  namespace stellanova_time
  {
  	// days since 1970-01-01 (Howard Hinnant's days_from_civil), so dates can be counted between
  	inline long long day_number(const std::string& date, int line)
  	{
  		int y = 0, m = 0, d = 0;
  		char extra = 0;
  		if (date.size() != 10 || std::sscanf(date.c_str(), "%4d-%2d-%2d%c", &y, &m, &d, &extra) != 3 || m < 1 || m > 12 || d < 1
  			|| d > (m == 2 ? 28 + ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) : 30 + ((m + (m > 7)) % 2)))
  			stellanova::fail(line, "'" + date + "' isn't a date: dates are written like 2026-11-13.");
  		y -= m <= 2;
  		long long era = (y >= 0 ? y : y - 399) / 400, yoe = y - era * 400;
  		long long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1, doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  		return era * 146097 + doe - 719468;
  	}
  	inline std::string date_of(long long z)
  	{
  		z += 719468;
  		long long era = (z >= 0 ? z : z - 146096) / 146097, doe = z - era * 146097;
  		long long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365, doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  		long long mp = (5 * doy + 2) / 153, d = doy - (153 * mp + 2) / 5 + 1, m = mp < 10 ? mp + 3 : mp - 9, y = yoe + era * 400 + (m <= 2);
  		char out[32];
  		std::snprintf(out, sizeof out, "%04lld-%02lld-%02lld", y, m, d);
  		return out;
  	}
  	inline double days_between(const std::string& a, const std::string& b, int line) { return (double)(day_number(b, line) - day_number(a, line)); }
  	inline std::string date_plus_days(const std::string& date, double days, int line)
  	{
  		if (std::floor(days) != days)
  			stellanova::fail(line, "'date plus days' needs a whole number of days, not " + stellanova::text(days) + ".");
  		return date_of(day_number(date, line) + (long long)days);
  	}
  	inline std::string weekday_of(const std::string& date, int line)
  	{
  		const char* names[] = {"Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"};
  		long long k = day_number(date, line) % 7;
  		return names[k < 0 ? k + 7 : k];
  	}
  }

python:
  import datetime
  def day_of(date):
      try:
          if len(date) != 10:
              raise ValueError
          return datetime.date.fromisoformat(date)
      except ValueError:
          raise RunError(0, "'" + date + "' isn't a date: dates are written like 2026-11-13.")
  def date_plus_days(date, days):
      if days != int(days):
          raise RunError(0, "'date plus days' needs a whole number of days, not " + text(days) + ".")
      return (day_of(date) + datetime.timedelta(days=int(days))).isoformat()

to days between, given first (text) and last (text), returning a number = stellanova_time::days_between({first}, {last}, {line})
  runs: float((day_of({last}) - day_of({first})).days)
  web: stellanova_time::days_between({first}, {last}, {line})
to days until, given date (text), returning a number = stellanova_time::days_between(stellanova_time::stamp("%Y-%m-%d"), {date}, {line})
  runs: float((day_of({date}) - datetime.date.today()).days)
  web: stellanova_time::days_between(stellanova_time::stamp(true), {date}, {line})
to date plus days, given date (text) and days (a number), returning text = stellanova_time::date_plus_days({date}, {days}, {line})
  runs: date_plus_days({date}, {days})
  web: stellanova_time::date_plus_days({date}, {days}, {line})
to weekday of, given date (text), returning text = stellanova_time::weekday_of({date}, {line})
  runs: ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")[day_of({date}).weekday()]

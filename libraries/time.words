note: Words for time. Use them in a program with:  use: time

include: <chrono>
include: <ctime>
include: <thread>

code:
  namespace stellanova_time
  {
  	inline const auto started = std::chrono::steady_clock::now();
  	inline double since_start() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count(); }
  	inline double part_of_today(int which)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		localtime_s(&parts, &now);
  		int values[] = {parts.tm_hour, parts.tm_min, parts.tm_sec, parts.tm_mday, parts.tm_mon + 1, parts.tm_year + 1900};
  		return values[which];
  	}
  }

python:
  started = time.monotonic()
  def part_of_today(which):
      t = time.localtime()
      return float((t.tm_hour, t.tm_min, t.tm_sec, t.tm_mday, t.tm_mon, t.tm_year)[which])

to wait, given seconds (a number) = std::this_thread::sleep_for(std::chrono::duration<double>({seconds}))
  runs: time.sleep(max(0.0, {seconds}))
  web: (await stellanova_time::wait({seconds}))

seconds since the start = stellanova_time::since_start(), number, read only
  runs: time.monotonic() - started
  web: stellanova_time::since_start()
the current hour = stellanova_time::part_of_today(0), number, read only
  runs: part_of_today(0)
  web: new Date().getHours()
the current minute = stellanova_time::part_of_today(1), number, read only
  runs: part_of_today(1)
  web: new Date().getMinutes()
the current second = stellanova_time::part_of_today(2), number, read only
  runs: part_of_today(2)
  web: new Date().getSeconds()
the day of the month = stellanova_time::part_of_today(3), number, read only
  runs: part_of_today(3)
  web: new Date().getDate()
the current month = stellanova_time::part_of_today(4), number, read only
  runs: part_of_today(4)
  web: (new Date().getMonth() + 1)
the current year = stellanova_time::part_of_today(5), number, read only
  runs: part_of_today(5)
  web: new Date().getFullYear()

code:
  namespace stellanova_time
  {
  	inline std::string stamp(const char* shape)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		localtime_s(&parts, &now);
  		char out[64];
  		std::strftime(out, sizeof out, shape, &parts);
  		return out;
  	}
  	inline std::string weekday()
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		localtime_s(&parts, &now);
  		const char* names[] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
  		return names[parts.tm_wday];
  	}
  }

today = stellanova_time::stamp("%Y-%m-%d"), text, read only
  runs: time.strftime("%Y-%m-%d")
  web: stellanova_time::stamp(true)
the time now = stellanova_time::stamp("%H:%M:%S"), text, read only
  runs: time.strftime("%H:%M:%S")
  web: stellanova_time::stamp(false)
the day of the week = stellanova_time::weekday(), text, read only
  runs: ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")[time.localtime().tm_wday]
  web: stellanova_time::weekday()
seconds since 1970 = (double)std::time(nullptr), number, read only
  runs: float(int(time.time()))
  web: Math.floor(Date.now() / 1000)

javascript:
  const stellanova_time = {
    started: Date.now(),
    wait: (seconds) => new Promise((done) => setTimeout(done, Math.max(0, seconds) * 1000)),
    since_start: () => (Date.now() - stellanova_time.started) / 1000,
    stamp(day) {
      const d = new Date(), two = (n) => String(n).padStart(2, "0");
      return day ? `${d.getFullYear()}-${two(d.getMonth() + 1)}-${two(d.getDate())}` : `${two(d.getHours())}:${two(d.getMinutes())}:${two(d.getSeconds())}`;
    },
    weekday: () => ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][new Date().getDay()],
  };

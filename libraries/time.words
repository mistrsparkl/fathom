note: Words for time. Use them in a program with:  use: time

include: <chrono>
include: <ctime>
include: <thread>

code:
  namespace imagine_time
  {
  	inline const auto started = std::chrono::steady_clock::now();
  	inline double since_start() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count(); }
  	inline double part_of_today(int which)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		localtime_s(&parts, &now);
  		int values[] = {parts.tm_hour, parts.tm_min, parts.tm_sec, parts.tm_mday, parts.tm_mon + 1, parts.tm_year + 1900};
  		return values[which];
  	}
  }

python:
  started = time.monotonic()
  def part_of_today(which):
      t = time.localtime()
      return float((t.tm_hour, t.tm_min, t.tm_sec, t.tm_mday, t.tm_mon, t.tm_year)[which])

to wait, given seconds (a number) = std::this_thread::sleep_for(std::chrono::duration<double>({seconds}))
  runs: time.sleep(max(0.0, {seconds}))

seconds since start = imagine_time::since_start(), number, read only
  runs: time.monotonic() - started
hour now = imagine_time::part_of_today(0), number, read only
  runs: part_of_today(0)
minute now = imagine_time::part_of_today(1), number, read only
  runs: part_of_today(1)
second now = imagine_time::part_of_today(2), number, read only
  runs: part_of_today(2)
day of the month = imagine_time::part_of_today(3), number, read only
  runs: part_of_today(3)
month now = imagine_time::part_of_today(4), number, read only
  runs: part_of_today(4)
year now = imagine_time::part_of_today(5), number, read only
  runs: part_of_today(5)

code:
  namespace imagine_time
  {
  	inline std::string stamp(const char* shape)
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		localtime_s(&parts, &now);
  		char out[64];
  		std::strftime(out, sizeof out, shape, &parts);
  		return out;
  	}
  	inline std::string weekday()
  	{
  		std::time_t now = std::time(nullptr);
  		std::tm parts{};
  		localtime_s(&parts, &now);
  		const char* names[] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
  		return names[parts.tm_wday];
  	}
  }

today = imagine_time::stamp("%Y-%m-%d"), text, read only
  runs: time.strftime("%Y-%m-%d")
the time now = imagine_time::stamp("%H:%M:%S"), text, read only
  runs: time.strftime("%H:%M:%S")
day of the week = imagine_time::weekday(), text, read only
  runs: ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")[time.localtime().tm_wday]
seconds since 1970 = (double)std::time(nullptr), number, read only
  runs: float(int(time.time()))

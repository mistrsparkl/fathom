note: Words for making sounds: tones, notes, mixing, effects, .wav files and recording from the microphone.
note: Use them in a program with:  use: sound making
note: A sound is a list of numbers from -1 to 1, 44100 of them for each second (one for each moment of the wave).
note: Save one with 'save the sound', then play it with the sound library's 'play the sound'.

code:
  #define NOMINMAX
include: <winsock2.h>
include: <windows.h>
include: <mmsystem.h>
include: <cmath>
include: <fstream>
include: <random>
link: winmm

code:
  namespace stellanova_making
  {
  	constexpr double RATE = 44100;
  	inline std::vector<double> tone(const std::string& shape, double pitch, double seconds, double loudness, int line)
  	{
  		if (!(seconds >= 0 && seconds <= 600))
  			stellanova::fail(line, "a tone lasts 0 to 600 seconds, not " + stellanova::text(seconds) + ".");
  		static std::mt19937 random{12345};
  		std::uniform_real_distribution<double> any(-1.0, 1.0);
  		size_t n = (size_t)std::llround(seconds * RATE);
  		std::vector<double> out(n);
  		for (size_t k = 0; k < n; ++k)
  		{
  			double phase = std::fmod(pitch * (double)k / RATE, 1.0), v;
  			if (shape == "sine") v = std::sin(phase * 6.283185307179586);
  			else if (shape == "square") v = phase < 0.5 ? 1 : -1;
  			else if (shape == "saw") v = 2 * phase - 1;
  			else if (shape == "triangle") v = phase < 0.5 ? 4 * phase - 1 : 3 - 4 * phase;
  			else if (shape == "noise") v = any(random);
  			else stellanova::fail(line, "there is no tone shape called \"" + shape + "\". Shapes: sine, square, saw, triangle, noise.");
  			out[k] = v * loudness;
  		}
  		return out;
  	}
  	inline double note(const std::string& name, int line)  // "A4" is 440, "C#5", "Bb3"
  	{
  		static const int steps[] = {9, 11, 0, 2, 4, 5, 7};  // A B C D E F G, from C
  		if (name.size() < 2 || name[0] < 'A' || name[0] > 'G')
  			stellanova::fail(line, "a note looks like \"A4\", \"C#5\" or \"Bb3\", not \"" + name + "\".");
  		int step = steps[name[0] - 'A'];
  		size_t k = 1;
  		if (name[k] == '#') step += 1, ++k;
  		else if (name[k] == 'b') step -= 1, ++k;
  		if (k >= name.size() || name.find_first_not_of("-0123456789", k) != std::string::npos)
  			stellanova::fail(line, "a note looks like \"A4\", \"C#5\" or \"Bb3\", not \"" + name + "\".");
  		int octave = std::stoi(name.substr(k));
  		return 440.0 * std::pow(2.0, (step - 9 + 12 * (octave - 4)) / 12.0);
  	}
  	inline std::vector<double> mixed(const std::vector<double>& a, const std::vector<double>& b)
  	{
  		std::vector<double> out(std::max(a.size(), b.size()), 0.0);
  		for (size_t k = 0; k < a.size(); ++k) out[k] += a[k];
  		for (size_t k = 0; k < b.size(); ++k) out[k] += b[k];
  		return out;
  	}
  	inline std::vector<double> followed(std::vector<double> a, const std::vector<double>& b)
  	{
  		a.insert(a.end(), b.begin(), b.end());
  		return a;
  	}
  	inline std::vector<double> louder(std::vector<double> a, double times)
  	{
  		for (double& x : a) x *= times;
  		return a;
  	}
  	inline std::vector<double> faded(std::vector<double> a, double in, double out)
  	{
  		double n = (double)a.size(), fin = in * RATE, fout = out * RATE;
  		for (size_t k = 0; k < a.size(); ++k)
  		{
  			double t = 1;
  			if (fin > 0 && (double)k < fin) t = (double)k / fin;
  			if (fout > 0 && n - (double)k < fout) t = std::min(t, (n - (double)k) / fout);
  			a[k] *= t;
  		}
  		return a;
  	}
  	inline std::vector<double> echoed(const std::vector<double>& a, double delay, double strength, int line)
  	{
  		if (!(delay > 0 && delay <= 10))
  			stellanova::fail(line, "an echo comes back after more than 0 and at most 10 seconds, not " + stellanova::text(delay) + ".");
  		size_t gap = (size_t)std::llround(delay * RATE);
  		std::vector<double> out(a);
  		out.resize(a.size() + gap * 4, 0.0);
  		for (size_t k = gap; k < out.size(); ++k)
  			out[k] += out[k - gap] * strength;
  		return out;
  	}
  	inline void save(const std::vector<double>& a, const std::string& file, int line)
  	{
  		std::string data;
  		for (double x : a)
  		{
  			double c = x < -1 ? -1 : x > 1 ? 1 : x;
  			int16_t v = (int16_t)std::lround(c * 32767);
  			data += (char)(v & 255), data += (char)((v >> 8) & 255);
  		}
  		auto word = [](uint32_t v, int n) { std::string s; for (int k = 0; k < n; ++k) s += (char)((v >> (8 * k)) & 255); return s; };
  		std::string head = "RIFF" + word((uint32_t)(36 + data.size()), 4) + "WAVEfmt " + word(16, 4) + word(1, 2) + word(1, 2)
  		                 + word(44100, 4) + word(88200, 4) + word(2, 2) + word(16, 2) + "data" + word((uint32_t)data.size(), 4);
  		std::ofstream f(std::filesystem::u8path(file), std::ios::binary);
  		if (!f || !f.write((head + data).data(), (std::streamsize)(head.size() + data.size())))
  			stellanova::fail(line, "I couldn't write the file \"" + file + "\".");
  	}
  	inline std::vector<double> load(const std::string& file, int line)
  	{
  		std::ifstream f(std::filesystem::u8path(file), std::ios::binary);
  		std::string all((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
  		if (!f && all.empty())
  			stellanova::fail(line, "there is no file called \"" + file + "\".");
  		auto num = [&](size_t at, int n) { uint32_t v = 0; for (int k = n - 1; k >= 0; --k) v = (v << 8) | (unsigned char)all[at + k]; return v; };
  		if (all.size() < 12 || all.compare(0, 4, "RIFF") || all.compare(8, 4, "WAVE"))
  			stellanova::fail(line, "\"" + file + "\" isn't a .wav file.");
  		int channels = 1, bits = 16;
  		for (size_t at = 12; at + 8 <= all.size();)
  		{
  			std::string id = all.substr(at, 4);
  			size_t size = num(at + 4, 4);
  			if (id == "fmt " && at + 24 <= all.size())
  			{
  				if (num(at + 8, 2) != 1)
  					stellanova::fail(line, "\"" + file + "\" isn't plain PCM sound (only those .wav files can be read).");
  				channels = (int)num(at + 10, 2), bits = (int)num(at + 22, 2);
  			}
  			if (id == "data")
  			{
  				if (bits != 16)
  					stellanova::fail(line, "\"" + file + "\" has " + std::to_string(bits) + "-bit sound; only 16-bit .wav files can be read.");
  				std::vector<double> out;
  				size_t end = std::min(all.size(), at + 8 + size);
  				for (size_t k = at + 8; k + 2 * channels <= end; k += 2 * channels)
  					out.push_back((int16_t)num(k, 2) / 32768.0);
  				return out;
  			}
  			at += 8 + size + (size & 1);
  		}
  		stellanova::fail(line, "\"" + file + "\" has no sound in it.");
  	}
  	inline std::vector<double> record(double seconds, int line)
  	{
  		if (!(seconds > 0 && seconds <= 600))
  			stellanova::fail(line, "a recording lasts more than 0 and at most 600 seconds, not " + stellanova::text(seconds) + ".");
  		WAVEFORMATEX format{WAVE_FORMAT_PCM, 1, 44100, 88200, 2, 16, 0};
  		HWAVEIN in = nullptr;
  		if (waveInOpen(&in, WAVE_MAPPER, &format, 0, 0, CALLBACK_NULL) != MMSYSERR_NOERROR)
  			stellanova::fail(line, "I couldn't open a microphone.");
  		std::vector<int16_t> data((size_t)(seconds * 44100));
  		WAVEHDR header{};
  		header.lpData = (LPSTR)data.data();
  		header.dwBufferLength = (DWORD)(data.size() * 2);
  		waveInPrepareHeader(in, &header, sizeof header);
  		waveInAddBuffer(in, &header, sizeof header);
  		waveInStart(in);
  		while (!(header.dwFlags & WHDR_DONE))
  			Sleep(10);
  		waveInUnprepareHeader(in, &header, sizeof header);
  		waveInClose(in);
  		std::vector<double> out;
  		for (size_t k = 0; k < header.dwBytesRecorded / 2; ++k)
  			out.push_back(data[k] / 32768.0);
  		return out;
  	}
  }

python:
  import random as _random
  import struct as _struct
  _noise = _random.Random(12345)
  RATE = 44100
  def tone(shape, pitch, seconds, loudness):
      if not 0 <= seconds <= 600:
          raise RunError(0, "a tone lasts 0 to 600 seconds, not " + text(seconds) + ".")
      n = round(seconds * RATE)
      two_pi = 6.283185307179586
      if shape == "sine":
          return [math.sin(((pitch * k / RATE) % 1.0) * two_pi) * loudness for k in range(n)]
      if shape == "square":
          return [(1.0 if (pitch * k / RATE) % 1.0 < 0.5 else -1.0) * loudness for k in range(n)]
      if shape == "saw":
          return [(2 * ((pitch * k / RATE) % 1.0) - 1) * loudness for k in range(n)]
      if shape == "triangle":
          out = []
          for k in range(n):
              p = (pitch * k / RATE) % 1.0
              out.append((4 * p - 1 if p < 0.5 else 3 - 4 * p) * loudness)
          return out
      if shape == "noise":
          return [_noise.uniform(-1, 1) * loudness for _ in range(n)]
      raise RunError(0, 'there is no tone shape called "' + shape + '". Shapes: sine, square, saw, triangle, noise.')
  def note(name):
      import re as _re
      m = _re.fullmatch(r"([A-G])([#b]?)(-?\d+)", name)
      if not m:
          raise RunError(0, 'a note looks like "A4", "C#5" or "Bb3", not "' + name + '".')
      step = {"A": 9, "B": 11, "C": 0, "D": 2, "E": 4, "F": 5, "G": 7}[m.group(1)] + {"#": 1, "b": -1, "": 0}[m.group(2)]
      return 440.0 * 2 ** ((step - 9 + 12 * (int(m.group(3)) - 4)) / 12)
  def mixed(a, b):
      out = [0.0] * max(len(a), len(b))
      for k, x in enumerate(a):
          out[k] += x
      for k, x in enumerate(b):
          out[k] += x
      return out
  def faded(a, fin, fout):
      n, fin, fout = len(a), fin * RATE, fout * RATE
      out = []
      for k, x in enumerate(a):
          t = 1.0
          if fin > 0 and k < fin:
              t = k / fin
          if fout > 0 and n - k < fout:
              t = min(t, (n - k) / fout)
          out.append(x * t)
      return out
  def echoed(a, delay, strength):
      if not 0 < delay <= 10:
          raise RunError(0, "an echo comes back after more than 0 and at most 10 seconds, not " + text(delay) + ".")
      gap = round(delay * RATE)
      out = list(a) + [0.0] * (gap * 4)
      for k in range(gap, len(out)):
          out[k] += out[k - gap] * strength
      return out
  def save_sound(a, file):
      data = b"".join(_struct.pack("<h", round(max(-1.0, min(1.0, x)) * 32767)) for x in a)
      head = b"RIFF" + _struct.pack("<I", 36 + len(data)) + b"WAVEfmt " + _struct.pack("<IHHIIHH", 16, 1, 1, 44100, 88200, 2, 16) + b"data" + _struct.pack("<I", len(data))
      try:
          with open(file, "wb") as f:
              f.write(head + data)
      except OSError:
          raise RunError(0, 'I couldn\'t write the file "' + file + '".')
  def load_sound(file):
      try:
          with open(file, "rb") as f:
              data = f.read()
      except OSError:
          raise RunError(0, 'there is no file called "' + file + '".')
      if data[:4] != b"RIFF" or data[8:12] != b"WAVE":
          raise RunError(0, '"' + file + '" isn\'t a .wav file.')
      at, channels, bits = 12, 1, 16
      while at + 8 <= len(data):
          kind, size = data[at:at + 4], _struct.unpack("<I", data[at + 4:at + 8])[0]
          if kind == b"fmt ":
              if _struct.unpack("<H", data[at + 8:at + 10])[0] != 1:
                  raise RunError(0, '"' + file + '" isn\'t plain PCM sound (only those .wav files can be read).')
              channels, bits = _struct.unpack("<H", data[at + 10:at + 12])[0], _struct.unpack("<H", data[at + 22:at + 24])[0]
          if kind == b"data":
              if bits != 16:
                  raise RunError(0, '"' + file + '" has ' + str(bits) + "-bit sound; only 16-bit .wav files can be read.")
              body = data[at + 8:min(len(data), at + 8 + size)]
              step = 2 * channels
              return [_struct.unpack("<h", body[k:k + 2])[0] / 32768.0 for k in range(0, len(body) - step + 1, step)]
          at += 8 + size + (size & 1)
      raise RunError(0, '"' + file + '" has no sound in it.')
  def record(seconds):
      import ctypes, time as _time
      from ctypes import wintypes
      if not 0 < seconds <= 600:
          raise RunError(0, "a recording lasts more than 0 and at most 600 seconds, not " + text(seconds) + ".")
      class FORMAT(ctypes.Structure):
          _fields_ = [("tag", wintypes.WORD), ("channels", wintypes.WORD), ("rate", wintypes.DWORD), ("bytes", wintypes.DWORD),
                      ("align", wintypes.WORD), ("bits", wintypes.WORD), ("extra", wintypes.WORD)]
      class HEADER(ctypes.Structure):
          _fields_ = [("data", ctypes.c_void_p), ("length", wintypes.DWORD), ("recorded", wintypes.DWORD), ("user", ctypes.c_void_p),
                      ("flags", wintypes.DWORD), ("loops", wintypes.DWORD), ("next", ctypes.c_void_p), ("reserved", ctypes.c_void_p)]
      winmm = ctypes.WinDLL("winmm")
      handle = ctypes.c_void_p()
      fmt = FORMAT(1, 1, 44100, 88200, 2, 16, 0)
      if winmm.waveInOpen(ctypes.byref(handle), 0xFFFFFFFF, ctypes.byref(fmt), None, None, 0) != 0:
          raise RunError(0, "I couldn't open a microphone.")
      buffer = ctypes.create_string_buffer(int(seconds * 44100) * 2)
      head = HEADER(ctypes.cast(buffer, ctypes.c_void_p), len(buffer), 0, None, 0, 0, None, None)
      winmm.waveInPrepareHeader(handle, ctypes.byref(head), ctypes.sizeof(head))
      winmm.waveInAddBuffer(handle, ctypes.byref(head), ctypes.sizeof(head))
      winmm.waveInStart(handle)
      while not head.flags & 1:
          _time.sleep(0.01)
      winmm.waveInUnprepareHeader(handle, ctypes.byref(head), ctypes.sizeof(head))
      winmm.waveInClose(handle)
      raw = buffer.raw[:head.recorded]
      return [_struct.unpack("<h", raw[k:k + 2])[0] / 32768.0 for k in range(0, len(raw) - 1, 2)]

to a tone, given shape (text) and pitch (a number) and seconds (a number) and loudness (a number), returning a list of numbers = stellanova_making::tone({shape}, {pitch}, {seconds}, {loudness}, {line})
  runs: tone({shape}, {pitch}, {seconds}, {loudness})
  web: stellanova_making.tone({shape}, {pitch}, {seconds}, {loudness}, {line})
to the pitch of the note, given name (text), returning a number = stellanova_making::note({name}, {line})
  runs: note({name})
  web: stellanova_making.note({name}, {line})
to mixed, given first (a list of numbers) and second (a list of numbers), returning a list of numbers = stellanova_making::mixed({first}, {second})
  runs: mixed({first}, {second})
  web: stellanova_making.mixed({first}, {second})
to followed by, given first (a list of numbers) and second (a list of numbers), returning a list of numbers = stellanova_making::followed({first}, {second})
  runs: list({first}) + list({second})
  web: [...{first}, ...{second}]
to louder, given sound (a list of numbers) and times (a number), returning a list of numbers = stellanova_making::louder({sound}, {times})
  runs: [x * {times} for x in {sound}]
  web: {sound}.map((x) => x * {times})
to faded, given sound (a list of numbers) and fade in (a number) and fade out (a number), returning a list of numbers = stellanova_making::faded({sound}, {fade in}, {fade out})
  runs: faded({sound}, {fade in}, {fade out})
  web: stellanova_making.faded({sound}, {fade in}, {fade out})
to echoed, given sound (a list of numbers) and delay (a number) and strength (a number), returning a list of numbers = stellanova_making::echoed({sound}, {delay}, {strength}, {line})
  runs: echoed({sound}, {delay}, {strength})
  web: stellanova_making.echoed({sound}, {delay}, {strength}, {line})
to save the sound, given sound (a list of numbers) and file (text) = stellanova_making::save({sound}, {file}, {line})
  runs: save_sound({sound}, {file})
  web: stellanova_making.save({sound}, {file}, {line})
to the sound in the file, given file (text), returning a list of numbers = stellanova_making::load({file}, {line})
  runs: load_sound({file})
  web: stellanova_making.load({file}, {line})
to record the sound, given seconds (a number), returning a list of numbers = stellanova_making::record({seconds}, {line})
  runs: record({seconds})
  web: await stellanova_recording.record({seconds}, {line})

javascript:
  const stellanova_making = {
    RATE: 44100,
    seed: 12345,
    tone(shape, pitch, seconds, loudness, line) {
      if (!(seconds >= 0 && seconds <= 600)) stellanova.fail(line, `a tone lasts 0 to 600 seconds, not ${stellanova.text(seconds)}.`);
      const n = Math.round(seconds * this.RATE), out = new Array(n);
      const shapes = {
        sine: (p) => Math.sin(p * 6.283185307179586), square: (p) => (p < 0.5 ? 1 : -1), saw: (p) => 2 * p - 1,
        triangle: (p) => (p < 0.5 ? 4 * p - 1 : 3 - 4 * p),
        noise: () => { this.seed = (this.seed * 1103515245 + 12345) % 2147483648; return this.seed / 1073741824 - 1; },
      };
      const f = shapes[shape];
      if (!f) stellanova.fail(line, `there is no tone shape called "${shape}". Shapes: sine, square, saw, triangle, noise.`);
      for (let k = 0; k < n; k++) out[k] = f((pitch * k / this.RATE) % 1) * loudness;
      return out;
    },
    note(name, line) {
      const m = /^([A-G])([#b]?)(-?\d+)$/.exec(name);
      if (!m) stellanova.fail(line, `a note looks like "A4", "C#5" or "Bb3", not "${name}".`);
      const step = { A: 9, B: 11, C: 0, D: 2, E: 4, F: 5, G: 7 }[m[1]] + ({ "#": 1, b: -1, "": 0 })[m[2]];
      return 440 * Math.pow(2, (step - 9 + 12 * (Number(m[3]) - 4)) / 12);
    },
    mixed(a, b) {
      const out = new Array(Math.max(a.length, b.length)).fill(0);
      a.forEach((x, k) => (out[k] += x));
      b.forEach((x, k) => (out[k] += x));
      return out;
    },
    faded(a, fin, fout) {
      const n = a.length;
      fin *= this.RATE; fout *= this.RATE;
      return a.map((x, k) => {
        let t = 1;
        if (fin > 0 && k < fin) t = k / fin;
        if (fout > 0 && n - k < fout) t = Math.min(t, (n - k) / fout);
        return x * t;
      });
    },
    echoed(a, delay, strength, line) {
      if (!(delay > 0 && delay <= 10)) stellanova.fail(line, `an echo comes back after more than 0 and at most 10 seconds, not ${stellanova.text(delay)}.`);
      const gap = Math.round(delay * this.RATE), out = a.concat(new Array(gap * 4).fill(0));
      for (let k = gap; k < out.length; k++) out[k] += out[k - gap] * strength;
      return out;
    },
    fs() {
      if (typeof require !== "function") return null;
      return require("fs");
    },
    save(a, file, line) {
      const data = Buffer.alloc(44 + a.length * 2);
      data.write("RIFF", 0); data.writeUInt32LE(36 + a.length * 2, 4); data.write("WAVEfmt ", 8);
      data.writeUInt32LE(16, 16); data.writeUInt16LE(1, 20); data.writeUInt16LE(1, 22); data.writeUInt32LE(44100, 24);
      data.writeUInt32LE(88200, 28); data.writeUInt16LE(2, 32); data.writeUInt16LE(16, 34); data.write("data", 36); data.writeUInt32LE(a.length * 2, 40);
      a.forEach((x, k) => data.writeInt16LE(Math.round(Math.max(-1, Math.min(1, x)) * 32767), 44 + 2 * k));
      const fs = this.fs();
      if (!fs) stellanova.fail(line, "a web page can't save files.");
      try { fs.writeFileSync(file, data); } catch { stellanova.fail(line, `I couldn't write the file "${file}".`); }
    },
    load(file, line) {
      const fs = this.fs();
      if (!fs) stellanova.fail(line, "a web page can't read files.");
      let d;
      try { d = fs.readFileSync(file); } catch { stellanova.fail(line, `there is no file called "${file}".`); }
      if (d.toString("latin1", 0, 4) !== "RIFF" || d.toString("latin1", 8, 12) !== "WAVE") stellanova.fail(line, `"${file}" isn't a .wav file.`);
      let at = 12, channels = 1, bits = 16;
      while (at + 8 <= d.length) {
        const id = d.toString("latin1", at, at + 4), size = d.readUInt32LE(at + 4);
        if (id === "fmt ") {
          if (d.readUInt16LE(at + 8) !== 1) stellanova.fail(line, `"${file}" isn't plain PCM sound (only those .wav files can be read).`);
          channels = d.readUInt16LE(at + 10); bits = d.readUInt16LE(at + 22);
        }
        if (id === "data") {
          if (bits !== 16) stellanova.fail(line, `"${file}" has ${bits}-bit sound; only 16-bit .wav files can be read.`);
          const out = [], end = Math.min(d.length, at + 8 + size);
          for (let k = at + 8; k + 2 * channels <= end; k += 2 * channels) out.push(d.readInt16LE(k) / 32768);
          return out;
        }
        at += 8 + size + (size & 1);
      }
      stellanova.fail(line, `"${file}" has no sound in it.`);
    },
  };
  const stellanova_recording = {
    async record(seconds, line) {  // the page's microphone (the person is asked first), as 44100 numbers each second
      if (!(seconds > 0 && seconds <= 600)) stellanova.fail(line, `a recording lasts more than 0 and at most 600 seconds, not ${stellanova.text(seconds)}.`);
      if (typeof navigator === "undefined" || !navigator.mediaDevices) stellanova.fail(line, "recording needs a web page with a microphone (node has none).");
      let stream;
      try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); } catch { stellanova.fail(line, "I couldn't use the microphone (it may be missing, or not allowed)."); }
      const parts = [], recorder = new MediaRecorder(stream);
      recorder.ondataavailable = (e) => parts.push(e.data);
      const stopped = new Promise((r) => (recorder.onstop = r));
      recorder.start();
      await new Promise((r) => setTimeout(r, seconds * 1000));
      recorder.stop();
      await stopped;
      for (const t of stream.getTracks()) t.stop();
      const heard = await new AudioContext({ sampleRate: 44100 }).decodeAudioData(await new Blob(parts).arrayBuffer());
      return Array.from(heard.getChannelData(0).slice(0, Math.round(seconds * 44100)));
    },
  };

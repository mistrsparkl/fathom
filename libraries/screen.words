javascript:
  const fathom_screen = {
    // On the web the screen is a canvas over the page.
    page: typeof document !== "undefined",
    isOpen: false, lives: false, askedClose: false, w: 0, h: 0, k: 1, dt: 1 / 60, last: 0,
    mx: 0, my: 0, held: new Set(), down: new Set(), up: new Set(), double: false, wheel: 0, keys: [], typed: "",
    ctrl: false, shift: false, alt: false, play: null, playAt: 0, targets: [], layers: new Map(),
    need(line) { if (!this.isOpen) fathom.fail(line, "open the screen first, with 'open the screen with \"My app\"'."); },
    now() { return typeof performance !== "undefined" ? performance.now() / 1000 : Date.now() / 1000; },
    colours: new Map(),
    colour(c, line) {
      if (this.colours.has(c)) return this.colours.get(c);
      const named = { black: "#000000", white: "#ffffff", red: "#ff0000", green: "#00a000", blue: "#0000ff", clear: "#00000000" };
      let s = c.trim().toLowerCase();
      s = named[s] || s;
      let h = s.startsWith("#") ? s.slice(1) : "";
      if (h.length === 3 || h.length === 4) h = [...h].map((ch) => ch + ch).join("");
      if (h.length === 6) h += "ff";
      if (h.length !== 8 || !/^[0-9a-f]{8}$/.test(h))
        fathom.fail(line, `'${c}' isn't a colour I know. Write colours like "#0fb5ae", or "#0fb5ae80" to see through them.`);
      const v = [0, 2, 4, 6].map((i) => parseInt(h.slice(i, i + 2), 16));
      v.css = `rgba(${v[0]},${v[1]},${v[2]},${v[3] / 255})`;
      this.colours.set(c, v);
      return v;
    },
    hue(h, s, l, a) {
      const even = (x) => { const f = Math.floor(x), d = x - f; return d > 0.5 || (d === 0.5 && f % 2) ? f + 1 : f; };  // Python's round
      const L = Math.max(0, Math.min(100, l)) / 100, S = Math.max(0, Math.min(100, s)) / 100, H = (((h % 360) + 360) % 360) / 360;
      const m2 = L <= 0.5 ? L * (1 + S) : L + S - L * S, m1 = 2 * L - m2;
      const v = (t) => { t = ((t % 1) + 1) % 1; return t < 1 / 6 ? m1 + (m2 - m1) * t * 6 : t < 0.5 ? m2 : t < 2 / 3 ? m1 + (m2 - m1) * (2 / 3 - t) * 6 : m1; };
      const rgb = S === 0 ? [L, L, L] : [v(H + 1 / 3), v(H), v(H - 1 / 3)];
      return "#" + [...rgb.map((x) => even(x * 255)), even(Math.max(0, Math.min(1, a)) * 255)].map((p) => p.toString(16).padStart(2, "0")).join("");
    },
    canvas(w, h) {
      if (!this.page) return null;
      const c = document.createElement("canvas");
      c.width = Math.max(1, w), c.height = Math.max(1, h);
      return c;
    },
    open(title, line) {
      if (this.isOpen) return;
      const names = { " ": "Space" };
      if (this.page) {
        document.title = title;
        this.k = Math.max(1, devicePixelRatio || 1);
        this.w = Math.round(innerWidth * this.k), this.h = Math.round(innerHeight * this.k);
        const c = this.canvas(this.w, this.h);
        Object.assign(c.style, { position: "fixed", left: "0", top: "0", width: innerWidth + "px", height: innerHeight + "px", background: "#000", outline: "none" });
        c.tabIndex = 0;
        document.body.appendChild(c);
        this.screen = c;
        const where = (e) => { this.mx = e.offsetX, this.my = e.offsetY; };
        const button = (e) => (e.button === 2 ? "right" : e.button === 0 ? "left" : null);
        c.addEventListener("mousemove", where);
        c.addEventListener("mousedown", (e) => { where(e); const b = button(e); if (b) this.held.add(b), this.down.add(b); c.focus(); });
        addEventListener("mouseup", (e) => { const b = button(e); if (b) this.held.delete(b), this.up.add(b); });
        c.addEventListener("dblclick", () => (this.double = true));
        c.addEventListener("contextmenu", (e) => e.preventDefault());
        c.addEventListener("wheel", (e) => { this.wheel += e.deltaY / 100; e.preventDefault(); }, { passive: false });
        addEventListener("keydown", (e) => {
          this.ctrl = e.ctrlKey, this.shift = e.shiftKey, this.alt = e.altKey;
          this.keys.push(names[e.key] || (e.key.length === 1 ? e.key.toLowerCase() : e.key));
          if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) this.typed += e.key;
          if (e.key === "Tab" || e.key === "Backspace" || e.key === " " || e.key.startsWith("Arrow")) e.preventDefault();
        });
        addEventListener("keyup", (e) => { this.ctrl = e.ctrlKey, this.shift = e.shiftKey, this.alt = e.altKey; });
        c.focus();
      } else {
        const size = (process.env.FATHOM_SCREEN_SIZE || "1600x900").toLowerCase().split("x").map(Number);
        this.k = Number(process.env.FATHOM_SCREEN_SCALE) || 1;
        [this.w, this.h] = size;
        const play = process.env.FATHOM_SCREEN_PLAY;
        if (play) {
          this.play = require("fs").readFileSync(play, "utf8").split(/\r?\n/).map((l) => l.trim()).filter((l) => l && !l.startsWith("#"));
          this.playAt = this.now();
        }
      }
      this.isOpen = this.lives = true;
      this.askedClose = false;
      this.last = this.now();
      this.targets = [{ c: this.screen || null, g: this.screen ? this.screen.getContext("2d") : null, ox: 0, oy: 0, px: 0, py: 0, main: true }];
    },
    close() {
      if (!this.isOpen) return;
      this.lives = this.isOpen = false;
      if (this.screen) this.screen.remove();
      this.screen = null;
    },
    playSteps() {  // test steps: wait, move, click, down, up, double, right, wheel, key, type, shot, quit
      const steps = this.play, now = this.now();
      while (steps.length && now >= this.playAt) {
        const [what, ...rest] = steps.shift().split(" ");
        if (what === "wait") this.playAt = now + Number(rest[0]);
        else if (["move", "click", "down", "up", "double", "right"].includes(what)) {
          this.mx = Number(rest[0]), this.my = Number(rest[1]);
          if (what === "click" || what === "down" || what === "double") {
            this.held.add("left"), this.down.add("left");
            if (what !== "down") steps.unshift("release");
            if (what === "double") this.double = true;
            return;
          }
          if (what === "up") this.held.delete("left"), this.up.add("left");
          if (what === "right") this.down.add("right"), this.up.add("right");
        } else if (what === "release") { this.held.delete("left"), this.up.add("left"); return; }
        else if (what === "wheel") this.wheel += Number(rest[0]);
        else if (what === "key") {
          this.ctrl = rest.slice(1).includes("ctrl"), this.shift = rest.slice(1).includes("shift"), this.alt = rest.slice(1).includes("alt");
          this.keys.push(rest[0]);
          steps.unshift("lift");
          return;
        } else if (what === "lift") this.ctrl = this.shift = this.alt = false;
        else if (what === "type") { this.typed += rest.join(" "); return; }
        else if (what === "quit") this.askedClose = true, this.lives = false;
      }
    },
    async show(line) {
      this.need(line);
      if (this.targets.length > 1) fathom.fail(line, "a layer or a clip is still open: finish it ('end the layer' or 'end clipping') before showing the screen.");
      this.down = new Set(), this.up = new Set(), this.double = false, this.wheel = 0, this.keys = [], this.typed = "";
      if (this.play) this.playSteps();
      if (this.page) await new Promise((r) => requestAnimationFrame(() => r()));
      else {
        const left = 1 / 60 - (this.now() - this.last);
        if (left > 0) await new Promise((r) => setTimeout(r, left * 1000));
      }
      const now = this.now();
      this.dt = Math.min(0.25, now - this.last), this.last = now;
    },
    setCursor(look, line) {
      this.need(line);
      const names = { arrow: "default", hand: "pointer", text: "text", move: "move", across: "ew-resize", "up and down": "ns-resize",
                      corner: "nwse-resize", "other corner": "nesw-resize", wait: "wait" };
      if (this.screen) this.screen.style.cursor = names[look] || "default";
    },
    async clipboard() {
      if (!this.page || !navigator.clipboard) return "";
      return navigator.clipboard.readText().catch(() => "");
    },
    copy(words, line) {
      this.need(line);
      if (this.page && navigator.clipboard) navigator.clipboard.writeText(words).catch(() => {});
    },

    // ---- where drawing goes: the screen, a layer, or a clip inside them
    target() { return this.targets[this.targets.length - 1]; },
    px(t, x, y) { return [Math.round((x - t.ox) * this.k), Math.round((y - t.oy) * this.k)]; },
    size(w) { return Math.max(0, Math.round(w * this.k)); },
    paint(line, make) {  // the target's drawing, or nothing with node
      this.need(line);
      const t = this.target();
      if (t.g) { t.g.save(); make(t.g, t); t.g.restore(); }
    },
    rounded(g, X, Y, W, H, R) {
      g.beginPath();
      g.roundRect(X, Y, W, H, Math.max(0, Math.min(R, W / 2, H / 2)));
    },
    clear(c, line) {
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        if (!t.main) g.clearRect(0, 0, t.c.width, t.c.height);
        g.fillStyle = t.main ? `rgb(${col[0]},${col[1]},${col[2]})` : col.css;
        g.fillRect(0, 0, t.c.width, t.c.height);
      });
    },
    roundedBox(x, y, w, h, r, c, line) {
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y), W = this.size(w), H = this.size(h);
        if (W <= 0 || H <= 0 || col[3] === 0) return;
        g.fillStyle = col.css;
        if (r <= 0) g.fillRect(X, Y, W, H);
        else { this.rounded(g, X, Y, W, H, this.size(r)); g.fill(); }
      });
    },
    outlineBox(x, y, w, h, r, c, width, line) {
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y), W = this.size(w), H = this.size(h), R = this.size(r), L = Math.max(1, this.size(width));
        if (W <= 2 * L || H <= 2 * L) return;
        g.beginPath();
        g.roundRect(X, Y, W, H, Math.min(R, W / 2, H / 2));
        g.roundRect(X + L, Y + L, W - 2 * L, H - 2 * L, Math.max(0, Math.min(R - L, (W - 2 * L) / 2, (H - 2 * L) / 2)));
        g.fillStyle = col.css;
        g.fill("evenodd");
      });
    },
    fadingBox(x, y, w, h, r, c1, c2, sideways, line) {
      const a = this.colour(c1, line), b = this.colour(c2, line);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y), W = this.size(w), H = this.size(h);
        if (W <= 0 || H <= 0) return;
        const f = sideways ? g.createLinearGradient(X, 0, X + W, 0) : g.createLinearGradient(0, Y, 0, Y + H);
        f.addColorStop(0, a.css), f.addColorStop(1, b.css);
        g.fillStyle = f;
        this.rounded(g, X, Y, W, H, this.size(r));
        g.fill();
      });
    },
    glow(x, y, radius, c, line) {
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        const R = this.size(radius), [X, Y] = this.px(t, x, y);
        if (R <= 0) return;
        const f = g.createRadialGradient(X, Y, 0, X, Y, R);
        for (let k = 0; k <= 8; k++) f.addColorStop(k / 8, `rgba(${col[0]},${col[1]},${col[2]},${(col[3] / 255) * (1 - k / 8) ** 2})`);
        g.fillStyle = f;
        g.fillRect(X - R, Y - R, 2 * R, 2 * R);
      });
    },
    dot(x, y, radius, c, line) {
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        const R = radius * this.k, [X, Y] = this.px(t, x, y);
        if (R <= 0) return;
        g.fillStyle = col.css;
        g.beginPath();
        g.arc(X, Y, Math.max(1, Math.round(R * 2)) / 2, 0, 2 * Math.PI);
        g.fill();
      });
    },
    points(t, pts, line) {
      if (pts.length % 2) fathom.fail(line, "the points of a shape come in pairs: x, y, x, y...");
      const out = [];
      for (let i = 0; i < pts.length; i += 2) out.push(this.px(t, pts[i], pts[i + 1]));
      return out;
    },
    path(g, ps, close) {
      g.beginPath();
      ps.forEach(([x, y], k) => (k ? g.lineTo(x, y) : g.moveTo(x, y)));
      if (close) g.closePath();
    },
    shape(pts, c, line) {
      this.need(line);
      const ps = this.points(this.target(), pts, line), col = this.colour(c, line);
      this.paint(line, (g) => { if (ps.length >= 3) { this.path(g, ps, true); g.fillStyle = col.css; g.fill(); } });
    },
    fadingShape(pts, c1, c2, top, bottom, line) {
      this.need(line);
      const ps = this.points(this.target(), pts, line), a = this.colour(c1, line), b = this.colour(c2, line);
      this.paint(line, (g, t) => {
        if (ps.length < 3) return;
        const T = this.px(t, 0, top)[1], B = this.px(t, 0, bottom)[1], f = g.createLinearGradient(0, T, 0, B === T ? T + 1 : B);
        f.addColorStop(0, a.css), f.addColorStop(1, b.css);
        this.path(g, ps, true);
        g.fillStyle = f;
        g.fill();
      });
    },
    trace(pts, c, width, line) {
      this.need(line);
      const ps = this.points(this.target(), pts, line), col = this.colour(c, line);
      this.paint(line, (g) => {
        if (ps.length < 2) return;
        this.path(g, ps, false);
        g.strokeStyle = col.css, g.lineWidth = Math.max(1, this.size(width)), g.lineJoin = "round";
        g.stroke();
      });
    },

    // ---- words
    fonts: {},
    font(size, style) {
      const own = this.fonts[style];
      if (own) return `${size * this.k}px "${own}"`;
      const look = { regular: "400", medium: "400", semibold: "600", bold: "700", display: "600", mono: "400", "mono bold": "700" }[style] || "400";
      const family = style.startsWith("mono") ? 'Consolas, "Cascadia Mono", monospace' : '"Segoe UI", system-ui, sans-serif';
      return `${look} ${size * this.k}px ${family}`;
    },
    async useFont(style, file, line) {
      if (!this.page) return;
      const name = "fathom " + style;
      try {
        const face = new FontFace(name, `url("${encodeURI(file)}")`);
        document.fonts.add(await face.load());
      } catch {
        fathom.fail(line, `I couldn't read the font '${file}'.`);
      }
      this.fonts[style] = name;
    },
    text(words, x, y, size, style, c, line) {
      this.need(line);
      if (!words) return;
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y);
        g.font = this.font(size, style), g.textBaseline = "alphabetic", g.fillStyle = col.css;
        g.fillText(words, X, Y + g.measureText(words).fontBoundingBoxAscent);  // y is the top of the font's ascender, as directly
      });
    },
    measurer: null,
    textWidth(words, size, style) {
      if (!this.page) return words.length * size * 0.55;  // shortcut: node has no fonts, so this guesses
      this.measurer ||= document.createElement("canvas").getContext("2d");
      this.measurer.font = this.font(size, style);
      return this.measurer.measureText(words).width / this.k;
    },

    // ---- pictures and icons
    pictures: new Map(),
    async picture(file, line) {
      if (this.pictures.has(file)) return this.pictures.get(file);
      let got = null;
      if (this.page) {
        got = await new Promise((resolve) => { const im = new Image(); im.onload = () => resolve(im); im.onerror = () => resolve(null); im.src = file; });
      } else {
        try {
          const b = require("fs").readFileSync(file);
          if (b.readUInt32BE(0) === 0x89504e47) got = { width: b.readUInt32BE(16), height: b.readUInt32BE(20) };
          else if (b.toString("latin1", 0, 3) === "GIF") got = { width: b.readUInt16LE(6), height: b.readUInt16LE(8) };
          else got = { width: 0, height: 0 };  // shortcut: node only reads the sizes of .png and .gif pictures
        } catch {}
      }
      if (!got) fathom.fail(line, `I couldn't open the picture "${file}".`);
      this.pictures.set(file, got);
      return got;
    },
    async drawPicture(file, x, y, w, h, opacity, line) {
      this.need(line);
      const im = await this.picture(file, line);
      this.paint(line, (g, t) => {
        const W = this.size(w), H = this.size(h), [X, Y] = this.px(t, x, y);
        if (W <= 0 || H <= 0) return;
        g.globalAlpha = Math.max(0, Math.min(1, opacity));
        g.drawImage(im, X, Y, W, H);
      });
    },
    icons: new Map(),
    async icon(markup, x, y, size, c, line) {
      this.need(line);
      const col = this.colour(c, line), P = this.size(size);
      if (P <= 0 || !this.page) return;
      const key = markup + "\u0000" + col.css + "\u0000" + P;
      if (!this.icons.has(key)) {
        let svg = markup.replace(/currentColor/g, `rgb(${col[0]},${col[1]},${col[2]})`);
        if (!/xmlns=/.test(svg)) svg = svg.replace(/<svg\b/, '<svg xmlns="http://www.w3.org/2000/svg"');
        svg = svg.replace(/<svg\b([^>]*)>/, (all, attrs) => {
          let a = attrs.replace(/\s(width|height)\s*=\s*['"][^'"]*['"]/g, "");
          if (!/viewBox/.test(a)) a += ' viewBox="0 0 24 24"';
          if (!/\sfill\s*=/.test(a)) a += ' fill="none"';
          if (!/\sstroke\s*=/.test(a)) a += ` stroke="rgb(${col[0]},${col[1]},${col[2]})"`;
          if (!/stroke-width/.test(a)) a += ' stroke-width="1.8"';
          return `<svg${a} width="${P}" height="${P}" stroke-linecap="round" stroke-linejoin="round">`;
        });
        const im = await new Promise((resolve) => { const i = new Image(); i.onload = () => resolve(i); i.onerror = () => resolve(null); i.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg); });
        if (this.icons.size > 600) this.icons.clear();
        this.icons.set(key, im);
      }
      const im = this.icons.get(key);
      if (im) this.paint(line, (g, t) => { const [X, Y] = this.px(t, x, y); g.globalAlpha = col[3] / 255; g.drawImage(im, X, Y, P, P); });
    },

    // ---- glass, shadows, layers and clips
    frosted(x, y, w, h, r, blur, c, line) {
      this.need(line);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y), W = this.size(w), H = this.size(h);
        if (W < 4 || H < 4) return;
        const copy = this.canvas(t.c.width, t.c.height);
        copy.getContext("2d").drawImage(t.c, 0, 0);
        this.rounded(g, X, Y, W, H, this.size(r));
        g.clip();
        g.filter = `blur(${Math.max(0.5, blur * this.k)}px)`;
        g.drawImage(copy, 0, 0);
      });
      this.roundedBox(x, y, w, h, r, c, line);
    },
    shadow(x, y, w, h, r, blur, c, line) {
      const col = this.colour(c, line);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y), W = this.size(w), H = this.size(h), B = Math.max(1, Math.round(blur * this.k));
        g.filter = `blur(${B / 2}px)`;
        g.fillStyle = col.css;
        this.rounded(g, X, Y, W, H, this.size(r));
        g.fill();
      });
    },
    beginLayer(name, w, h, line) {
      this.need(line);
      const c = this.canvas(Math.max(1, this.size(w)), Math.max(1, this.size(h)));
      this.targets.push({ c, g: c && c.getContext("2d"), ox: 0, oy: 0, px: 0, py: 0, name });
    },
    endLayer(line) {
      this.need(line);
      if (this.targets.length < 2 || this.target().name === undefined) fathom.fail(line, "there is no layer to end: start one with 'begin the layer'.");
      const t = this.targets.pop();
      this.layers.set(t.name, t.c);
    },
    putLayer(name, x, y, opacity, grow, line) {
      this.need(line);
      if (!this.layers.has(name)) fathom.fail(line, `there is no layer called "${name}" yet.`);
      const im = this.layers.get(name);
      this.paint(line, (g, t) => {
        const [X, Y] = this.px(t, x, y);
        g.globalAlpha = Math.max(0, Math.min(1, opacity));
        g.drawImage(im, X, Y, Math.max(1, Math.round(im.width * grow)), Math.max(1, Math.round(im.height * grow)));
      });
    },
    beginClip(x, y, w, h, line) {
      this.need(line);
      const parent = this.target(), [X, Y] = this.px(parent, x, y), c = this.canvas(Math.max(1, this.size(w)), Math.max(1, this.size(h)));
      this.targets.push({ c, g: c && c.getContext("2d"), ox: parent.ox + x, oy: parent.oy + y, px: X, py: Y, clip: true });
    },
    endClip(line) {
      this.need(line);
      if (this.targets.length < 2 || !this.target().clip) fathom.fail(line, "there is no clip to end: start one with 'begin clipping'.");
      const t = this.targets.pop();
      this.paint(line, (g) => g.drawImage(t.c, t.px, t.py));
    },
    save(file, line) {
      this.need(line);
      if (!this.screen) return;  // node has no picture of the screen
      const a = document.createElement("a");
      a.href = this.screen.toDataURL("image/png"), a.download = file.replace(/^.*[\\/]/, "");
      a.click();
    },
  };

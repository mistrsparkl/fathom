link: shell32

code:
  namespace stellanova_computer
  {
  	inline std::string environment(const std::string& name)
  	{
  #ifdef _WIN32
  		char* found = nullptr;
  		size_t size = 0;
  		std::string value = _dupenv_s(&found, &size, name.c_str()) == 0 && found ? found : "";
  		std::free(found);
  		return value;
  #else
  		const char* found = std::getenv(name.c_str());
  		return found ? found : "";
  #endif
  	}
  	inline std::string user_name()
  	{
  		std::string name = environment("USERNAME");
  		return name.empty() ? environment("USER") : name;  // (Linux calls it USER)
  	}
  #ifdef _WIN32
  	inline void beep(double pitch, double seconds) { Beep((DWORD)pitch, (DWORD)(1000 * seconds)); }
  	inline double run_command(const std::string& command) { return (double)std::system(command.c_str()); }
  	inline void open_thing(const std::string& thing) { ShellExecuteA(nullptr, "open", thing.c_str(), nullptr, nullptr, SW_SHOWNORMAL); }
  #else
  	inline void beep(double, double seconds)  // a terminal only rings its bell
  	{
  		std::fputs("\a", stdout);
  		std::fflush(stdout);
  		std::this_thread::sleep_for(std::chrono::duration<double>(seconds));
  	}
  	inline double run_command(const std::string& command)
  	{
  		std::fflush(stdout);
  		int status = std::system(command.c_str());
  		return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
  	}
  	inline void open_thing(const std::string& thing)
  	{
  		const char* words[] = {"xdg-open", thing.c_str(), nullptr};
  		pid_t pid;
  		if (posix_spawnp(&pid, "xdg-open", nullptr, nullptr, const_cast<char**>(words), environ) == 0)
  			std::thread([pid] { waitpid(pid, nullptr, 0); }).detach();
  	}
  #endif
  }

python:
  import ctypes
  import time
  LINUX = sys.platform.startswith("linux")
  def beep(pitch, seconds):
      if LINUX:  # a terminal only rings its bell
          sys.stdout.write("\a")
          sys.stdout.flush()
          time.sleep(seconds)
          return
      ctypes.windll.kernel32.Beep(int(pitch), int(seconds * 1000))
  def run_command(command):
      sys.stdout.flush()
      code = subprocess.call(command, shell=True)
      return float(-1 if code < 0 else code)
  def open_thing(thing):
      if LINUX:
          subprocess.Popen(["xdg-open", thing], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
      else:
          os.startfile(thing)

to beep, given pitch (a number) and seconds (a number) = stellanova_computer::beep({pitch}, {seconds})
  runs: beep({pitch}, {seconds})
  web: await stellanova_computer.beep({pitch}, {seconds})
to run the command, given command (text), returning a number = stellanova_computer::run_command({command})
  runs: run_command({command})
  web: stellanova_computer.run({command}, {line})
to open, given thing (text) = stellanova_computer::open_thing({thing})
  runs: open_thing({thing})
  web: stellanova_computer.open({thing})

user name = stellanova_computer::user_name(), text, read only
  runs: os.environ.get("USERNAME") or os.environ.get("USER", "")
  web: stellanova_computer::environment("USERNAME")

include: <cstdio>
include: <filesystem>

code:
  namespace stellanova_computer
  {
  	inline std::string output_of(const std::string& command, int line)
  	{
  		std::fflush(stdout);
  #ifdef _WIN32
  		FILE* pipe = _popen(command.c_str(), "rb");
  #else
  		FILE* pipe = popen(command.c_str(), "r");
  #endif
  		if (!pipe)
  			stellanova::fail(line, "I couldn't run the command \"" + command + "\".");
  		std::string all;
  		char chunk[4096];
  		for (size_t got; (got = std::fread(chunk, 1, sizeof chunk, pipe)) > 0;)
  			all.append(chunk, got);
  #ifdef _WIN32
  		_pclose(pipe);
  #else
  		pclose(pipe);
  #endif
  		std::string tidy;
  		for (char c : all)
  			if (c != '\r')
  				tidy += c;
  		return tidy;
  	}
  	[[noreturn]] inline void end_program(double code)
  	{
  		std::fflush(stdout);
  		std::fflush(stderr);
  		std::_Exit((int)code);
  	}
  }

python:
  def output_of(command):
      sys.stdout.flush()
      done = subprocess.run(command, shell=True, stdout=subprocess.PIPE)  # what it writes as problems shows, as when built
      return done.stdout.decode("utf-8", errors="replace").replace("\r", "")
  def end_program(code):
      sys.stdout.flush()
      sys.stderr.flush()
      os._exit(int(code))

the words given = stellanova::arguments, a list of text, read only
  runs: list(ARGUMENTS)
  web: stellanova_computer::words_given()
current folder = std::filesystem::current_path().string(), text, read only
  runs: os.getcwd()
  web: stellanova_computer::folder()
to output of the command, given command (text), returning text = stellanova_computer::output_of({command}, {line})
  runs: output_of({command})
  web: stellanova_computer.outputOf({command}, {line})
to environment value of, given name (text), returning text = stellanova_computer::environment({name})
  runs: os.environ.get({name}, "")
  web: stellanova_computer::environment({name})
to end the program, given code (a number) = stellanova_computer::end_program({code})
  runs: end_program({code})
  web: stellanova::leave({code})

note: ---- programs running alongside

include: <map>
include: <memory>
include: <mutex>
include: <thread>

code:
  #ifndef _WIN32
  namespace stellanova_computer
  {
  	struct Running
  	{
  		pid_t pid = 0;  // also its process group: stopping it stops what it started too
  		int typing = -1, code = -1;
  		bool ended = false;
  		std::string out, err;
  		bool out_done = false, err_done = false;
  		std::mutex lock;
  	};
  	inline std::map<int, std::shared_ptr<Running>>& programs() { static std::map<int, std::shared_ptr<Running>> all; return all; }
  	inline std::mutex& programs_lock() { static std::mutex m; return m; }
  	inline std::shared_ptr<Running> program(double id, int line)
  	{
  		std::lock_guard<std::mutex> hold(programs_lock());
  		auto it = programs().find((int)id);
  		if (it == programs().end())
  			stellanova::fail(line, "there is no program " + stellanova::text(id) + " (start one with 'start the program').");
  		return it->second;
  	}
  	inline void read_into(int from, std::shared_ptr<Running> r, bool errors)
  	{
  		char chunk[4096];
  		for (ssize_t got; (got = read(from, chunk, sizeof chunk)) > 0;)
  		{
  			std::lock_guard<std::mutex> hold(r->lock);
  			for (ssize_t k = 0; k < got; ++k)
  				if (chunk[k] != '\r')
  					(errors ? r->err : r->out) += chunk[k];
  		}
  		close(from);
  		std::lock_guard<std::mutex> hold(r->lock);
  		(errors ? r->err_done : r->out_done) = true;
  	}
  	inline double start_program(const std::string& command, const std::string& folder, int line)
  	{
  		signal(SIGPIPE, SIG_IGN);  // typing into a program that ended mustn't end this one
  		int out[2], err[2], in[2];
  		if (pipe2(out, O_CLOEXEC) || pipe2(err, O_CLOEXEC) || pipe2(in, O_CLOEXEC))
  			stellanova::fail(line, "I couldn't start the program \"" + command + "\".");
  		posix_spawn_file_actions_t acts;
  		posix_spawn_file_actions_init(&acts);
  		posix_spawn_file_actions_adddup2(&acts, out[1], 1);
  		posix_spawn_file_actions_adddup2(&acts, err[1], 2);
  		posix_spawn_file_actions_adddup2(&acts, in[0], 0);
  		if (!folder.empty())
  			posix_spawn_file_actions_addchdir_np(&acts, folder.c_str());
  		posix_spawnattr_t attr;
  		posix_spawnattr_init(&attr);
  		posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETPGROUP);
  		posix_spawnattr_setpgroup(&attr, 0);
  		const char* words[] = {"/bin/sh", "-c", command.c_str(), nullptr};
  		auto r = std::make_shared<Running>();
  		int bad = posix_spawn(&r->pid, "/bin/sh", &acts, &attr, const_cast<char**>(words), environ);
  		posix_spawn_file_actions_destroy(&acts);
  		posix_spawnattr_destroy(&attr);
  		close(out[1]);
  		close(err[1]);
  		close(in[0]);
  		if (bad)
  		{
  			for (int fd : {out[0], err[0], in[1]})
  				close(fd);
  			stellanova::fail(line, "I couldn't start the program \"" + command + "\".");
  		}
  		r->typing = in[1];
  		std::thread(read_into, out[0], r, false).detach();
  		std::thread(read_into, err[0], r, true).detach();
  		std::lock_guard<std::mutex> hold(programs_lock());
  		static int next = 0;
  		programs()[++next] = r;
  		return next;
  	}
  	inline void check_ended(Running& r)  // (r.lock held)
  	{
  		int status = 0;
  		if (!r.ended && waitpid(r.pid, &status, WNOHANG) == r.pid)
  		{
  			r.ended = true;
  			r.code = WIFEXITED(status) ? WEXITSTATUS(status) : -WTERMSIG(status);  // as Python says it
  		}
  	}
  	inline std::string new_output(double id, bool errors, int line)
  	{
  		auto r = program(id, line);
  		std::lock_guard<std::mutex> hold(r->lock);
  		std::string got;
  		std::swap(got, errors ? r->err : r->out);
  		return got;
  	}
  	inline void type_into(double id, const std::string& words, int line)
  	{
  		auto r = program(id, line);
  		std::string sent = words + "\n";
  		if (r->typing >= 0 && write(r->typing, sent.data(), sent.size()) < 0)
  			return;
  	}
  	inline bool is_running(double id, int line)  // until it has ended and everything it wrote has been read
  	{
  		auto r = program(id, line);
  		std::lock_guard<std::mutex> hold(r->lock);
  		check_ended(*r);
  		return !r->ended || !r->out_done || !r->err_done;
  	}
  	inline double exit_code(double id, int line)
  	{
  		auto r = program(id, line);
  		std::lock_guard<std::mutex> hold(r->lock);
  		check_ended(*r);
  		return r->ended ? r->code : -1;
  	}
  	inline void stop_program(double id, int line)
  	{
  		auto r = program(id, line);
  		kill(-r->pid, SIGKILL);
  	}
  }
  #else
  namespace stellanova_computer
  {
  	struct Running
  	{
  		HANDLE process = nullptr, job = nullptr, typing = nullptr;
  		std::string out, err;
  		bool out_done = false, err_done = false;
  		std::mutex lock;
  	};
  	inline std::map<int, std::shared_ptr<Running>>& programs() { static std::map<int, std::shared_ptr<Running>> all; return all; }
  	inline std::mutex& programs_lock() { static std::mutex m; return m; }
  	inline std::shared_ptr<Running> program(double id, int line)
  	{
  		std::lock_guard<std::mutex> hold(programs_lock());
  		auto it = programs().find((int)id);
  		if (it == programs().end())
  			stellanova::fail(line, "there is no program " + stellanova::text(id) + " (start one with 'start the program').");
  		return it->second;
  	}
  	inline void read_into(HANDLE from, std::shared_ptr<Running> r, bool errors)
  	{
  		char chunk[4096];
  		DWORD got = 0;
  		while (ReadFile(from, chunk, sizeof chunk, &got, nullptr) && got > 0)
  		{
  			std::lock_guard<std::mutex> hold(r->lock);
  			for (DWORD k = 0; k < got; ++k)
  				if (chunk[k] != '\r')
  					(errors ? r->err : r->out) += chunk[k];
  		}
  		CloseHandle(from);
  		std::lock_guard<std::mutex> hold(r->lock);
  		(errors ? r->err_done : r->out_done) = true;
  	}
  	inline double start_program(const std::string& command, const std::string& folder, int line)
  	{
  		SECURITY_ATTRIBUTES shared{sizeof shared, nullptr, TRUE};
  		HANDLE out_read, out_write, err_read, err_write, in_read, in_write;
  		if (!CreatePipe(&out_read, &out_write, &shared, 0) || !CreatePipe(&err_read, &err_write, &shared, 0) || !CreatePipe(&in_read, &in_write, &shared, 0))
  			stellanova::fail(line, "I couldn't start the program \"" + command + "\".");
  		for (HANDLE own : {out_read, err_read, in_write})  // the program gets only its own ends
  			SetHandleInformation(own, HANDLE_FLAG_INHERIT, 0);
  		STARTUPINFOA start{};
  		start.cb = sizeof start;
  		start.dwFlags = STARTF_USESTDHANDLES;
  		start.hStdOutput = out_write;
  		start.hStdError = err_write;
  		start.hStdInput = in_read;
  		PROCESS_INFORMATION made{};
  		std::string line_ = command;
  		auto r = std::make_shared<Running>();
  		r->job = CreateJobObjectA(nullptr, nullptr);  // so stopping it stops what it started too
  		JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits{};
  		limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
  		SetInformationJobObject(r->job, JobObjectExtendedLimitInformation, &limits, sizeof limits);
  		bool ok = CreateProcessA(nullptr, line_.data(), nullptr, nullptr, TRUE, CREATE_NO_WINDOW | CREATE_SUSPENDED, nullptr,
  			folder.empty() ? nullptr : folder.c_str(), &start, &made);
  		CloseHandle(out_write);
  		CloseHandle(err_write);
  		CloseHandle(in_read);
  		if (!ok)
  		{
  			for (HANDLE h : {out_read, err_read, in_write, r->job})
  				CloseHandle(h);
  			stellanova::fail(line, "I couldn't start the program \"" + command + "\".");
  		}
  		AssignProcessToJobObject(r->job, made.hProcess);
  		ResumeThread(made.hThread);
  		CloseHandle(made.hThread);
  		r->process = made.hProcess;
  		r->typing = in_write;
  		std::thread(read_into, out_read, r, false).detach();
  		std::thread(read_into, err_read, r, true).detach();
  		std::lock_guard<std::mutex> hold(programs_lock());
  		static int next = 0;
  		programs()[++next] = r;
  		return next;
  	}
  	inline std::string new_output(double id, bool errors, int line)
  	{
  		auto r = program(id, line);
  		std::lock_guard<std::mutex> hold(r->lock);
  		std::string got;
  		std::swap(got, errors ? r->err : r->out);
  		return got;
  	}
  	inline void type_into(double id, const std::string& words, int line)
  	{
  		auto r = program(id, line);
  		std::string sent = words + "\n";
  		DWORD put = 0;
  		if (r->typing)
  			WriteFile(r->typing, sent.data(), (DWORD)sent.size(), &put, nullptr);
  	}
  	inline bool is_running(double id, int line)  // until it has ended and everything it wrote has been read
  	{
  		auto r = program(id, line);
  		std::lock_guard<std::mutex> hold(r->lock);
  		return WaitForSingleObject(r->process, 0) == WAIT_TIMEOUT || !r->out_done || !r->err_done;
  	}
  	inline double exit_code(double id, int line)
  	{
  		auto r = program(id, line);
  		DWORD code = 0;
  		GetExitCodeProcess(r->process, &code);
  		return code == STILL_ACTIVE ? -1 : (double)code;
  	}
  	inline void stop_program(double id, int line)
  	{
  		auto r = program(id, line);
  		TerminateJobObject(r->job, 1);
  	}
  }
  #endif

python:
  import threading
  RUNNING = {}
  def start_program(command, folder):
      sys.stdout.flush()
      try:
          p = subprocess.Popen(command, cwd=folder or None, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0), shell=LINUX, start_new_session=LINUX)
      except OSError:
          raise RunError(0, "I couldn't start the program \"" + command + "\".")
      r = {"p": p, "out": [], "err": [], "lock": threading.Lock()}
      def read(stream, key):
          for piece in iter(lambda: stream.read1(4096), b""):
              with r["lock"]:
                  r[key].append(piece)
      r["readers"] = [threading.Thread(target=read, args=(p.stdout, "out"), daemon=True), threading.Thread(target=read, args=(p.stderr, "err"), daemon=True)]
      for t in r["readers"]:
          t.start()
      RUNNING[len(RUNNING) + 1] = r
      return float(len(RUNNING))
  def running_program(n):
      if n not in RUNNING:
          raise RunError(0, "there is no program " + text(n) + " (start one with 'start the program').")
      return RUNNING[n]
  def new_output(n, key):
      r = running_program(n)
      with r["lock"]:
          got, r[key] = b"".join(r[key]), []
      return got.decode("utf-8", errors="replace").replace("\r", "")
  def type_into(n, words):
      r = running_program(n)
      try:
          r["p"].stdin.write((words + "\n").encode("utf-8"))
          r["p"].stdin.flush()
      except OSError:
          pass
  def program_running(n):
      r = running_program(n)
      return r["p"].poll() is None or any(t.is_alive() for t in r["readers"])
  def exit_code(n):
      code = running_program(n)["p"].poll()
      return -1.0 if code is None else float(code)
  def stop_program(n):
      p = running_program(n)["p"]
      if LINUX:  # its process group: what it started stops too
          try:
              os.killpg(p.pid, 9)
          except OSError:
              pass
          return
      subprocess.call(["taskkill", "/T", "/F", "/PID", str(p.pid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

to start the program, given command (text) and folder (text), returning a number = stellanova_computer::start_program({command}, {folder}, {line})
  runs: start_program({command}, {folder})
  web: stellanova_computer.start({command}, {folder}, {line})
to latest output of the program, given program (a number), returning text = stellanova_computer::new_output({program}, false, {line})
  runs: new_output({program}, "out")
  web: stellanova_computer.latest({program}, "out", {line})
to latest errors of the program, given program (a number), returning text = stellanova_computer::new_output({program}, true, {line})
  runs: new_output({program}, "err")
  web: stellanova_computer.latest({program}, "err", {line})
to type into the program, given program (a number) and words (text) = stellanova_computer::type_into({program}, {words}, {line})
  runs: type_into({program}, {words})
  web: stellanova_computer.typeInto({program}, {words}, {line})
to the program is running, given program (a number), returning yes or no = stellanova_computer::is_running({program}, {line})
  runs: program_running({program})
  web: await stellanova_computer.isRunning({program}, {line})
to exit code of the program, given program (a number), returning a number = stellanova_computer::exit_code({program}, {line})
  runs: exit_code({program})
  web: stellanova_computer.exitCode({program}, {line})
to stop the program, given program (a number) = stellanova_computer::stop_program({program}, {line})
  runs: stop_program({program})
  web: stellanova_computer.stop({program}, {line})

javascript:
  const stellanova_computer = {
    node: typeof process !== "undefined" && !!(process.versions && process.versions.node),
    environment: (name) => (stellanova_computer.node ? process.env[name] || "" : ""),
    words_given: () => (stellanova_computer.node ? process.argv.slice(2) : []),
    folder: () => (stellanova_computer.node ? process.cwd() : ""),
    need(line) {
      if (!this.node) stellanova.fail(line, "a web page can't run programs on the computer (this works with node).");
      return require("child_process");
    },
    async beep(pitch, seconds) {
      if (!this.node) {  // a web page: a short square wave
        const a = new AudioContext(), o = a.createOscillator();
        o.type = "square", o.frequency.value = pitch;
        o.connect(a.destination), o.start(), o.stop(a.currentTime + seconds);
        await new Promise((r) => setTimeout(r, seconds * 1000));
        return;
      }
      require("child_process").spawnSync("powershell", ["-NoProfile", "-Command", `[console]::beep(${Math.round(pitch)}, ${Math.round(seconds * 1000)})`], { windowsHide: true });
    },
    run(command, line) {
      const done = this.need(line).spawnSync(command, { shell: true, stdio: "inherit" });
      return done.status === null ? -1 : done.status;
    },
    open(thing) {
      if (!this.node) return void window.open(thing, "_blank");
      require("child_process").spawn("cmd", ["/c", "start", "", thing], { detached: true, stdio: "ignore", windowsHide: true }).unref();
    },
    outputOf(command, line) {  // what it writes as problems shows, as when built
      const done = this.need(line).spawnSync(command, { shell: true, stdio: ["inherit", "pipe", "inherit"] });
      return (done.stdout || Buffer.alloc(0)).toString("utf8").replace(/\r/g, "");
    },
    running: [],
    start(command, folder, line) {
      const cp = this.need(line);
      let p;
      try {
        p = cp.spawn(command, { cwd: folder || undefined, shell: true, windowsHide: true });
      } catch {
        stellanova.fail(line, `I couldn't start the program "${command}".`);
      }
      const r = { p, out: [], err: [], open: 2, code: null };
      p.stdout.on("data", (d) => r.out.push(d));
      p.stderr.on("data", (d) => r.err.push(d));
      p.stdout.on("close", () => r.open--);
      p.stderr.on("close", () => r.open--);
      p.on("exit", (code) => (r.code = code === null ? 1 : code));
      p.on("error", () => { r.code = 1; r.open = 0; });
      p.stdin.on("error", () => {});
      this.running.push(r);
      return this.running.length;
    },
    get(n, line) {
      const r = this.running[n - 1];
      if (!r) stellanova.fail(line, `there is no program ${stellanova.text(n)} (start one with 'start the program').`);
      return r;
    },
    latest(n, key, line) {
      const r = this.get(n, line), got = Buffer.concat(r[key]);
      r[key] = [];
      return got.toString("utf8").replace(/\r/g, "");
    },
    typeInto(n, words, line) {
      const r = this.get(n, line);
      if (r.p.stdin.writable) r.p.stdin.write(words + "\n");
    },
    async isRunning(n, line) {
      const r = this.get(n, line);
      await new Promise((done) => setImmediate(done));  // lets its output and its end arrive
      return r.code === null || r.open > 0;
    },
    exitCode(n, line) {
      const r = this.get(n, line);
      return r.code === null ? -1 : r.code;
    },
    stop(n, line) {
      const r = this.get(n, line);
      this.need(line).spawnSync("taskkill", ["/T", "/F", "/PID", String(r.p.pid)], { stdio: "ignore" });
    },
  };

  import tkinter
  COLOURS = {"black": "#000000", "white": "#ffffff", "red": "#dc2828", "green": "#28b446", "blue": "#325ae6",
             "yellow": "#f5d228", "orange": "#f58c1e", "purple": "#8c3cc8", "pink": "#f078b4", "brown": "#825028",
             "grey": "#808080", "gray": "#808080"}
  KEYS = {"left", "right", "up", "down", "space", "enter", "escape", "shift", "control", "tab", "backspace"}
  TK_KEYS = {"return": "enter", "shift_l": "shift", "shift_r": "shift", "control_l": "control", "control_r": "control"}
  win = {"root": None, "open": False, "opened": False, "pressed": set(), "clicked": False, "held": set(), "mouse": (0.0, 0.0), "down": False, "last": 0.0, "text size": 16, "frame time": 1.0 / 60}

  def need_window():
      if not win["opened"]:
          raise RunError(0, 'there is no window yet. Open one first, like: open a world with "My game", 800, 600')
      flush3d()

  def colour(name):
      low = name.lower()
      if low in COLOURS:
          return COLOURS[low]
      if len(low) == 7 and low[0] == "#" and all(c in "0123456789abcdef" for c in low[1:]):
          return low
      raise RunError(0, f'I don\'t know the colour "{name}". Use a name like "red" or a code like "#ff8800".')

  def key_name(name):
      k = name.lower()
      if (len(k) == 1 and (("a" <= k <= "z") or ("0" <= k <= "9"))) or k in KEYS:
          return k
      raise RunError(0, f'I don\'t know the key "{name}". Keys are letters, digits, left, right, up, down, space, enter, escape, shift, control, tab and backspace.')

  def closed():
      win["open"] = False
      pictures.clear()
      if win["root"] is not None:
          win["root"].destroy()
      win["root"] = None

  def pump():
      if win["root"] is not None:
          try:
              win["root"].update()
          except tkinter.TclError:
              win["root"], win["open"] = None, False

  def open_window(title, w, h):
      if win["root"] is not None:
          raise RunError(0, "a window is already open.")
      if w < 1 or h < 1 or w > 10000 or h > 10000:
          raise RunError(0, "a window must be from 1 to 10000 dots wide and high.")
      root = tkinter._default_root or tkinter.Tk()  # a hidden one may exist already, for picture sizes
      root.deiconify()
      root.title(title)
      root.resizable(False, False)
      canvas = tkinter.Canvas(root, width=int(w), height=int(h), highlightthickness=0, bd=0, bg="#000000")
      canvas.pack()
      held = win["held"]
      held.clear()
      root.protocol("WM_DELETE_WINDOW", closed)
      def down(e):
          k = TK_KEYS.get(e.keysym.lower(), e.keysym.lower())
          if k not in held:  # not the repeats a held key sends
              win["fresh"].add(k)
          held.add(k)
      root.bind("<KeyPress>", down)
      root.bind("<KeyRelease>", lambda e: held.discard(TK_KEYS.get(e.keysym.lower(), e.keysym.lower())))
      root.bind("<FocusOut>", lambda e: (held.clear(), win.update(down=False)))
      canvas.bind("<Motion>", lambda e: win.update(mouse=(float(e.x), float(e.y))))
      canvas.bind("<B1-Motion>", lambda e: win.update(mouse=(float(e.x), float(e.y))))
      canvas.bind("<ButtonPress-1>", lambda e: win.update(down=True, click_fresh=True))
      canvas.bind("<ButtonRelease-1>", lambda e: win.update(down=False))
      win.update(root=root, canvas=canvas, open=True, opened=True, size=(int(w), int(h)), last=time.monotonic(),
                 fresh=set(), pressed=set(), click_fresh=False, clicked=False)
      root.focus_force()
      pump()

  def draw(make):
      need_window()
      if win["root"] is not None:
          make(win["canvas"])

  def clear(c):
      col = colour(c)
      def make(cv):
          cv.delete("all")
          cv.create_rectangle(0, 0, win["size"][0], win["size"][1], fill=col, outline="")
      draw(make)

  def box(x, y, w, h, c):
      col = colour(c)
      draw(lambda cv: cv.create_rectangle(round(x), round(y), round(x + w), round(y + h), fill=col, outline=""))

  def circle(x, y, r, c):
      col = colour(c)
      draw(lambda cv: cv.create_oval(round(x - r), round(y - r), round(x + r), round(y + r), fill=col, outline=col))

  def line_between(x1, y1, x2, y2, c):
      col = colour(c)
      draw(lambda cv: cv.create_line(round(x1), round(y1), round(x2), round(y2), fill=col, width=2))

  def write(words, x, y, c):
      col = colour(c)
      size = win["text size"]
      draw(lambda cv: cv.create_text(round(x), round(y), text=words, fill=col, anchor="nw", font=("Segoe UI", -size)))

  def set_text_size(size):
      if not 1 <= size <= 500:
          raise RunError(0, f"text can be from 1 to 500 dots high, not {text(size)}.")
      win["text size"] = int(math.floor(size + 0.5))

  def show():
      need_window()
      pump()
      win["pressed"], win["fresh"] = win["fresh"], set()
      win["clicked"], win["click_fresh"] = win["click_fresh"], False
      wait = 1.0 / 60 - (time.monotonic() - win["last"])
      if wait > 0:
          time.sleep(wait)
      now = time.monotonic()
      win["frame time"], win["last"] = now - win["last"], now

  pictures = {}

  def picture(file):
      if file not in pictures:
          if not os.path.isfile(file):
              raise RunError(0, f'there is no picture called "{file}".')
          try:
              pictures[file] = tkinter.PhotoImage(file=file)
          except tkinter.TclError:
              raise RunError(0, f'I couldn\'t read the picture "{file}" (use .png or .gif).')
      return pictures[file]

  def size_of_picture(file, which):
      if not tkinter._default_root:
          tkinter.Tk().withdraw()  # PhotoImage needs Tk running, even before a window is open
      image = picture(file)
      return float(image.width() if which == 0 else image.height())

  def draw_picture(file, x, y):
      need_window()
      image = picture(file)
      draw(lambda cv: cv.create_image(round(x), round(y), image=image, anchor="nw"))

  turned = {}

  def draw_picture_turned(file, x, y, size, angle):
      need_window()
      if not 0 < size <= 100:
          raise RunError(0, f"a picture's size must be more than 0 and at most 100, not {text(size)}.")
      picture(file)
      if win["root"] is None:
          return
      key = (file, round(size, 3), round(angle % 360, 1))
      if key not in turned:
          try:
              from PIL import Image, ImageTk
          except ImportError:
              raise RunError(0, "turning pictures needs Pillow when running directly. Type: py -3 -m pip install pillow"
                                " (or build the program, which doesn't need it).")
          if len(turned) > 500:  # shortcut: forget them all rather than track which are still used
              turned.clear()
          im = Image.open(file).convert("RGBA")
          im = im.resize((max(1, round(im.width * size)), max(1, round(im.height * size))), Image.BICUBIC)
          turned[key] = ImageTk.PhotoImage(im.rotate(-angle, resample=Image.BICUBIC, expand=True))
      image = turned[key]
      draw(lambda cv: cv.create_image(round(x), round(y), image=image, anchor="center"))

  def close():
      if win["root"] is not None:
          closed()

python:
  EYE = {"x": 0.0, "y": 1.5, "z": -6.0, "turn": 0.0, "tilt": 0.0}
  SHAPES3 = []
  NEAR3 = 0.05
  PI3 = 3.14159265358979323846

  def need_open():
      if not win["opened"]:
          raise RunError(0, 'there is no window yet. Open one first, like: open a world with "My game", 800, 600')

  def focal():
      return (win["size"][1] / 2.0) / math.tan(30.0 * PI3 / 180.0)

  def view(p):
      dx, dy, dz = p[0] - EYE["x"], p[1] - EYE["y"], p[2] - EYE["z"]
      t, a = EYE["turn"] * PI3 / 180.0, EYE["tilt"] * PI3 / 180.0
      x1, z1 = dx * math.cos(t) - dz * math.sin(t), dx * math.sin(t) + dz * math.cos(t)
      return (x1, dy * math.cos(a) - z1 * math.sin(a), dy * math.sin(a) + z1 * math.cos(a))

  def rgb(col):
      return int(col[1:3], 16), int(col[3:5], 16), int(col[5:7], 16)

  def shade(col, k):
      return "#%02x%02x%02x" % tuple(int(math.floor(min(255.0, max(0.0, v * k)) + 0.5)) for v in rgb(col))

  def lighter(col):
      return "#%02x%02x%02x" % tuple((v + 255) // 2 for v in rgb(col))

  def polygon3(world, col, far_first=0.0):
      cam = [view(w) for w in world]
      out = []
      for k in range(len(cam)):
          a, b = cam[k], cam[(k + 1) % len(cam)]
          ia, ib = a[2] >= NEAR3, b[2] >= NEAR3
          if ia:
              out.append(a)
          if ia != ib:
              s = (NEAR3 - a[2]) / (b[2] - a[2])
              out.append((a[0] + (b[0] - a[0]) * s, a[1] + (b[1] - a[1]) * s, NEAR3))
      if len(out) < 3:
          return
      f, w, h = focal(), win["size"][0], win["size"][1]
      points = []
      for v in out:
          points += [w / 2.0 + v[0] * f / v[2], h / 2.0 - v[1] * f / v[2]]
      SHAPES3.append((sum(v[2] for v in out) / len(out) + far_first, False, points, col))

  def flush3d():
      if not SHAPES3:
          return
      SHAPES3.sort(key=lambda s: -s[0])  # far ones first (sort keeps the order of equal ones, as the C++ does)
      cv = win.get("canvas") if win["root"] is not None else None
      if cv is not None:
          for depth, is_round, points, col in SHAPES3:
              if is_round:
                  x, y, r = points
                  cv.create_oval(x - r, y - r, x + r, y + r, fill=col, outline=col)
              else:
                  cv.create_polygon(points, fill=col, outline=col)
      SHAPES3.clear()

  def place_eye(p):
      EYE["x"], EYE["y"], EYE["z"] = p.parts()[:3]

  def aim_eye(turn, tilt):
      EYE["turn"], EYE["tilt"] = turn, max(-89.0, min(89.0, tilt))

  def screen_place(p):
      need_open()
      v = view(p.parts())
      if v[2] < NEAR3:
          return Place(math.nan, math.nan)
      f = focal()
      return Place(win["size"][0] / 2.0 + v[0] * f / v[2], win["size"][1] / 2.0 - v[1] * f / v[2])

  def block(middle, w, h, d, c):
      need_open()
      if not (w > 0 and h > 0 and d > 0):
          raise RunError(0, "a block's width, height and depth must all be more than 0.")
      col = colour(c)
      mx, my, mz = middle.parts()[:3]
      x0, x1, y0, y1, z0, z1 = mx - w / 2, mx + w / 2, my - h / 2, my + h / 2, mz - d / 2, mz + d / 2
      faces = [((0, 0, -1), (x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0)),
               ((0, 0, 1), (x1, y0, z1), (x0, y0, z1), (x0, y1, z1), (x1, y1, z1)),
               ((-1, 0, 0), (x0, y0, z1), (x0, y0, z0), (x0, y1, z0), (x0, y1, z1)),
               ((1, 0, 0), (x1, y0, z0), (x1, y0, z1), (x1, y1, z1), (x1, y1, z0)),
               ((0, 1, 0), (x0, y1, z0), (x1, y1, z0), (x1, y1, z1), (x0, y1, z1)),
               ((0, -1, 0), (x0, y0, z1), (x1, y0, z1), (x1, y0, z0), (x0, y0, z0))]
      for n, a, b, c_, d_ in faces:
          cx, cy, cz = (a[0] + c_[0]) / 2, (a[1] + c_[1]) / 2, (a[2] + c_[2]) / 2
          if n[0] * (EYE["x"] - cx) + n[1] * (EYE["y"] - cy) + n[2] * (EYE["z"] - cz) <= 0:
              continue
          lit = n[0] * 0.371 + n[1] * 0.743 - n[2] * 0.557
          polygon3([a, b, c_, d_], shade(col, 0.6 + 0.4 * max(0.0, lit)))

  def ball(middle, radius, c):
      need_open()
      if not radius > 0:
          raise RunError(0, "a ball's radius must be more than 0.")
      col = colour(c)
      v = view(middle.parts())
      if v[2] < NEAR3:
          return
      f, w, h = focal(), win["size"][0], win["size"][1]
      x, y = w / 2.0 + v[0] * f / v[2], h / 2.0 - v[1] * f / v[2]
      r = max(1.0, radius * f / v[2])
      SHAPES3.append((v[2], True, (x, y, r), col))
      SHAPES3.append((v[2] - 1e-9, True, (x - r * 0.35, y - r * 0.35, max(1.0, r * 0.3)), lighter(col)))

  def ground(a, b):
      need_open()
      ca, cb = colour(a), colour(b)
      size, reach = 2.0, 12
      cx, cz = int(math.floor(EYE["x"] / size)), int(math.floor(EYE["z"] / size))
      for i in range(cx - reach, cx + reach):
          for j in range(cz - reach, cz + reach):
              polygon3([(i * size, 0.0, j * size), ((i + 1) * size, 0.0, j * size), ((i + 1) * size, 0.0, (j + 1) * size),
                        (i * size, 0.0, (j + 1) * size)], cb if (i + j) & 1 else ca, 1e9)

to open a world, given title (text) and width (a number) and height (a number) = imagine_window::open({title}, {width}, {height}, {line})
  runs: open_window({title}, {width}, {height})
to consume the window, given colour (text) = imagine_window::clear({colour}, {line})
  runs: clear({colour})
to etch a box, given x (a number) and y (a number) and width (a number) and height (a number) and colour (text) = imagine_window::box({x}, {y}, {width}, {height}, {colour}, {line})
  runs: box({x}, {y}, {width}, {height}, {colour})
to etch a square, given x (a number) and y (a number) and radius (a number) and colour (text) = imagine_window::box(({x}) - ({radius}), ({y}) - ({radius}), 2 * ({radius}), 2 * ({radius}), {colour}, {line})
  runs: box({x} - {radius}, {y} - {radius}, 2 * {radius}, 2 * {radius}, {colour})
to etch a circle, given x (a number) and y (a number) and radius (a number) and colour (text) = imagine_window::circle({x}, {y}, {radius}, {colour}, {line})
  runs: circle({x}, {y}, {radius}, {colour})
to etch a line, given x (a number) and y (a number) and to x (a number) and to y (a number) and colour (text) = imagine_window::line_between({x}, {y}, {to x}, {to y}, {colour}, {line})
  runs: line_between({x}, {y}, {to x}, {to y}, {colour})
to etch words, given words (text) and x (a number) and y (a number) and colour (text) = imagine_window::write({words}, {x}, {y}, {colour}, {line})
  runs: write({words}, {x}, {y}, {colour})
to set the text size to, given size (a number) = imagine_window::set_text_size({size}, {line})
  runs: set_text_size({size})
to reveal the frame = imagine_window::show({line})
  runs: show()
to etch the picture, given file (text) and x (a number) and y (a number) = imagine_window::draw_picture({file}, {x}, {y}, {line})
  runs: draw_picture({file}, {x}, {y})
to etch the picture turned, given file (text) and x (a number) and y (a number) and size (a number) and angle (a number) = imagine_window::draw_picture_turned({file}, {x}, {y}, {size}, {angle}, {line})
  runs: draw_picture_turned({file}, {x}, {y}, {size}, {angle})
to width of picture, given file (text), giving back a number = (double)imagine_window::picture({file}, {line})->GetWidth()
  runs: size_of_picture({file}, 0)
to height of picture, given file (text), giving back a number = (double)imagine_window::picture({file}, {line})->GetHeight()
  runs: size_of_picture({file}, 1)
to end the world = imagine_window::close()
  runs: close()
to key held, given key (text), giving back yes or no = (imagine_window::keys[imagine_window::key_code({key}, {line})])
  runs: key_name({key}) in win["held"]

the world lives = imagine_window::open_now, yes or no, read only
  runs: win["open"]
width of the world = (double)imagine_window::width, number, read only
  runs: float(win.get("size", (0, 0))[0])
height of the world = (double)imagine_window::height, number, read only
  runs: float(win.get("size", (0, 0))[1])
mouse x = imagine_window::mouse_x_now, number, read only
  runs: win["mouse"][0]
mouse y = imagine_window::mouse_y_now, number, read only
  runs: win["mouse"][1]
to key pressed, given key (text), giving back yes or no = (imagine_window::pressed[imagine_window::key_code({key}, {line})])
  runs: key_name({key}) in win["pressed"]
mouse clicked = imagine_window::clicked, yes or no, read only
  runs: win["clicked"]
frame time = imagine_window::frame_time, number, read only
  runs: win["frame time"]
mouse held = imagine_window::mouse_down, yes or no, read only
  runs: win["down"]

note: 3D. The eye is where the picture is seen from. Across is horizontal, up is vertical (more is higher), away is depth.
to place the eye at, given where (a place) = imagine_window::place_eye({where})
  runs: place_eye({where})
to aim the eye, given turn (a number) and tilt (a number) = imagine_window::aim_eye({turn}, {tilt})
  runs: aim_eye({turn}, {tilt})
to screen place of, given where (a place), giving back a flat place = (imagine_window::need_open({line}), imagine_window::screen_place({where}))
  runs: screen_place({where})
to etch a block, given middle (a place) and width (a number) and height (a number) and depth (a number) and colour (text) = imagine_window::block({middle}, {width}, {height}, {depth}, {colour}, {line})
  runs: block({middle}, {width}, {height}, {depth}, {colour})
to etch a cube, given middle (a place) and size (a number) and colour (text) = imagine_window::cube({middle}, {size}, {colour}, {line})
  runs: (lambda s: block({middle}, s, s, s, {colour}))({size})
to etch a ball, given middle (a place) and radius (a number) and colour (text) = imagine_window::ball({middle}, {radius}, {colour}, {line})
  runs: ball({middle}, {radius}, {colour})
to etch the ground, given colour (text) and other colour (text) = imagine_window::ground({colour}, {other colour}, {line})
  runs: ground({colour}, {other colour})

note: A window to draw in, for games and pictures. Use it in a program with:  use: window
note: Places in the window are counted in dots (pixels) from its top left corner: x goes right, y goes down.
note: Colours are names (black, white, red, green, blue, yellow, orange, purple, pink, brown, grey) or "#rrggbb".
note: Built programs draw with Windows' own drawing (GDI); programs run directly draw with Tkinter.

code:
  #define NOMINMAX
include: <windows.h>
link: user32
link: gdi32
code:
  #include <objidl.h>
  namespace Gdiplus { using std::min; using std::max; }
include: <gdiplus.h>
link: gdiplus

code:
  namespace imagine_window
  {
  	inline HWND window = nullptr;
  	inline HDC canvas = nullptr;
  	inline HFONT font = nullptr;
  	inline int text_size = 16;
  	inline double frame_time = 1.0 / 60;  // seconds the last frame took
  	inline bool open_now = false;
  	inline bool opened = false;
  	inline bool keys[256] = {};
  	inline bool fresh[256] = {}, pressed[256] = {};
  	inline bool click_fresh = false, clicked = false;
  	inline bool mouse_down = false;
  	inline double mouse_x_now = 0, mouse_y_now = 0;
  	inline int width = 0, height = 0;
  	inline LARGE_INTEGER last_frame{};

  	inline std::wstring wide(const std::string& s)
  	{
  		std::wstring out(MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0), L'\0');
  		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), out.data(), (int)out.size());
  		return out;
  	}

  	inline void need_window(int line)
  	{
  		if (!opened)
  			imagine::fail(line, "there is no window yet. Open one first, like: open a world with \"My game\", 800, 600");
  	}

  	inline COLORREF colour(const std::string& name, int line)
  	{
  		static const std::pair<const char*, COLORREF> named[] = {
  			{"black", RGB(0, 0, 0)}, {"white", RGB(255, 255, 255)}, {"red", RGB(220, 40, 40)}, {"green", RGB(40, 180, 70)},
  			{"blue", RGB(50, 90, 230)}, {"yellow", RGB(245, 210, 40)}, {"orange", RGB(245, 140, 30)},
  			{"purple", RGB(140, 60, 200)}, {"pink", RGB(240, 120, 180)}, {"brown", RGB(130, 80, 40)},
  			{"grey", RGB(128, 128, 128)}, {"gray", RGB(128, 128, 128)}};
  		std::string low = imagine::lower(name);
  		for (const auto& [key, value] : named)
  			if (low == key) return value;
  		if (low.size() == 7 && low[0] == '#' && low.find_first_not_of("0123456789abcdef", 1) == std::string::npos)
  		{
  			unsigned long v = std::stoul(low.substr(1), nullptr, 16);
  			return RGB((v >> 16) & 255, (v >> 8) & 255, v & 255);
  		}
  		imagine::fail(line, "I don't know the colour \"" + name + "\". Use a name like \"red\" or a code like \"#ff8800\".");
  	}

  	inline int key_code(const std::string& name, int line)
  	{
  		std::string k = imagine::lower(name);
  		if (k.size() == 1 && ((k[0] >= 'a' && k[0] <= 'z') || (k[0] >= '0' && k[0] <= '9')))
  			return std::toupper((unsigned char)k[0]);
  		static const std::pair<const char*, int> named[] = {
  			{"left", VK_LEFT}, {"right", VK_RIGHT}, {"up", VK_UP}, {"down", VK_DOWN}, {"space", VK_SPACE},
  			{"enter", VK_RETURN}, {"escape", VK_ESCAPE}, {"shift", VK_SHIFT}, {"control", VK_CONTROL},
  			{"tab", VK_TAB}, {"backspace", VK_BACK}};
  		for (const auto& [key, value] : named)
  			if (k == key) return value;
  		imagine::fail(line, "I don't know the key \"" + name + "\". Keys are letters, digits, left, right, up, down, space, enter, escape, shift, control, tab and backspace.");
  	}

  	inline LRESULT CALLBACK on_message(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
  	{
  		switch (msg)
  		{
  		case WM_CLOSE: open_now = false; DestroyWindow(hwnd); window = nullptr; return 0;
  		case WM_KEYDOWN: case WM_SYSKEYDOWN: if (!(lp & (1 << 30))) fresh[wp & 255] = true; keys[wp & 255] = true; return 0;
  		case WM_KEYUP: case WM_SYSKEYUP: keys[wp & 255] = false; return 0;
  		case WM_KILLFOCUS: for (bool& k : keys) k = false; mouse_down = false; return 0;
  		case WM_MOUSEMOVE: mouse_x_now = (short)LOWORD(lp); mouse_y_now = (short)HIWORD(lp); return 0;
  		case WM_LBUTTONDOWN: mouse_down = click_fresh = true; SetCapture(hwnd); return 0;
  		case WM_LBUTTONUP: mouse_down = false; ReleaseCapture(); return 0;
  		case WM_PAINT:
  		{
  			PAINTSTRUCT ps;
  			HDC dc = BeginPaint(hwnd, &ps);
  			BitBlt(dc, 0, 0, width, height, canvas, 0, 0, SRCCOPY);
  			EndPaint(hwnd, &ps);
  			return 0;
  		}
  		}
  		return DefWindowProcW(hwnd, msg, wp, lp);
  	}

  	inline void pump()
  	{
  		MSG m;
  		while (PeekMessageW(&m, nullptr, 0, 0, PM_REMOVE))
  		{
  			TranslateMessage(&m);
  			DispatchMessageW(&m);
  		}
  	}

  	inline void open(const std::string& title, double w, double h, int line)
  	{
  		if (window)
  			imagine::fail(line, "a window is already open.");
  		if (w < 1 || h < 1 || w > 10000 || h > 10000)
  			imagine::fail(line, "a window must be from 1 to 10000 dots wide and high.");
  		width = (int)w; height = (int)h;
  		WNDCLASSW wc{};
  		wc.lpfnWndProc = on_message;
  		wc.hInstance = GetModuleHandleW(nullptr);
  		wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
  		wc.lpszClassName = L"ImaginationWindow";
  		RegisterClassW(&wc);
  		DWORD style = WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX;
  		RECT r{0, 0, width, height};
  		AdjustWindowRect(&r, style, FALSE);
  		window = CreateWindowW(L"ImaginationWindow", wide(title).c_str(), style, CW_USEDEFAULT, CW_USEDEFAULT,
  			r.right - r.left, r.bottom - r.top, nullptr, nullptr, wc.hInstance, nullptr);
  		HDC dc = GetDC(window);
  		canvas = CreateCompatibleDC(dc);
  		SelectObject(canvas, CreateCompatibleBitmap(dc, width, height));
  		ReleaseDC(window, dc);
  		font = CreateFontW(-text_size, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, CLEARTYPE_QUALITY, 0, L"Segoe UI");
  		SelectObject(canvas, font);
  		SetBkMode(canvas, TRANSPARENT);
  		RECT all{0, 0, width, height};
  		FillRect(canvas, &all, (HBRUSH)GetStockObject(BLACK_BRUSH));
  		open_now = opened = true;
  		ShowWindow(window, SW_SHOW);
  		pump();
  		QueryPerformanceCounter(&last_frame);
  	}

  	inline void clear(const std::string& c, int line)
  	{
  		need_window(line);
  		HBRUSH b = CreateSolidBrush(colour(c, line));
  		RECT all{0, 0, width, height};
  		FillRect(canvas, &all, b);
  		DeleteObject(b);
  	}

  	inline void box(double x, double y, double w, double h, const std::string& c, int line)
  	{
  		need_window(line);
  		HBRUSH b = CreateSolidBrush(colour(c, line));
  		RECT r{(int)std::lround(x), (int)std::lround(y), (int)std::lround(x + w), (int)std::lround(y + h)};
  		FillRect(canvas, &r, b);
  		DeleteObject(b);
  	}

  	inline void circle(double x, double y, double radius, const std::string& c, int line)
  	{
  		need_window(line);
  		COLORREF col = colour(c, line);
  		HBRUSH b = CreateSolidBrush(col);
  		HPEN p = CreatePen(PS_SOLID, 1, col);
  		HGDIOBJ ob = SelectObject(canvas, b), op = SelectObject(canvas, p);
  		Ellipse(canvas, (int)std::lround(x - radius), (int)std::lround(y - radius), (int)std::lround(x + radius) + 1, (int)std::lround(y + radius) + 1);
  		SelectObject(canvas, ob); SelectObject(canvas, op);
  		DeleteObject(b); DeleteObject(p);
  	}

  	inline void line_between(double x1, double y1, double x2, double y2, const std::string& c, int line)
  	{
  		need_window(line);
  		HPEN p = CreatePen(PS_SOLID, 2, colour(c, line));
  		HGDIOBJ op = SelectObject(canvas, p);
  		MoveToEx(canvas, (int)std::lround(x1), (int)std::lround(y1), nullptr);
  		LineTo(canvas, (int)std::lround(x2), (int)std::lround(y2));
  		SelectObject(canvas, op);
  		DeleteObject(p);
  	}

  	inline void write(const std::string& words, double x, double y, const std::string& c, int line)
  	{
  		need_window(line);
  		SetTextColor(canvas, colour(c, line));
  		std::wstring w = wide(words);
  		TextOutW(canvas, (int)std::lround(x), (int)std::lround(y), w.c_str(), (int)w.size());
  	}

  	inline void set_text_size(double size, int line)
  	{
  		if (!(size >= 1 && size <= 500))
  			imagine::fail(line, "text can be from 1 to 500 dots high, not " + imagine::text(size) + ".");
  		text_size = (int)std::lround(size);
  		if (canvas)
  		{
  			HFONT bigger = CreateFontW(-text_size, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, CLEARTYPE_QUALITY, 0, L"Segoe UI");
  			SelectObject(canvas, bigger);
  			DeleteObject(font);
  			font = bigger;
  		}
  	}

  	inline void show(int line)
  	{
  		need_window(line);
  		if (window)
  		{
  			InvalidateRect(window, nullptr, FALSE);
  			UpdateWindow(window);
  		}
  		pump();
  		for (int k = 0; k < 256; ++k)
  		{
  			pressed[k] = fresh[k];
  			fresh[k] = false;
  		}
  		clicked = click_fresh;
  		click_fresh = false;
  		LARGE_INTEGER now, freq;
  		QueryPerformanceFrequency(&freq);
  		QueryPerformanceCounter(&now);
  		double spent = double(now.QuadPart - last_frame.QuadPart) / double(freq.QuadPart);
  		if (spent < 1.0 / 60)
  			Sleep((DWORD)((1.0 / 60 - spent) * 1000));
  		LARGE_INTEGER before = last_frame;
  		QueryPerformanceCounter(&last_frame);
  		frame_time = double(last_frame.QuadPart - before.QuadPart) / double(freq.QuadPart);
  	}

  	inline Gdiplus::Image* picture(const std::string& file, int line)
  	{
  		static ULONG_PTR started = 0;
  		static std::map<std::string, std::unique_ptr<Gdiplus::Image>> loaded;
  		if (!started)
  		{
  			Gdiplus::GdiplusStartupInput in;
  			Gdiplus::GdiplusStartup(&started, &in, nullptr);
  		}
  		auto found = loaded.find(file);
  		if (found != loaded.end())
  			return found->second.get();
  		if (GetFileAttributesW(wide(file).c_str()) == INVALID_FILE_ATTRIBUTES)
  			imagine::fail(line, "there is no picture called \"" + file + "\".");
  		auto image = std::make_unique<Gdiplus::Image>(wide(file).c_str());
  		if (image->GetLastStatus() != Gdiplus::Ok || image->GetWidth() == 0)
  			imagine::fail(line, "I couldn't read the picture \"" + file + "\" (use .png or .gif).");
  		return (loaded[file] = std::move(image)).get();
  	}

  	inline void draw_picture(const std::string& file, double x, double y, int line)
  	{
  		need_window(line);
  		Gdiplus::Image* image = picture(file, line);
  		Gdiplus::Graphics g(canvas);
  		g.DrawImage(image, (int)std::lround(x), (int)std::lround(y), (int)image->GetWidth(), (int)image->GetHeight());
  	}

  	// The picture's middle at x, y; size 2 is twice as big; angle in degrees, turning clockwise.
  	inline void draw_picture_turned(const std::string& file, double x, double y, double size, double angle, int line)
  	{
  		need_window(line);
  		if (!(size > 0 && size <= 100))
  			imagine::fail(line, "a picture's size must be more than 0 and at most 100, not " + imagine::text(size) + ".");
  		Gdiplus::Image* image = picture(file, line);
  		Gdiplus::Graphics g(canvas);
  		g.SetInterpolationMode(Gdiplus::InterpolationModeHighQualityBicubic);
  		g.TranslateTransform((Gdiplus::REAL)x, (Gdiplus::REAL)y);
  		g.RotateTransform((Gdiplus::REAL)angle);
  		g.ScaleTransform((Gdiplus::REAL)size, (Gdiplus::REAL)size);
  		Gdiplus::REAL w = (Gdiplus::REAL)image->GetWidth(), h = (Gdiplus::REAL)image->GetHeight();
  		g.DrawImage(image, -w / 2, -h / 2, w, h);
  	}

  	inline void close()
  	{
  		if (window)
  			DestroyWindow(window);
  		window = nullptr;
  		open_now = false;
  		pump();
  	}
  }

python:
  import tkinter
  COLOURS = {"black": "#000000", "white": "#ffffff", "red": "#dc2828", "green": "#28b446", "blue": "#325ae6",
             "yellow": "#f5d228", "orange": "#f58c1e", "purple": "#8c3cc8", "pink": "#f078b4", "brown": "#825028",
             "grey": "#808080", "gray": "#808080"}
  KEYS = {"left", "right", "up", "down", "space", "enter", "escape", "shift", "control", "tab", "backspace"}
  TK_KEYS = {"return": "enter", "shift_l": "shift", "shift_r": "shift", "control_l": "control", "control_r": "control"}
  win = {"root": None, "open": False, "opened": False, "pressed": set(), "clicked": False, "held": set(), "mouse": (0.0, 0.0), "down": False, "last": 0.0, "text size": 16, "frame time": 1.0 / 60}

  def need_window():
      if not win["opened"]:
          raise RunError(0, 'there is no window yet. Open one first, like: open a world with "My game", 800, 600')

  def colour(name):
      low = name.lower()
      if low in COLOURS:
          return COLOURS[low]
      if len(low) == 7 and low[0] == "#" and all(c in "0123456789abcdef" for c in low[1:]):
          return low
      raise RunError(0, f'I don\'t know the colour "{name}". Use a name like "red" or a code like "#ff8800".')

  def key_name(name):
      k = name.lower()
      if (len(k) == 1 and (("a" <= k <= "z") or ("0" <= k <= "9"))) or k in KEYS:
          return k
      raise RunError(0, f'I don\'t know the key "{name}". Keys are letters, digits, left, right, up, down, space, enter, escape, shift, control, tab and backspace.')

  def closed():
      win["open"] = False
      pictures.clear()
      if win["root"] is not None:
          win["root"].destroy()
      win["root"] = None

  def pump():
      if win["root"] is not None:
          try:
              win["root"].update()
          except tkinter.TclError:
              win["root"], win["open"] = None, False

  def open_window(title, w, h):
      if win["root"] is not None:
          raise RunError(0, "a window is already open.")
      if w < 1 or h < 1 or w > 10000 or h > 10000:
          raise RunError(0, "a window must be from 1 to 10000 dots wide and high.")
      root = tkinter._default_root or tkinter.Tk()  # a hidden one may exist already, for picture sizes
      root.deiconify()
      root.title(title)
      root.resizable(False, False)
      canvas = tkinter.Canvas(root, width=int(w), height=int(h), highlightthickness=0, bd=0, bg="#000000")
      canvas.pack()
      held = win["held"]
      held.clear()
      root.protocol("WM_DELETE_WINDOW", closed)
      def down(e):
          k = TK_KEYS.get(e.keysym.lower(), e.keysym.lower())
          if k not in held:  # not the repeats a held key sends
              win["fresh"].add(k)
          held.add(k)
      root.bind("<KeyPress>", down)
      root.bind("<KeyRelease>", lambda e: held.discard(TK_KEYS.get(e.keysym.lower(), e.keysym.lower())))
      root.bind("<FocusOut>", lambda e: (held.clear(), win.update(down=False)))
      canvas.bind("<Motion>", lambda e: win.update(mouse=(float(e.x), float(e.y))))
      canvas.bind("<B1-Motion>", lambda e: win.update(mouse=(float(e.x), float(e.y))))
      canvas.bind("<ButtonPress-1>", lambda e: win.update(down=True, click_fresh=True))
      canvas.bind("<ButtonRelease-1>", lambda e: win.update(down=False))
      win.update(root=root, canvas=canvas, open=True, opened=True, size=(int(w), int(h)), last=time.monotonic(),
                 fresh=set(), pressed=set(), click_fresh=False, clicked=False)
      root.focus_force()
      pump()

  def draw(make):
      need_window()
      if win["root"] is not None:
          make(win["canvas"])

  def clear(c):
      col = colour(c)
      def make(cv):
          cv.delete("all")
          cv.create_rectangle(0, 0, win["size"][0], win["size"][1], fill=col, outline="")
      draw(make)

  def box(x, y, w, h, c):
      col = colour(c)
      draw(lambda cv: cv.create_rectangle(round(x), round(y), round(x + w), round(y + h), fill=col, outline=""))

  def circle(x, y, r, c):
      col = colour(c)
      draw(lambda cv: cv.create_oval(round(x - r), round(y - r), round(x + r), round(y + r), fill=col, outline=col))

  def line_between(x1, y1, x2, y2, c):
      col = colour(c)
      draw(lambda cv: cv.create_line(round(x1), round(y1), round(x2), round(y2), fill=col, width=2))

  def write(words, x, y, c):
      col = colour(c)
      size = win["text size"]
      draw(lambda cv: cv.create_text(round(x), round(y), text=words, fill=col, anchor="nw", font=("Segoe UI", -size)))

  def set_text_size(size):
      if not 1 <= size <= 500:
          raise RunError(0, f"text can be from 1 to 500 dots high, not {text(size)}.")
      win["text size"] = int(math.floor(size + 0.5))

  def show():
      need_window()
      pump()
      win["pressed"], win["fresh"] = win["fresh"], set()
      win["clicked"], win["click_fresh"] = win["click_fresh"], False
      wait = 1.0 / 60 - (time.monotonic() - win["last"])
      if wait > 0:
          time.sleep(wait)
      now = time.monotonic()
      win["frame time"], win["last"] = now - win["last"], now

  pictures = {}

  def picture(file):
      if file not in pictures:
          if not os.path.isfile(file):
              raise RunError(0, f'there is no picture called "{file}".')
          try:
              pictures[file] = tkinter.PhotoImage(file=file)
          except tkinter.TclError:
              raise RunError(0, f'I couldn\'t read the picture "{file}" (use .png or .gif).')
      return pictures[file]

  def size_of_picture(file, which):
      if not tkinter._default_root:
          tkinter.Tk().withdraw()  # PhotoImage needs Tk running, even before a window is open
      image = picture(file)
      return float(image.width() if which == 0 else image.height())

  def draw_picture(file, x, y):
      need_window()
      image = picture(file)
      draw(lambda cv: cv.create_image(round(x), round(y), image=image, anchor="nw"))

  turned = {}

  def draw_picture_turned(file, x, y, size, angle):
      need_window()
      if not 0 < size <= 100:
          raise RunError(0, f"a picture's size must be more than 0 and at most 100, not {text(size)}.")
      picture(file)
      if win["root"] is None:
          return
      key = (file, round(size, 3), round(angle % 360, 1))
      if key not in turned:
          try:
              from PIL import Image, ImageTk
          except ImportError:
              raise RunError(0, "turning pictures needs Pillow when running directly. Type: py -3 -m pip install pillow"
                                " (or build the program, which doesn't need it).")
          if len(turned) > 500:  # shortcut: forget them all rather than track which are still used
              turned.clear()
          im = Image.open(file).convert("RGBA")
          im = im.resize((max(1, round(im.width * size)), max(1, round(im.height * size))), Image.BICUBIC)
          turned[key] = ImageTk.PhotoImage(im.rotate(-angle, resample=Image.BICUBIC, expand=True))
      image = turned[key]
      draw(lambda cv: cv.create_image(round(x), round(y), image=image, anchor="center"))

  def close():
      if win["root"] is not None:
          closed()

to open a world, given title (text) and width (a number) and height (a number) = imagine_window::open({title}, {width}, {height}, {line})
  runs: open_window({title}, {width}, {height})
to consume the window, given colour (text) = imagine_window::clear({colour}, {line})
  runs: clear({colour})
to etch a box, given x (a number) and y (a number) and width (a number) and height (a number) and colour (text) = imagine_window::box({x}, {y}, {width}, {height}, {colour}, {line})
  runs: box({x}, {y}, {width}, {height}, {colour})
to etch a square, given x (a number) and y (a number) and radius (a number) and colour (text) = imagine_window::box(({x}) - ({radius}), ({y}) - ({radius}), 2 * ({radius}), 2 * ({radius}), {colour}, {line})
  runs: box({x} - {radius}, {y} - {radius}, 2 * {radius}, 2 * {radius}, {colour})
to etch a circle, given x (a number) and y (a number) and radius (a number) and colour (text) = imagine_window::circle({x}, {y}, {radius}, {colour}, {line})
  runs: circle({x}, {y}, {radius}, {colour})
to etch a line, given x (a number) and y (a number) and to x (a number) and to y (a number) and colour (text) = imagine_window::line_between({x}, {y}, {to x}, {to y}, {colour}, {line})
  runs: line_between({x}, {y}, {to x}, {to y}, {colour})
to etch words, given words (text) and x (a number) and y (a number) and colour (text) = imagine_window::write({words}, {x}, {y}, {colour}, {line})
  runs: write({words}, {x}, {y}, {colour})
to set the text size to, given size (a number) = imagine_window::set_text_size({size}, {line})
  runs: set_text_size({size})
to reveal the frame = imagine_window::show({line})
  runs: show()
to etch the picture, given file (text) and x (a number) and y (a number) = imagine_window::draw_picture({file}, {x}, {y}, {line})
  runs: draw_picture({file}, {x}, {y})
to etch the picture turned, given file (text) and x (a number) and y (a number) and size (a number) and angle (a number) = imagine_window::draw_picture_turned({file}, {x}, {y}, {size}, {angle}, {line})
  runs: draw_picture_turned({file}, {x}, {y}, {size}, {angle})
to width of picture, given file (text), giving back a number = (double)imagine_window::picture({file}, {line})->GetWidth()
  runs: size_of_picture({file}, 0)
to height of picture, given file (text), giving back a number = (double)imagine_window::picture({file}, {line})->GetHeight()
  runs: size_of_picture({file}, 1)
to end the world = imagine_window::close()
  runs: close()
to key held, given key (text), giving back yes or no = (imagine_window::keys[imagine_window::key_code({key}, {line})])
  runs: key_name({key}) in win["held"]

the world lives = imagine_window::open_now, yes or no, read only
  runs: win["open"]
width of the world = (double)imagine_window::width, number, read only
  runs: float(win.get("size", (0, 0))[0])
height of the world = (double)imagine_window::height, number, read only
  runs: float(win.get("size", (0, 0))[1])
mouse x = imagine_window::mouse_x_now, number, read only
  runs: win["mouse"][0]
mouse y = imagine_window::mouse_y_now, number, read only
  runs: win["mouse"][1]
to key pressed, given key (text), giving back yes or no = (imagine_window::pressed[imagine_window::key_code({key}, {line})])
  runs: key_name({key}) in win["pressed"]
mouse clicked = imagine_window::clicked, yes or no, read only
  runs: win["clicked"]
frame time = imagine_window::frame_time, number, read only
  runs: win["frame time"]
mouse held = imagine_window::mouse_down, yes or no, read only
  runs: win["down"]

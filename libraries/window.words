note: A window to draw in, for games and pictures. Use it in a program with:  use: window
note: Places in the window are counted in dots (pixels) from its top left corner: x goes right, y goes down.
note: Colours are names (black, white, red, green, blue, yellow, orange, purple, pink, brown, grey) or "#rrggbb".
note: Built programs draw with Windows' own drawing (GDI); programs run directly draw with Tkinter.

code:
  #define NOMINMAX
include: <winsock2.h>
include: <windows.h>
include: <GL/gl.h>
include: <cstring>
link: user32
link: gdi32
link: opengl32
link: msimg32
link: winmm
code:
  #include <objidl.h>
  namespace Gdiplus { using std::min; using std::max; }
include: <gdiplus.h>
link: gdiplus

code:
  namespace imagine_window
  {
  	inline HWND window = nullptr;
  	inline HDC canvas = nullptr;
  	inline HFONT font = nullptr;
  	inline int text_size = 16;
  	inline double frame_time = 1.0 / 60;  // seconds the last frame took
  	inline bool open_now = false;
  	inline bool opened = false;
  	inline bool keys[256] = {};
  	inline bool fresh[256] = {}, pressed[256] = {};
  	inline bool click_fresh = false, clicked = false;
  	inline bool mouse_down = false;
  	inline double mouse_x_now = 0, mouse_y_now = 0;
  	inline int width = 0, height = 0;
  	inline LARGE_INTEGER last_frame{};

  	inline std::wstring wide(const std::string& s)
  	{
  		std::wstring out(MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0), L'\0');
  		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), out.data(), (int)out.size());
  		return out;
  	}

  	inline void flush3d();
  	inline void need_window(int line)
  	{
  		if (!opened)
  			imagine::fail(line, "there is no window yet. Open one first, like: open a world with \"My game\", 800, 600");
  		flush3d();
  	}

  	inline COLORREF colour(const std::string& name, int line)
  	{
  		static const std::pair<const char*, COLORREF> named[] = {
  			{"black", RGB(0, 0, 0)}, {"white", RGB(255, 255, 255)}, {"red", RGB(220, 40, 40)}, {"green", RGB(40, 180, 70)},
  			{"blue", RGB(50, 90, 230)}, {"yellow", RGB(245, 210, 40)}, {"orange", RGB(245, 140, 30)},
  			{"purple", RGB(140, 60, 200)}, {"pink", RGB(240, 120, 180)}, {"brown", RGB(130, 80, 40)},
  			{"grey", RGB(128, 128, 128)}, {"gray", RGB(128, 128, 128)}};
  		std::string low = imagine::lower(name);
  		for (const auto& [key, value] : named)
  			if (low == key) return value;
  		if (low.size() == 7 && low[0] == '#' && low.find_first_not_of("0123456789abcdef", 1) == std::string::npos)
  		{
  			unsigned long v = std::stoul(low.substr(1), nullptr, 16);
  			return RGB((v >> 16) & 255, (v >> 8) & 255, v & 255);
  		}
  		imagine::fail(line, "I don't know the colour \"" + name + "\". Use a name like \"red\" or a code like \"#ff8800\".");
  	}

  	inline int key_code(const std::string& name, int line)
  	{
  		std::string k = imagine::lower(name);
  		if (k.size() == 1 && ((k[0] >= 'a' && k[0] <= 'z') || (k[0] >= '0' && k[0] <= '9')))
  			return std::toupper((unsigned char)k[0]);
  		static const std::pair<const char*, int> named[] = {
  			{"left", VK_LEFT}, {"right", VK_RIGHT}, {"up", VK_UP}, {"down", VK_DOWN}, {"space", VK_SPACE},
  			{"enter", VK_RETURN}, {"escape", VK_ESCAPE}, {"shift", VK_SHIFT}, {"control", VK_CONTROL},
  			{"tab", VK_TAB}, {"backspace", VK_BACK}};
  		for (const auto& [key, value] : named)
  			if (k == key) return value;
  		imagine::fail(line, "I don't know the key \"" + name + "\". Keys are letters, digits, left, right, up, down, space, enter, escape, shift, control, tab and backspace.");
  	}

  	inline LRESULT CALLBACK on_message(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
  	{
  		switch (msg)
  		{
  		case WM_CLOSE: open_now = false; DestroyWindow(hwnd); window = nullptr; return 0;
  		case WM_KEYDOWN: case WM_SYSKEYDOWN: if (!(lp & (1 << 30))) fresh[wp & 255] = true; keys[wp & 255] = true; return 0;
  		case WM_KEYUP: case WM_SYSKEYUP: keys[wp & 255] = false; return 0;
  		case WM_KILLFOCUS: for (bool& k : keys) k = false; mouse_down = false; return 0;
  		case WM_MOUSEMOVE: mouse_x_now = (short)LOWORD(lp); mouse_y_now = (short)HIWORD(lp); return 0;
  		case WM_LBUTTONDOWN: mouse_down = click_fresh = true; SetCapture(hwnd); return 0;
  		case WM_LBUTTONUP: mouse_down = false; ReleaseCapture(); return 0;
  		case WM_PAINT:
  		{
  			PAINTSTRUCT ps;
  			HDC dc = BeginPaint(hwnd, &ps);
  			BitBlt(dc, 0, 0, width, height, canvas, 0, 0, SRCCOPY);
  			EndPaint(hwnd, &ps);
  			return 0;
  		}
  		}
  		return DefWindowProcW(hwnd, msg, wp, lp);
  	}

  	inline void pump()
  	{
  		MSG m;
  		while (PeekMessageW(&m, nullptr, 0, 0, PM_REMOVE))
  		{
  			TranslateMessage(&m);
  			DispatchMessageW(&m);
  		}
  	}

  	inline void open(const std::string& title, double w, double h, int line)
  	{
  		timeBeginPeriod(1);  // Sleep to the millisecond, so frames come 60 times a second, not 32
  		if (window)
  			imagine::fail(line, "a window is already open.");
  		if (w < 1 || h < 1 || w > 10000 || h > 10000)
  			imagine::fail(line, "a window must be from 1 to 10000 dots wide and high.");
  		width = (int)w; height = (int)h;
  		WNDCLASSW wc{};
  		wc.lpfnWndProc = on_message;
  		wc.hInstance = GetModuleHandleW(nullptr);
  		wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
  		wc.lpszClassName = L"ImaginationWindow";
  		RegisterClassW(&wc);
  		DWORD style = WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX;
  		RECT r{0, 0, width, height};
  		AdjustWindowRect(&r, style, FALSE);
  		window = CreateWindowW(L"ImaginationWindow", wide(title).c_str(), style, CW_USEDEFAULT, CW_USEDEFAULT,
  			r.right - r.left, r.bottom - r.top, nullptr, nullptr, wc.hInstance, nullptr);
  		HDC dc = GetDC(window);
  		canvas = CreateCompatibleDC(dc);
  		SelectObject(canvas, CreateCompatibleBitmap(dc, width, height));
  		ReleaseDC(window, dc);
  		font = CreateFontW(-text_size, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, CLEARTYPE_QUALITY, 0, L"Segoe UI");
  		SelectObject(canvas, font);
  		SetBkMode(canvas, TRANSPARENT);
  		RECT all{0, 0, width, height};
  		FillRect(canvas, &all, (HBRUSH)GetStockObject(BLACK_BRUSH));
  		open_now = opened = true;
  		ShowWindow(window, SW_SHOW);
  		pump();
  		QueryPerformanceCounter(&last_frame);
  	}

  	inline void clear(const std::string& c, int line)
  	{
  		need_window(line);
  		HBRUSH b = CreateSolidBrush(colour(c, line));
  		RECT all{0, 0, width, height};
  		FillRect(canvas, &all, b);
  		DeleteObject(b);
  	}

  	inline void box(double x, double y, double w, double h, const std::string& c, int line)
  	{
  		need_window(line);
  		HBRUSH b = CreateSolidBrush(colour(c, line));
  		RECT r{(int)std::lround(x), (int)std::lround(y), (int)std::lround(x + w), (int)std::lround(y + h)};
  		FillRect(canvas, &r, b);
  		DeleteObject(b);
  	}

  	inline void circle(double x, double y, double radius, const std::string& c, int line)
  	{
  		need_window(line);
  		COLORREF col = colour(c, line);
  		HBRUSH b = CreateSolidBrush(col);
  		HPEN p = CreatePen(PS_SOLID, 1, col);
  		HGDIOBJ ob = SelectObject(canvas, b), op = SelectObject(canvas, p);
  		Ellipse(canvas, (int)std::lround(x - radius), (int)std::lround(y - radius), (int)std::lround(x + radius) + 1, (int)std::lround(y + radius) + 1);
  		SelectObject(canvas, ob); SelectObject(canvas, op);
  		DeleteObject(b); DeleteObject(p);
  	}

  	inline void line_between(double x1, double y1, double x2, double y2, const std::string& c, int line)
  	{
  		need_window(line);
  		HPEN p = CreatePen(PS_SOLID, 2, colour(c, line));
  		HGDIOBJ op = SelectObject(canvas, p);
  		MoveToEx(canvas, (int)std::lround(x1), (int)std::lround(y1), nullptr);
  		LineTo(canvas, (int)std::lround(x2), (int)std::lround(y2));
  		SelectObject(canvas, op);
  		DeleteObject(p);
  	}

  	inline void write(const std::string& words, double x, double y, const std::string& c, int line)
  	{
  		need_window(line);
  		SetTextColor(canvas, colour(c, line));
  		std::wstring w = wide(words);
  		TextOutW(canvas, (int)std::lround(x), (int)std::lround(y), w.c_str(), (int)w.size());
  	}

  	inline void set_text_size(double size, int line)
  	{
  		if (!(size >= 1 && size <= 500))
  			imagine::fail(line, "text can be from 1 to 500 dots high, not " + imagine::text(size) + ".");
  		text_size = (int)std::lround(size);
  		if (canvas)
  		{
  			HFONT bigger = CreateFontW(-text_size, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, CLEARTYPE_QUALITY, 0, L"Segoe UI");
  			SelectObject(canvas, bigger);
  			DeleteObject(font);
  			font = bigger;
  		}
  	}

  	inline void show(int line)
  	{
  		need_window(line);
  		if (window)
  		{
  			InvalidateRect(window, nullptr, FALSE);
  			UpdateWindow(window);
  		}
  		pump();
  		for (int k = 0; k < 256; ++k)
  		{
  			pressed[k] = fresh[k];
  			fresh[k] = false;
  		}
  		clicked = click_fresh;
  		click_fresh = false;
  		LARGE_INTEGER now, freq;
  		QueryPerformanceFrequency(&freq);
  		QueryPerformanceCounter(&now);
  		double spent = double(now.QuadPart - last_frame.QuadPart) / double(freq.QuadPart);
  		if (spent < 1.0 / 60)
  			Sleep((DWORD)((1.0 / 60 - spent) * 1000));
  		LARGE_INTEGER before = last_frame;
  		QueryPerformanceCounter(&last_frame);
  		frame_time = double(last_frame.QuadPart - before.QuadPart) / double(freq.QuadPart);
  	}

  	inline Gdiplus::Image* picture(const std::string& file, int line)
  	{
  		static ULONG_PTR started = 0;
  		static std::map<std::string, std::unique_ptr<Gdiplus::Image>> loaded;
  		if (!started)
  		{
  			Gdiplus::GdiplusStartupInput in;
  			Gdiplus::GdiplusStartup(&started, &in, nullptr);
  		}
  		auto found = loaded.find(file);
  		if (found != loaded.end())
  			return found->second.get();
  		if (GetFileAttributesW(wide(file).c_str()) == INVALID_FILE_ATTRIBUTES)
  			imagine::fail(line, "there is no picture called \"" + file + "\".");
  		auto image = std::make_unique<Gdiplus::Image>(wide(file).c_str());
  		if (image->GetLastStatus() != Gdiplus::Ok || image->GetWidth() == 0)
  			imagine::fail(line, "I couldn't read the picture \"" + file + "\" (use .png or .gif).");
  		return (loaded[file] = std::move(image)).get();
  	}

  	inline void draw_picture(const std::string& file, double x, double y, int line)
  	{
  		need_window(line);
  		Gdiplus::Image* image = picture(file, line);
  		Gdiplus::Graphics g(canvas);
  		g.DrawImage(image, (int)std::lround(x), (int)std::lround(y), (int)image->GetWidth(), (int)image->GetHeight());
  	}

  	// The picture's middle at x, y; size 2 is twice as big; angle in degrees, turning clockwise.
  	inline void draw_picture_turned(const std::string& file, double x, double y, double size, double angle, int line)
  	{
  		need_window(line);
  		if (!(size > 0 && size <= 100))
  			imagine::fail(line, "a picture's size must be more than 0 and at most 100, not " + imagine::text(size) + ".");
  		Gdiplus::Image* image = picture(file, line);
  		Gdiplus::Graphics g(canvas);
  		g.SetInterpolationMode(Gdiplus::InterpolationModeHighQualityBicubic);
  		g.TranslateTransform((Gdiplus::REAL)x, (Gdiplus::REAL)y);
  		g.RotateTransform((Gdiplus::REAL)angle);
  		g.ScaleTransform((Gdiplus::REAL)size, (Gdiplus::REAL)size);
  		Gdiplus::REAL w = (Gdiplus::REAL)image->GetWidth(), h = (Gdiplus::REAL)image->GetHeight();
  		g.DrawImage(image, -w / 2, -h / 2, w, h);
  	}

  	inline void close()
  	{
  		if (window)
  			DestroyWindow(window);
  		window = nullptr;
  		open_now = false;
  		pump();
  	}
  }

code:
  namespace imagine_window
  {
  	// The 3D words: the eye (camera) at a place, turned and tilted. Across is horizontal, up is vertical, away is depth.
  	// Shapes wait in items3 until something flat is etched or the frame is revealed. Then the graphics card draws them
  	// (OpenGL, with a depth buffer) into a hidden picture that is laid over the window; without OpenGL they are
  	// drawn far ones first instead.
  	struct V3 { double x, y, z; };
  	struct Item3 { bool round; std::vector<V3> pts; V3 c; double r; COLORREF col; double far_first; };
  	struct Shape3 { double depth; bool round; std::vector<POINT> points; int x, y, r; COLORREF col; };
  	inline std::vector<Item3> items3;
  	inline double eye_x = 0, eye_y = 1.5, eye_z = -6, eye_turn = 0, eye_tilt = 0;
  	inline const double near3 = 0.05, far3 = 1000, pi3 = 3.14159265358979323846;
  	inline const double sun[3] = {0.371, 0.743, -0.557};  // the light: up, a little right and behind

  	inline void need_open(int line)
  	{
  		if (!opened)
  			imagine::fail(line, "there is no window yet. Open one first, like: open a world with \"My game\", 800, 600");
  	}
  	inline double focal() { return (height / 2.0) / std::tan(30.0 * pi3 / 180.0); }  // 60 degrees from top to bottom
  	inline void axes(double r[3][3])  // rows: the eye's across, up and forward, in the world
  	{
  		double t = eye_turn * pi3 / 180.0, a = eye_tilt * pi3 / 180.0;
  		double ct = std::cos(t), st = std::sin(t), ca = std::cos(a), sa = std::sin(a);
  		double m[3][3] = {{ct, 0, -st}, {-sa * st, ca, -sa * ct}, {ca * st, sa, ca * ct}};
  		std::memcpy(r, m, sizeof m);
  	}
  	inline V3 view(V3 p)
  	{
  		double r[3][3];
  		axes(r);
  		double d[3] = {p.x - eye_x, p.y - eye_y, p.z - eye_z};
  		return {r[0][0] * d[0] + r[0][1] * d[1] + r[0][2] * d[2], r[1][0] * d[0] + r[1][1] * d[1] + r[1][2] * d[2],
  			r[2][0] * d[0] + r[2][1] * d[1] + r[2][2] * d[2]};
  	}
  	inline COLORREF shade(COLORREF c, double k)
  	{
  		auto part = [k](int v) { return (int)std::lround(std::min(255.0, std::max(0.0, v * k))); };
  		return RGB(part(GetRValue(c)), part(GetGValue(c)), part(GetBValue(c)));
  	}
  	inline COLORREF lighter(COLORREF c)
  	{
  		return RGB((GetRValue(c) + 255) / 2, (GetGValue(c) + 255) / 2, (GetBValue(c) + 255) / 2);
  	}
  	inline void polygon3(const std::vector<V3>& world, COLORREF col, double far_first = 0)
  	{
  		items3.push_back({false, world, {}, 0, col, far_first});
  	}

  	// ---- drawing far ones first (without a graphics card)
  	inline void project_polygon(const Item3& item, std::vector<Shape3>& shapes)
  	{
  		std::vector<V3> in, out;
  		for (const V3& w : item.pts)
  			in.push_back(view(w));
  		for (size_t k = 0; k < in.size(); ++k)  // cut off what is behind the eye
  		{
  			V3 a = in[k], b = in[(k + 1) % in.size()];
  			bool ia = a.z >= near3, ib = b.z >= near3;
  			if (ia)
  				out.push_back(a);
  			if (ia != ib)
  			{
  				double s = (near3 - a.z) / (b.z - a.z);
  				out.push_back({a.x + (b.x - a.x) * s, a.y + (b.y - a.y) * s, near3});
  			}
  		}
  		if (out.size() < 3)
  			return;
  		double f = focal(), depth = 0;
  		Shape3 shape{0, false, {}, 0, 0, 0, item.col};
  		for (const V3& v : out)
  		{
  			shape.points.push_back({(LONG)std::lround(width / 2.0 + v.x * f / v.z), (LONG)std::lround(height / 2.0 - v.y * f / v.z)});
  			depth += v.z;
  		}
  		shape.depth = depth / out.size() + item.far_first;
  		shapes.push_back(shape);
  	}
  	inline void project_ball(const Item3& item, std::vector<Shape3>& shapes)
  	{
  		V3 v = view(item.c);
  		if (v.z < near3)
  			return;
  		double f = focal();
  		int x = (int)std::lround(width / 2.0 + v.x * f / v.z), y = (int)std::lround(height / 2.0 - v.y * f / v.z);
  		int r = std::max(1, (int)std::lround(item.r * f / v.z));
  		shapes.push_back({v.z, true, {}, x, y, r, item.col});
  		int h = std::max(1, (int)std::lround(r * 0.3));
  		shapes.push_back({v.z - 1e-9, true, {}, x - (int)std::lround(r * 0.35), y - (int)std::lround(r * 0.35), h, lighter(item.col)});
  	}
  	inline void painter_flush()
  	{
  		std::vector<Shape3> shapes;
  		for (const Item3& item : items3)
  			item.round ? project_ball(item, shapes) : project_polygon(item, shapes);
  		std::stable_sort(shapes.begin(), shapes.end(), [](const Shape3& a, const Shape3& b) { return a.depth > b.depth; });
  		for (const Shape3& s : shapes)
  		{
  			HBRUSH b = CreateSolidBrush(s.col);
  			HPEN p = CreatePen(PS_SOLID, 1, s.col);
  			HGDIOBJ ob = SelectObject(canvas, b), op = SelectObject(canvas, p);
  			if (s.round)
  				Ellipse(canvas, s.x - s.r, s.y - s.r, s.x + s.r + 1, s.y + s.r + 1);
  			else
  				Polygon(canvas, s.points.data(), (int)s.points.size());
  			SelectObject(canvas, ob);
  			SelectObject(canvas, op);
  			DeleteObject(b);
  			DeleteObject(p);
  		}
  	}

  	// ---- the graphics card (OpenGL 1.1, in every Windows, plus a framebuffer to draw into without showing it)
  	typedef void(APIENTRY* GenFn)(GLsizei, GLuint*);
  	typedef void(APIENTRY* BindFn)(GLenum, GLuint);
  	typedef void(APIENTRY* StorageFn)(GLenum, GLenum, GLsizei, GLsizei);
  	typedef void(APIENTRY* AttachFn)(GLenum, GLenum, GLenum, GLuint);
  	typedef GLenum(APIENTRY* StatusFn)(GLenum);
  	inline bool gl_tried = false, gl_ok = false;
  	inline HDC gl_dc = nullptr;
  	inline HDC gl_picture_dc = nullptr;
  	inline void* gl_bits = nullptr;
  	inline GLuint gl_sphere = 0;
  	inline bool gl_start()
  	{
  		if (gl_tried)
  			return gl_ok;
  		gl_tried = true;
  		char* off = nullptr;
  		size_t size = 0;
  		bool no_gpu = _dupenv_s(&off, &size, "IMAGINE_NO_GPU") == 0 && off;
  		std::free(off);
  		if (no_gpu)
  			return false;
  		WNDCLASSW wc{};
  		wc.lpfnWndProc = DefWindowProcW;
  		wc.hInstance = GetModuleHandleW(nullptr);
  		wc.lpszClassName = L"ImaginationGL";
  		RegisterClassW(&wc);
  		HWND hidden = CreateWindowExW(0, L"ImaginationGL", L"", WS_POPUP, 0, 0, 16, 16, nullptr, nullptr, wc.hInstance, nullptr);
  		if (!hidden)
  			return false;
  		gl_dc = GetDC(hidden);
  		PIXELFORMATDESCRIPTOR pfd{};
  		pfd.nSize = sizeof pfd;
  		pfd.nVersion = 1;
  		pfd.dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL;
  		pfd.iPixelType = PFD_TYPE_RGBA;
  		pfd.cColorBits = 32;
  		pfd.cDepthBits = 24;
  		int format = ChoosePixelFormat(gl_dc, &pfd);
  		if (!format || !SetPixelFormat(gl_dc, format, &pfd))
  			return false;
  		HGLRC rc = wglCreateContext(gl_dc);
  		if (!rc || !wglMakeCurrent(gl_dc, rc))
  			return false;
  		auto gen_fb = (GenFn)wglGetProcAddress("glGenFramebuffers");
  		auto bind_fb = (BindFn)wglGetProcAddress("glBindFramebuffer");
  		auto gen_rb = (GenFn)wglGetProcAddress("glGenRenderbuffers");
  		auto bind_rb = (BindFn)wglGetProcAddress("glBindRenderbuffer");
  		auto storage = (StorageFn)wglGetProcAddress("glRenderbufferStorage");
  		auto attach = (AttachFn)wglGetProcAddress("glFramebufferRenderbuffer");
  		auto status = (StatusFn)wglGetProcAddress("glCheckFramebufferStatus");
  		if (!gen_fb || !bind_fb || !gen_rb || !bind_rb || !storage || !attach || !status)
  			return false;
  		GLuint fb = 0, rb[2] = {};
  		gen_fb(1, &fb);
  		bind_fb(0x8D40, fb);  // GL_FRAMEBUFFER
  		gen_rb(2, rb);
  		bind_rb(0x8D41, rb[0]);  // GL_RENDERBUFFER
  		storage(0x8D41, 0x8058, width, height);  // GL_RGBA8
  		attach(0x8D40, 0x8CE0, 0x8D41, rb[0]);  // GL_COLOR_ATTACHMENT0
  		bind_rb(0x8D41, rb[1]);
  		storage(0x8D41, 0x81A6, width, height);  // GL_DEPTH_COMPONENT24
  		attach(0x8D40, 0x8D00, 0x8D41, rb[1]);  // GL_DEPTH_ATTACHMENT
  		if (status(0x8D40) != 0x8CD5)  // GL_FRAMEBUFFER_COMPLETE
  			return false;
  		BITMAPINFO info{};
  		info.bmiHeader.biSize = sizeof info.bmiHeader;
  		info.bmiHeader.biWidth = width;
  		info.bmiHeader.biHeight = height;  // bottom row first, as OpenGL reads them
  		info.bmiHeader.biPlanes = 1;
  		info.bmiHeader.biBitCount = 32;
  		info.bmiHeader.biCompression = BI_RGB;
  		HBITMAP picture = CreateDIBSection(canvas, &info, DIB_RGB_COLORS, &gl_bits, nullptr, 0);
  		if (!picture)
  			return false;
  		gl_picture_dc = CreateCompatibleDC(canvas);
  		SelectObject(gl_picture_dc, picture);
  		gl_sphere = glGenLists(1);  // a ball of radius 1, made once
  		glNewList(gl_sphere, GL_COMPILE);
  		const int rings = 12, slices = 20;
  		for (int i = 0; i < rings; ++i)
  		{
  			glBegin(GL_QUAD_STRIP);
  			for (int j = 0; j <= slices; ++j)
  				for (int k = 0; k < 2; ++k)
  				{
  					double lat = pi3 * (double(i + k) / rings - 0.5), lon = 2 * pi3 * j / slices;
  					double n[3] = {std::cos(lat) * std::cos(lon), std::sin(lat), std::cos(lat) * std::sin(lon)};
  					glNormal3d(n[0], n[1], n[2]);
  					glVertex3d(n[0], n[1], n[2]);
  				}
  			glEnd();
  		}
  		glEndList();
  		gl_ok = true;
  		return true;
  	}
  	inline void gl_colour(COLORREF c, double k)
  	{
  		glColor3d(std::min(1.0, GetRValue(c) * k / 255.0), std::min(1.0, GetGValue(c) * k / 255.0), std::min(1.0, GetBValue(c) * k / 255.0));
  	}
  	inline void gl_flush()
  	{
  		glViewport(0, 0, width, height);
  		glClearColor(0, 0, 0, 0);
  		glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
  		glEnable(GL_DEPTH_TEST);
  		glMatrixMode(GL_PROJECTION);
  		glLoadIdentity();
  		double top = near3 * std::tan(30.0 * pi3 / 180.0), right = top * width / height;
  		glFrustum(-right, right, -top, top, near3, far3);
  		double r[3][3];
  		axes(r);
  		double e[3] = {eye_x, eye_y, eye_z};
  		double m[16] = {};  // the eye's view, as OpenGL wants it (it looks along -z)
  		for (int k = 0; k < 3; ++k)
  		{
  			double sign = k == 2 ? -1 : 1;
  			for (int j = 0; j < 3; ++j)
  				m[j * 4 + k] = sign * r[k][j];
  			m[12 + k] = -sign * (r[k][0] * e[0] + r[k][1] * e[1] + r[k][2] * e[2]);
  		}
  		m[15] = 1;
  		glMatrixMode(GL_MODELVIEW);
  		glLoadMatrixd(m);
  		const GLfloat to_sun[4] = {(GLfloat)sun[0], (GLfloat)sun[1], (GLfloat)sun[2], 0}, ambient[4] = {0.55f, 0.55f, 0.55f, 1},
  			diffuse[4] = {0.45f, 0.45f, 0.45f, 1}, shine[4] = {0.5f, 0.5f, 0.5f, 1}, none[4] = {0, 0, 0, 1};
  		glLightfv(GL_LIGHT0, GL_POSITION, to_sun);
  		glLightfv(GL_LIGHT0, GL_AMBIENT, ambient);
  		glLightfv(GL_LIGHT0, GL_DIFFUSE, diffuse);
  		glLightfv(GL_LIGHT0, GL_SPECULAR, shine);
  		glLightModelfv(GL_LIGHT_MODEL_AMBIENT, none);
  		glEnable(GL_LIGHT0);
  		glEnable(GL_NORMALIZE);
  		glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
  		glEnable(GL_COLOR_MATERIAL);
  		glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, shine);
  		glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 16);
  		glShadeModel(GL_SMOOTH);
  		for (const Item3& item : items3)
  		{
  			if (!item.round)
  			{
  				gl_colour(item.col, 1);
  				glBegin(GL_POLYGON);
  				for (const V3& p : item.pts)
  					glVertex3d(p.x, p.y, p.z);
  				glEnd();
  				continue;
  			}
  			glEnable(GL_LIGHTING);  // a ball: lit smoothly by the sun, with a shine
  			glPushMatrix();
  			glTranslated(item.c.x, item.c.y, item.c.z);
  			glScaled(item.r, item.r, item.r);
  			gl_colour(item.col, 1);
  			glCallList(gl_sphere);
  			glPopMatrix();
  			glDisable(GL_LIGHTING);
  		}
  		glReadPixels(0, 0, width, height, 0x80E1, GL_UNSIGNED_BYTE, gl_bits);  // GL_BGRA, as a Windows picture is
  		BLENDFUNCTION blend{AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
  		AlphaBlend(canvas, 0, 0, width, height, gl_picture_dc, 0, 0, width, height, blend);
  	}
  	inline void flush3d()
  	{
  		if (items3.empty())
  			return;
  		if (canvas)
  		{
  			if (gl_start())
  				gl_flush();
  			else
  				painter_flush();
  		}
  		items3.clear();
  	}
  	inline bool on_graphics_card() { return opened && gl_start(); }

  	inline V3 v3(const FVector& p) { return {p.X, p.Y, p.Z}; }
  	inline void place_eye(const FVector& p) { eye_x = p.X; eye_y = p.Y; eye_z = p.Z; }
  	inline void aim_eye(double turn, double tilt)
  	{
  		eye_turn = turn;
  		eye_tilt = std::max(-89.0, std::min(89.0, tilt));
  	}
  	inline FVector2D screen_place(const FVector& p)
  	{
  		V3 v = view(v3(p));
  		if (v.z < near3)
  			return FVector2D(std::nan(""), std::nan(""));
  		double f = focal();
  		return FVector2D(width / 2.0 + v.x * f / v.z, height / 2.0 - v.y * f / v.z);
  	}
  	inline void block(const FVector& middle, double w, double h, double d, const std::string& c, int line)
  	{
  		need_open(line);
  		if (!(w > 0 && h > 0 && d > 0))
  			imagine::fail(line, "a block's width, height and depth must all be more than 0.");
  		COLORREF col = colour(c, line);
  		V3 m = v3(middle);
  		double x0 = m.x - w / 2, x1 = m.x + w / 2, y0 = m.y - h / 2, y1 = m.y + h / 2, z0 = m.z - d / 2, z1 = m.z + d / 2;
  		struct Face { V3 n, a, b, c, d; };
  		const Face faces[6] = {
  			{{0, 0, -1}, {x0, y0, z0}, {x1, y0, z0}, {x1, y1, z0}, {x0, y1, z0}},
  			{{0, 0, 1}, {x1, y0, z1}, {x0, y0, z1}, {x0, y1, z1}, {x1, y1, z1}},
  			{{-1, 0, 0}, {x0, y0, z1}, {x0, y0, z0}, {x0, y1, z0}, {x0, y1, z1}},
  			{{1, 0, 0}, {x1, y0, z0}, {x1, y0, z1}, {x1, y1, z1}, {x1, y1, z0}},
  			{{0, 1, 0}, {x0, y1, z0}, {x1, y1, z0}, {x1, y1, z1}, {x0, y1, z1}},
  			{{0, -1, 0}, {x0, y0, z1}, {x1, y0, z1}, {x1, y0, z0}, {x0, y0, z0}}};
  		for (const Face& f : faces)
  		{
  			double cx = (f.a.x + f.c.x) / 2, cy = (f.a.y + f.c.y) / 2, cz = (f.a.z + f.c.z) / 2;
  			if (f.n.x * (eye_x - cx) + f.n.y * (eye_y - cy) + f.n.z * (eye_z - cz) <= 0)
  				continue;  // facing away from the eye
  			double lit = f.n.x * sun[0] + f.n.y * sun[1] + f.n.z * sun[2];
  			polygon3({f.a, f.b, f.c, f.d}, shade(col, 0.6 + 0.4 * std::max(0.0, lit)));
  		}
  	}
  	inline void cube(const FVector& middle, double size, const std::string& c, int line) { block(middle, size, size, size, c, line); }
  	inline void ball(const FVector& middle, double radius, const std::string& c, int line)
  	{
  		need_open(line);
  		if (!(radius > 0))
  			imagine::fail(line, "a ball's radius must be more than 0.");
  		items3.push_back({true, {}, v3(middle), radius, colour(c, line), 0});
  	}
  	inline void ground(const std::string& a, const std::string& b, int line)
  	{
  		need_open(line);
  		COLORREF ca = colour(a, line), cb = colour(b, line);
  		const double size = 2;
  		const long reach = 12;
  		long cx = (long)std::floor(eye_x / size), cz = (long)std::floor(eye_z / size);
  		for (long i = cx - reach; i < cx + reach; ++i)
  			for (long j = cz - reach; j < cz + reach; ++j)
  				polygon3({{i * size, 0, j * size}, {(i + 1) * size, 0, j * size}, {(i + 1) * size, 0, (j + 1) * size}, {i * size, 0, (j + 1) * size}},
  					((i + j) & 1) ? cb : ca, 1e9);  // drawing far ones first, the ground goes under everything
  	}
  }

python:
  import tkinter
  COLOURS = {"black": "#000000", "white": "#ffffff", "red": "#dc2828", "green": "#28b446", "blue": "#325ae6",
             "yellow": "#f5d228", "orange": "#f58c1e", "purple": "#8c3cc8", "pink": "#f078b4", "brown": "#825028",
             "grey": "#808080", "gray": "#808080"}
  KEYS = {"left", "right", "up", "down", "space", "enter", "escape", "shift", "control", "tab", "backspace"}
  TK_KEYS = {"return": "enter", "shift_l": "shift", "shift_r": "shift", "control_l": "control", "control_r": "control"}
  win = {"root": None, "open": False, "opened": False, "pressed": set(), "clicked": False, "held": set(), "mouse": (0.0, 0.0), "down": False, "last": 0.0, "text size": 16, "frame time": 1.0 / 60}

  def need_window():
      if not win["opened"]:
          raise RunError(0, 'there is no window yet. Open one first, like: open a world with "My game", 800, 600')
      flush3d()

  def colour(name):
      low = name.lower()
      if low in COLOURS:
          return COLOURS[low]
      if len(low) == 7 and low[0] == "#" and all(c in "0123456789abcdef" for c in low[1:]):
          return low
      raise RunError(0, f'I don\'t know the colour "{name}". Use a name like "red" or a code like "#ff8800".')

  def key_name(name):
      k = name.lower()
      if (len(k) == 1 and (("a" <= k <= "z") or ("0" <= k <= "9"))) or k in KEYS:
          return k
      raise RunError(0, f'I don\'t know the key "{name}". Keys are letters, digits, left, right, up, down, space, enter, escape, shift, control, tab and backspace.')

  def closed():
      win["open"] = False
      pictures.clear()
      if win["root"] is not None:
          win["root"].destroy()
      win["root"] = None

  def pump():
      if win["root"] is not None:
          try:
              win["root"].update()
          except tkinter.TclError:
              win["root"], win["open"] = None, False

  def open_window(title, w, h):
      if win["root"] is not None:
          raise RunError(0, "a window is already open.")
      if w < 1 or h < 1 or w > 10000 or h > 10000:
          raise RunError(0, "a window must be from 1 to 10000 dots wide and high.")
      root = tkinter._default_root or tkinter.Tk()  # a hidden one may exist already, for picture sizes
      root.deiconify()
      root.title(title)
      root.resizable(False, False)
      canvas = tkinter.Canvas(root, width=int(w), height=int(h), highlightthickness=0, bd=0, bg="#000000")
      canvas.pack()
      held = win["held"]
      held.clear()
      root.protocol("WM_DELETE_WINDOW", closed)
      def down(e):
          k = TK_KEYS.get(e.keysym.lower(), e.keysym.lower())
          if k not in held:  # not the repeats a held key sends
              win["fresh"].add(k)
          held.add(k)
      root.bind("<KeyPress>", down)
      root.bind("<KeyRelease>", lambda e: held.discard(TK_KEYS.get(e.keysym.lower(), e.keysym.lower())))
      root.bind("<FocusOut>", lambda e: (held.clear(), win.update(down=False)))
      canvas.bind("<Motion>", lambda e: win.update(mouse=(float(e.x), float(e.y))))
      canvas.bind("<B1-Motion>", lambda e: win.update(mouse=(float(e.x), float(e.y))))
      canvas.bind("<ButtonPress-1>", lambda e: win.update(down=True, click_fresh=True))
      canvas.bind("<ButtonRelease-1>", lambda e: win.update(down=False))
      win.update(root=root, canvas=canvas, open=True, opened=True, size=(int(w), int(h)), last=time.monotonic(),
                 fresh=set(), pressed=set(), click_fresh=False, clicked=False)
      root.focus_force()
      pump()

  def draw(make):
      need_window()
      if win["root"] is not None:
          make(win["canvas"])

  def clear(c):
      col = colour(c)
      def make(cv):
          cv.delete("all")
          cv.create_rectangle(0, 0, win["size"][0], win["size"][1], fill=col, outline="")
      draw(make)

  def box(x, y, w, h, c):
      col = colour(c)
      draw(lambda cv: cv.create_rectangle(round(x), round(y), round(x + w), round(y + h), fill=col, outline=""))

  def circle(x, y, r, c):
      col = colour(c)
      draw(lambda cv: cv.create_oval(round(x - r), round(y - r), round(x + r), round(y + r), fill=col, outline=col))

  def line_between(x1, y1, x2, y2, c):
      col = colour(c)
      draw(lambda cv: cv.create_line(round(x1), round(y1), round(x2), round(y2), fill=col, width=2))

  def write(words, x, y, c):
      col = colour(c)
      size = win["text size"]
      draw(lambda cv: cv.create_text(round(x), round(y), text=words, fill=col, anchor="nw", font=("Segoe UI", -size)))

  def set_text_size(size):
      if not 1 <= size <= 500:
          raise RunError(0, f"text can be from 1 to 500 dots high, not {text(size)}.")
      win["text size"] = int(math.floor(size + 0.5))

  def show():
      need_window()
      pump()
      win["pressed"], win["fresh"] = win["fresh"], set()
      win["clicked"], win["click_fresh"] = win["click_fresh"], False
      wait = 1.0 / 60 - (time.monotonic() - win["last"])
      if wait > 0:
          time.sleep(wait)
      now = time.monotonic()
      win["frame time"], win["last"] = now - win["last"], now

  pictures = {}

  def picture(file):
      if file not in pictures:
          if not os.path.isfile(file):
              raise RunError(0, f'there is no picture called "{file}".')
          try:
              pictures[file] = tkinter.PhotoImage(file=file)
          except tkinter.TclError:
              raise RunError(0, f'I couldn\'t read the picture "{file}" (use .png or .gif).')
      return pictures[file]

  def size_of_picture(file, which):
      if not tkinter._default_root:
          tkinter.Tk().withdraw()  # PhotoImage needs Tk running, even before a window is open
      image = picture(file)
      return float(image.width() if which == 0 else image.height())

  def draw_picture(file, x, y):
      need_window()
      image = picture(file)
      draw(lambda cv: cv.create_image(round(x), round(y), image=image, anchor="nw"))

  turned = {}

  def draw_picture_turned(file, x, y, size, angle):
      need_window()
      if not 0 < size <= 100:
          raise RunError(0, f"a picture's size must be more than 0 and at most 100, not {text(size)}.")
      picture(file)
      if win["root"] is None:
          return
      key = (file, round(size, 3), round(angle % 360, 1))
      if key not in turned:
          try:
              from PIL import Image, ImageTk
          except ImportError:
              raise RunError(0, "turning pictures needs Pillow when running directly. Type: py -3 -m pip install pillow"
                                " (or build the program, which doesn't need it).")
          if len(turned) > 500:  # shortcut: forget them all rather than track which are still used
              turned.clear()
          im = Image.open(file).convert("RGBA")
          im = im.resize((max(1, round(im.width * size)), max(1, round(im.height * size))), Image.BICUBIC)
          turned[key] = ImageTk.PhotoImage(im.rotate(-angle, resample=Image.BICUBIC, expand=True))
      image = turned[key]
      draw(lambda cv: cv.create_image(round(x), round(y), image=image, anchor="center"))

  def close():
      if win["root"] is not None:
          closed()

python:
  import ctypes
  from ctypes import wintypes
  EYE = {"x": 0.0, "y": 1.5, "z": -6.0, "turn": 0.0, "tilt": 0.0}
  ITEMS3 = []  # (round, points or middle, radius, colour, far first), drawn when something flat comes or the frame is revealed
  NEAR3, FAR3, PI3 = 0.05, 1000.0, 3.14159265358979323846
  SUN = (0.371, 0.743, -0.557)
  GL = {"tried": False, "ok": False}

  def need_open():
      if not win["opened"]:
          raise RunError(0, 'there is no window yet. Open one first, like: open a world with "My game", 800, 600')

  def focal():
      return (win["size"][1] / 2.0) / math.tan(30.0 * PI3 / 180.0)

  def axes():
      t, a = EYE["turn"] * PI3 / 180.0, EYE["tilt"] * PI3 / 180.0
      ct, st, ca, sa = math.cos(t), math.sin(t), math.cos(a), math.sin(a)
      return ((ct, 0.0, -st), (-sa * st, ca, -sa * ct), (ca * st, sa, ca * ct))

  def view(p):
      r = axes()
      d = (p[0] - EYE["x"], p[1] - EYE["y"], p[2] - EYE["z"])
      return tuple(row[0] * d[0] + row[1] * d[1] + row[2] * d[2] for row in r)

  def rgb(col):
      return int(col[1:3], 16), int(col[3:5], 16), int(col[5:7], 16)

  def shade(col, k):
      return "#%02x%02x%02x" % tuple(int(math.floor(min(255.0, max(0.0, v * k)) + 0.5)) for v in rgb(col))

  def lighter(col):
      return "#%02x%02x%02x" % tuple((v + 255) // 2 for v in rgb(col))

  def polygon3(world, col, far_first=0.0):
      ITEMS3.append((False, world, 0.0, col, far_first))

  # ---- drawing far ones first (without a graphics card)
  def project_polygon(world, col, far_first, shapes):
      cam = [view(w) for w in world]
      out = []
      for k in range(len(cam)):
          a, b = cam[k], cam[(k + 1) % len(cam)]
          ia, ib = a[2] >= NEAR3, b[2] >= NEAR3
          if ia:
              out.append(a)
          if ia != ib:
              s = (NEAR3 - a[2]) / (b[2] - a[2])
              out.append((a[0] + (b[0] - a[0]) * s, a[1] + (b[1] - a[1]) * s, NEAR3))
      if len(out) < 3:
          return
      f, w, h = focal(), win["size"][0], win["size"][1]
      points = []
      for v in out:
          points += [w / 2.0 + v[0] * f / v[2], h / 2.0 - v[1] * f / v[2]]
      shapes.append((sum(v[2] for v in out) / len(out) + far_first, False, points, col))

  def project_ball(middle, radius, col, shapes):
      v = view(middle)
      if v[2] < NEAR3:
          return
      f, w, h = focal(), win["size"][0], win["size"][1]
      x, y = w / 2.0 + v[0] * f / v[2], h / 2.0 - v[1] * f / v[2]
      r = max(1.0, radius * f / v[2])
      shapes.append((v[2], True, (x, y, r), col))
      shapes.append((v[2] - 1e-9, True, (x - r * 0.35, y - r * 0.35, max(1.0, r * 0.3)), lighter(col)))

  def painter_flush(cv):
      shapes = []
      for is_round, where, radius, col, far_first in ITEMS3:
          if is_round:
              project_ball(where, radius, col, shapes)
          else:
              project_polygon(where, col, far_first, shapes)
      shapes.sort(key=lambda s: -s[0])  # far ones first (sort keeps the order of equal ones, as the C++ does)
      for depth, is_round, points, col in shapes:
          if is_round:
              x, y, r = points
              cv.create_oval(x - r, y - r, x + r, y + r, fill=col, outline=col)
          else:
              cv.create_polygon(points, fill=col, outline=col)

  # ---- the graphics card: OpenGL 1.1 (in every Windows), called straight from Python, drawing into a hidden picture
  def gl_start():
      if GL["tried"]:
          return GL["ok"]
      GL["tried"] = True
      if os.environ.get("IMAGINE_NO_GPU"):
          return False
      try:
          from PIL import Image, ImageTk
          user32, gdi32, gl = ctypes.windll.user32, ctypes.windll.gdi32, ctypes.windll.opengl32
          user32.CreateWindowExW.restype = wintypes.HWND
          user32.CreateWindowExW.argtypes = [wintypes.DWORD, wintypes.LPCWSTR, wintypes.LPCWSTR, wintypes.DWORD, ctypes.c_int, ctypes.c_int,
                                             ctypes.c_int, ctypes.c_int, wintypes.HWND, wintypes.HMENU, wintypes.HINSTANCE, wintypes.LPVOID]
          user32.GetDC.restype, user32.GetDC.argtypes = wintypes.HDC, [wintypes.HWND]
          hidden = user32.CreateWindowExW(0, "STATIC", "", 0x80000000, 0, 0, 16, 16, None, None, None, None)
          if not hidden:
              return False
          dc = user32.GetDC(hidden)

          class PFD(ctypes.Structure):
              _fields_ = [("nSize", wintypes.WORD), ("nVersion", wintypes.WORD), ("dwFlags", wintypes.DWORD)] + \
                         [(n, ctypes.c_ubyte) for n in ("iPixelType", "cColorBits", "cRedBits", "cRedShift", "cGreenBits", "cGreenShift",
                                                       "cBlueBits", "cBlueShift", "cAlphaBits", "cAlphaShift", "cAccumBits", "cAccumRedBits",
                                                       "cAccumGreenBits", "cAccumBlueBits", "cAccumAlphaBits", "cDepthBits", "cStencilBits",
                                                       "cAuxBuffers", "iLayerType", "bReserved")] + \
                         [("dwLayerMask", wintypes.DWORD), ("dwVisibleMask", wintypes.DWORD), ("dwDamageMask", wintypes.DWORD)]
          pfd = PFD(nSize=ctypes.sizeof(PFD), nVersion=1, dwFlags=0x4 | 0x20, iPixelType=0, cColorBits=32, cDepthBits=24)
          gdi32.ChoosePixelFormat.argtypes = [wintypes.HDC, ctypes.POINTER(PFD)]
          gdi32.SetPixelFormat.argtypes = [wintypes.HDC, ctypes.c_int, ctypes.POINTER(PFD)]
          form = gdi32.ChoosePixelFormat(dc, ctypes.byref(pfd))
          if not form or not gdi32.SetPixelFormat(dc, form, ctypes.byref(pfd)):
              return False
          gl.wglCreateContext.restype, gl.wglCreateContext.argtypes = ctypes.c_void_p, [wintypes.HDC]
          gl.wglMakeCurrent.argtypes = [wintypes.HDC, ctypes.c_void_p]
          rc = gl.wglCreateContext(dc)
          if not rc or not gl.wglMakeCurrent(dc, rc):
              return False
          gl.wglGetProcAddress.restype, gl.wglGetProcAddress.argtypes = ctypes.c_void_p, [ctypes.c_char_p]
          def proc(name, *types):
              address = gl.wglGetProcAddress(name)
              return ctypes.WINFUNCTYPE(*types)(address) if address else None
          ui, uip = ctypes.c_uint, ctypes.POINTER(ctypes.c_uint)
          gen_fb, bind_fb = proc(b"glGenFramebuffers", None, ctypes.c_int, uip), proc(b"glBindFramebuffer", None, ui, ui)
          gen_rb, bind_rb = proc(b"glGenRenderbuffers", None, ctypes.c_int, uip), proc(b"glBindRenderbuffer", None, ui, ui)
          storage = proc(b"glRenderbufferStorage", None, ui, ui, ctypes.c_int, ctypes.c_int)
          attach = proc(b"glFramebufferRenderbuffer", None, ui, ui, ui, ui)
          status = proc(b"glCheckFramebufferStatus", ui, ui)
          if None in (gen_fb, bind_fb, gen_rb, bind_rb, storage, attach, status):
              return False
          w, h = win["size"]
          fb, rb = ctypes.c_uint(), (ctypes.c_uint * 2)()
          gen_fb(1, ctypes.byref(fb))
          bind_fb(0x8D40, fb.value)
          gen_rb(2, rb)
          bind_rb(0x8D41, rb[0])
          storage(0x8D41, 0x8058, w, h)
          attach(0x8D40, 0x8CE0, 0x8D41, rb[0])
          bind_rb(0x8D41, rb[1])
          storage(0x8D41, 0x81A6, w, h)
          attach(0x8D40, 0x8D00, 0x8D41, rb[1])
          if status(0x8D40) != 0x8CD5:
              return False
          d, f = ctypes.c_double, ctypes.c_float
          for name, types in (("glVertex3d", [d, d, d]), ("glNormal3d", [d, d, d]), ("glColor3d", [d, d, d]), ("glTranslated", [d, d, d]),
                              ("glScaled", [d, d, d]), ("glFrustum", [d] * 6), ("glClearColor", [f] * 4), ("glMaterialf", [ui, ui, f])):
              getattr(gl, name).argtypes = types
          gl.glLoadMatrixd.argtypes = [ctypes.POINTER(d)]
          sphere = gl.glGenLists(1)
          gl.glNewList(sphere, 0x1300)  # GL_COMPILE: a ball of radius 1, made once
          rings, slices = 12, 20
          for i in range(rings):
              gl.glBegin(0x0008)  # GL_QUAD_STRIP
              for j in range(slices + 1):
                  for k in range(2):
                      lat, lon = PI3 * ((i + k) / rings - 0.5), 2 * PI3 * j / slices
                      n = (math.cos(lat) * math.cos(lon), math.sin(lat), math.cos(lat) * math.sin(lon))
                      gl.glNormal3d(*n)
                      gl.glVertex3d(*n)
              gl.glEnd()
          gl.glEndList()
          GL.update(ok=True, gl=gl, sphere=sphere, pixels=ctypes.create_string_buffer(w * h * 4), Image=Image, ImageTk=ImageTk)
          return True
      except Exception:
          return False

  def gl_flush(cv):
      gl, (w, h) = GL["gl"], win["size"]
      gl.glViewport(0, 0, w, h)
      gl.glClearColor(0, 0, 0, 0)
      gl.glClear(0x4000 | 0x100)
      gl.glEnable(0x0B71)  # GL_DEPTH_TEST
      gl.glMatrixMode(0x1701)  # GL_PROJECTION
      gl.glLoadIdentity()
      top = NEAR3 * math.tan(30.0 * PI3 / 180.0)
      gl.glFrustum(-top * w / h, top * w / h, -top, top, NEAR3, FAR3)
      r, e = axes(), (EYE["x"], EYE["y"], EYE["z"])
      m = [0.0] * 16  # the eye's view, as OpenGL wants it (it looks along -z)
      for k in range(3):
          sign = -1.0 if k == 2 else 1.0
          for j in range(3):
              m[j * 4 + k] = sign * r[k][j]
          m[12 + k] = -sign * (r[k][0] * e[0] + r[k][1] * e[1] + r[k][2] * e[2])
      m[15] = 1.0
      gl.glMatrixMode(0x1700)  # GL_MODELVIEW
      gl.glLoadMatrixd((ctypes.c_double * 16)(*m))
      four = ctypes.c_float * 4
      gl.glLightfv(0x4000, 0x1203, four(SUN[0], SUN[1], SUN[2], 0))  # GL_LIGHT0, GL_POSITION
      gl.glLightfv(0x4000, 0x1200, four(0.55, 0.55, 0.55, 1))  # GL_AMBIENT
      gl.glLightfv(0x4000, 0x1201, four(0.45, 0.45, 0.45, 1))  # GL_DIFFUSE
      gl.glLightfv(0x4000, 0x1202, four(0.5, 0.5, 0.5, 1))  # GL_SPECULAR
      gl.glLightModelfv(0x0B53, four(0, 0, 0, 1))  # GL_LIGHT_MODEL_AMBIENT
      gl.glEnable(0x4000)
      gl.glEnable(0x0BA1)  # GL_NORMALIZE
      gl.glColorMaterial(0x0408, 0x1602)  # GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE
      gl.glEnable(0x0B57)  # GL_COLOR_MATERIAL
      gl.glMaterialfv(0x0408, 0x1202, four(0.5, 0.5, 0.5, 1))
      gl.glMaterialf(0x0408, 0x1601, 16.0)  # GL_SHININESS
      gl.glShadeModel(0x1D01)  # GL_SMOOTH
      for is_round, where, radius, col, far_first in ITEMS3:
          c = rgb(col)
          gl.glColor3d(c[0] / 255.0, c[1] / 255.0, c[2] / 255.0)
          if not is_round:
              gl.glBegin(0x0009)  # GL_POLYGON
              for p in where:
                  gl.glVertex3d(*p)
              gl.glEnd()
              continue
          gl.glEnable(0x0B50)  # GL_LIGHTING
          gl.glPushMatrix()
          gl.glTranslated(*where)
          gl.glScaled(radius, radius, radius)
          gl.glCallList(GL["sphere"])
          gl.glPopMatrix()
          gl.glDisable(0x0B50)
      gl.glReadPixels(0, 0, w, h, 0x1908, 0x1401, GL["pixels"])  # GL_RGBA, GL_UNSIGNED_BYTE
      picture = GL["Image"].frombuffer("RGBA", (w, h), GL["pixels"], "raw", "RGBA", 0, -1)  # OpenGL's rows start at the bottom
      photo = GL["ImageTk"].PhotoImage(picture)
      win["3d picture"] = photo  # kept, or Tk forgets it
      cv.create_image(0, 0, image=photo, anchor="nw")

  def flush3d():
      if not ITEMS3:
          return
      cv = win.get("canvas") if win["root"] is not None else None
      if cv is not None:
          if gl_start():
              gl_flush(cv)
          else:
              painter_flush(cv)
      ITEMS3.clear()

  def place_eye(p):
      EYE["x"], EYE["y"], EYE["z"] = p.parts()[:3]

  def aim_eye(turn, tilt):
      EYE["turn"], EYE["tilt"] = turn, max(-89.0, min(89.0, tilt))

  def screen_place(p):
      need_open()
      v = view(p.parts())
      if v[2] < NEAR3:
          return Place(math.nan, math.nan)
      f = focal()
      return Place(win["size"][0] / 2.0 + v[0] * f / v[2], win["size"][1] / 2.0 - v[1] * f / v[2])

  def block(middle, w, h, d, c):
      need_open()
      if not (w > 0 and h > 0 and d > 0):
          raise RunError(0, "a block's width, height and depth must all be more than 0.")
      col = colour(c)
      mx, my, mz = middle.parts()[:3]
      x0, x1, y0, y1, z0, z1 = mx - w / 2, mx + w / 2, my - h / 2, my + h / 2, mz - d / 2, mz + d / 2
      faces = [((0, 0, -1), (x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0)),
               ((0, 0, 1), (x1, y0, z1), (x0, y0, z1), (x0, y1, z1), (x1, y1, z1)),
               ((-1, 0, 0), (x0, y0, z1), (x0, y0, z0), (x0, y1, z0), (x0, y1, z1)),
               ((1, 0, 0), (x1, y0, z0), (x1, y0, z1), (x1, y1, z1), (x1, y1, z0)),
               ((0, 1, 0), (x0, y1, z0), (x1, y1, z0), (x1, y1, z1), (x0, y1, z1)),
               ((0, -1, 0), (x0, y0, z1), (x1, y0, z1), (x1, y0, z0), (x0, y0, z0))]
      for n, a, b, c_, d_ in faces:
          cx, cy, cz = (a[0] + c_[0]) / 2, (a[1] + c_[1]) / 2, (a[2] + c_[2]) / 2
          if n[0] * (EYE["x"] - cx) + n[1] * (EYE["y"] - cy) + n[2] * (EYE["z"] - cz) <= 0:
              continue
          lit = n[0] * SUN[0] + n[1] * SUN[1] + n[2] * SUN[2]
          polygon3([a, b, c_, d_], shade(col, 0.6 + 0.4 * max(0.0, lit)))

  def ball(middle, radius, c):
      need_open()
      if not radius > 0:
          raise RunError(0, "a ball's radius must be more than 0.")
      ITEMS3.append((True, tuple(middle.parts()[:3]), radius, colour(c), 0.0))

  def ground(a, b):
      need_open()
      ca, cb = colour(a), colour(b)
      size, reach = 2.0, 12
      cx, cz = int(math.floor(EYE["x"] / size)), int(math.floor(EYE["z"] / size))
      for i in range(cx - reach, cx + reach):
          for j in range(cz - reach, cz + reach):
              polygon3([(i * size, 0.0, j * size), ((i + 1) * size, 0.0, j * size), ((i + 1) * size, 0.0, (j + 1) * size),
                        (i * size, 0.0, (j + 1) * size)], cb if (i + j) & 1 else ca, 1e9)

  def graphics_card():
      return win["opened"] and gl_start()

to open a world, given title (text) and width (a number) and height (a number) = imagine_window::open({title}, {width}, {height}, {line})
  runs: open_window({title}, {width}, {height})
to consume the window, given colour (text) = imagine_window::clear({colour}, {line})
  runs: clear({colour})
to etch a box, given x (a number) and y (a number) and width (a number) and height (a number) and colour (text) = imagine_window::box({x}, {y}, {width}, {height}, {colour}, {line})
  runs: box({x}, {y}, {width}, {height}, {colour})
to etch a square, given x (a number) and y (a number) and radius (a number) and colour (text) = imagine_window::box(({x}) - ({radius}), ({y}) - ({radius}), 2 * ({radius}), 2 * ({radius}), {colour}, {line})
  runs: box({x} - {radius}, {y} - {radius}, 2 * {radius}, 2 * {radius}, {colour})
to etch a circle, given x (a number) and y (a number) and radius (a number) and colour (text) = imagine_window::circle({x}, {y}, {radius}, {colour}, {line})
  runs: circle({x}, {y}, {radius}, {colour})
to etch a line, given x (a number) and y (a number) and to x (a number) and to y (a number) and colour (text) = imagine_window::line_between({x}, {y}, {to x}, {to y}, {colour}, {line})
  runs: line_between({x}, {y}, {to x}, {to y}, {colour})
to etch words, given words (text) and x (a number) and y (a number) and colour (text) = imagine_window::write({words}, {x}, {y}, {colour}, {line})
  runs: write({words}, {x}, {y}, {colour})
to set the text size to, given size (a number) = imagine_window::set_text_size({size}, {line})
  runs: set_text_size({size})
to reveal the frame = imagine_window::show({line})
  runs: show()
to etch the picture, given file (text) and x (a number) and y (a number) = imagine_window::draw_picture({file}, {x}, {y}, {line})
  runs: draw_picture({file}, {x}, {y})
to etch the picture turned, given file (text) and x (a number) and y (a number) and size (a number) and angle (a number) = imagine_window::draw_picture_turned({file}, {x}, {y}, {size}, {angle}, {line})
  runs: draw_picture_turned({file}, {x}, {y}, {size}, {angle})
to width of picture, given file (text), giving back a number = (double)imagine_window::picture({file}, {line})->GetWidth()
  runs: size_of_picture({file}, 0)
to height of picture, given file (text), giving back a number = (double)imagine_window::picture({file}, {line})->GetHeight()
  runs: size_of_picture({file}, 1)
to end the world = imagine_window::close()
  runs: close()
to key held, given key (text), giving back yes or no = (imagine_window::keys[imagine_window::key_code({key}, {line})])
  runs: key_name({key}) in win["held"]

the world lives = imagine_window::open_now, yes or no, read only
  runs: win["open"]
width of the world = (double)imagine_window::width, number, read only
  runs: float(win.get("size", (0, 0))[0])
height of the world = (double)imagine_window::height, number, read only
  runs: float(win.get("size", (0, 0))[1])
mouse x = imagine_window::mouse_x_now, number, read only
  runs: win["mouse"][0]
mouse y = imagine_window::mouse_y_now, number, read only
  runs: win["mouse"][1]
to key pressed, given key (text), giving back yes or no = (imagine_window::pressed[imagine_window::key_code({key}, {line})])
  runs: key_name({key}) in win["pressed"]
mouse clicked = imagine_window::clicked, yes or no, read only
  runs: win["clicked"]
frame time = imagine_window::frame_time, number, read only
  runs: win["frame time"]
mouse held = imagine_window::mouse_down, yes or no, read only
  runs: win["down"]

note: 3D. The eye is where the picture is seen from. Across is horizontal, up is vertical (more is higher), away is depth.
to place the eye at, given where (a place) = imagine_window::place_eye({where})
  runs: place_eye({where})
to aim the eye, given turn (a number) and tilt (a number) = imagine_window::aim_eye({turn}, {tilt})
  runs: aim_eye({turn}, {tilt})
to screen place of, given where (a place), giving back a flat place = (imagine_window::need_open({line}), imagine_window::screen_place({where}))
  runs: screen_place({where})
to etch a block, given middle (a place) and width (a number) and height (a number) and depth (a number) and colour (text) = imagine_window::block({middle}, {width}, {height}, {depth}, {colour}, {line})
  runs: block({middle}, {width}, {height}, {depth}, {colour})
to etch a cube, given middle (a place) and size (a number) and colour (text) = imagine_window::cube({middle}, {size}, {colour}, {line})
  runs: (lambda s: block({middle}, s, s, s, {colour}))({size})
to etch a ball, given middle (a place) and radius (a number) and colour (text) = imagine_window::ball({middle}, {radius}, {colour}, {line})
  runs: ball({middle}, {radius}, {colour})
to etch the ground, given colour (text) and other colour (text) = imagine_window::ground({colour}, {other colour}, {line})
  runs: ground({colour}, {other colour})
the graphics card draws = imagine_window::on_graphics_card(), yes or no, read only
  runs: graphics_card()

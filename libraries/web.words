code:
  #ifndef _WIN32
  namespace fathom_web
  {
  	// Linux: the system's curl, never through a shell
  	inline bool curl(std::vector<std::string> words, std::string* out, bool fail_on_error = true)
  	{
  		words.insert(words.begin(), {"curl", fail_on_error ? "-sSfL" : "-sSL", "-A", "Fathom", "--max-time", "60"});
  		std::vector<char*> argv;
  		for (auto& w : words)
  			argv.push_back(w.data());
  		argv.push_back(nullptr);
  		int pipe_ends[2];
  		if (pipe(pipe_ends))
  			return false;
  		posix_spawn_file_actions_t acts;
  		posix_spawn_file_actions_init(&acts);
  		posix_spawn_file_actions_adddup2(&acts, pipe_ends[1], 1);
  		posix_spawn_file_actions_addopen(&acts, 2, "/dev/null", O_WRONLY, 0);
  		posix_spawn_file_actions_addclose(&acts, pipe_ends[0]);
  		pid_t pid;
  		int bad = posix_spawnp(&pid, "curl", &acts, nullptr, argv.data(), environ);
  		posix_spawn_file_actions_destroy(&acts);
  		close(pipe_ends[1]);
  		char chunk[4096];
  		for (ssize_t got; (got = read(pipe_ends[0], chunk, sizeof chunk)) > 0;)
  			if (out)
  				out->append(chunk, got);
  		close(pipe_ends[0]);
  		int status = 0;
  		if (bad || waitpid(pid, &status, 0) < 0)
  			return false;
  		return WIFEXITED(status) && WEXITSTATUS(status) == 0;
  	}
  	inline std::string get(const std::string& address, int line)
  	{
  		std::string all;
  		if (!curl({"--", address}, &all))
  			fathom::fail(line, "I couldn't get the web page \"" + address + "\".");
  		return all;
  	}
  	inline void download(const std::string& address, const std::string& name, int line)
  	{
  		if (!curl({"-o", name, "--", address}, nullptr))
  			fathom::fail(line, "I couldn't download \"" + address + "\".");
  	}
  	inline std::string send(const std::string& address, const std::string& body, int line)
  	{
  		char held[] = "/tmp/fathom_sendXXXXXX";
  		int fd = mkstemp(held);
  		bool wrote = fd >= 0 && write(fd, body.data(), body.size()) == (ssize_t)body.size();
  		if (fd >= 0)
  			close(fd);
  		std::string all;
  		bool ok = wrote && curl({"-H", "Content-Type: text/plain; charset=utf-8", "--data-binary", std::string("@") + held, "--", address}, &all);
  		unlink(held);
  		if (!ok)
  			fathom::fail(line, "I couldn't send to the web page \"" + address + "\".");
  		return all;
  	}
  	inline double last_status = 0;
  	inline std::string last_headers;
  	inline std::string header_in(const std::string& raw, const std::string& name)  // one header's value, any capitals
  	{
  		std::istringstream lines(raw);
  		std::string want = fathom::lower(name) + ":";
  		for (std::string h; std::getline(lines, h);)
  			if (fathom::lower(h.substr(0, want.size())) == want)
  			{
  				std::string v = h.substr(want.size());
  				size_t a = v.find_first_not_of(" \t"), b = v.find_last_not_of(" \t\r");
  				return a == std::string::npos ? "" : v.substr(a, b - a + 1);
  			}
  		return "";
  	}
  	inline std::string ask(const std::string& address, const std::string& way, const std::string& message, const std::string& headers, int line)
  	{
  		char heads[] = "/tmp/fathom_headsXXXXXX";
  		int hfd = mkstemp(heads);
  		if (hfd >= 0)
  			close(hfd);
  		std::vector<std::string> words = {"-X", way, "-w", "\n%{http_code}", "-D", heads};
  		bool typed = false;
  		std::istringstream lines(headers);
  		for (std::string h; std::getline(lines, h);)
  			if (!h.empty())
  			{
  				typed = typed || h.rfind("Content-Type", 0) == 0 || h.rfind("content-type", 0) == 0;
  				words.insert(words.end(), {"-H", h});
  			}
  		char held[] = "/tmp/fathom_askXXXXXX";
  		bool sending = !message.empty(), wrote = true;
  		if (sending)
  		{
  			int fd = mkstemp(held);
  			wrote = fd >= 0 && write(fd, message.data(), message.size()) == (ssize_t)message.size();
  			if (fd >= 0)
  				close(fd);
  			if (!typed)
  				words.insert(words.end(), {"-H", "Content-Type: text/plain; charset=utf-8"});
  			words.insert(words.end(), {"--data-binary", std::string("@") + held});
  		}
  		words.insert(words.end(), {"--", address});
  		std::string all;
  		bool ok = wrote && curl(words, &all, false);
  		if (sending)
  			unlink(held);
  		std::ifstream came(heads, std::ios::binary);
  		std::ostringstream read_heads;
  		read_heads << came.rdbuf();
  		came.close();
  		unlink(heads);
  		last_headers = read_heads.str();
  		size_t cut = all.rfind('\n');
  		if (!ok || cut == std::string::npos)
  			fathom::fail(line, "I couldn't reach the web page \"" + address + "\".");
  		last_status = std::atof(all.c_str() + cut + 1);
  		return all.substr(0, cut);
  	}
  }
  #else
  namespace fathom_web
  {
  	inline std::string get(const std::string& address, int line)
  	{
  		wchar_t folder[MAX_PATH], file[MAX_PATH];
  		GetTempPathW(MAX_PATH, folder);
  		GetTempFileNameW(folder, L"img", 0, file);
  		std::wstring w(MultiByteToWideChar(CP_UTF8, 0, address.c_str(), (int)address.size(), nullptr, 0), L'\0');
  		MultiByteToWideChar(CP_UTF8, 0, address.c_str(), (int)address.size(), w.data(), (int)w.size());
  		DeleteUrlCacheEntryW(w.c_str());
  		if (URLDownloadToFileW(nullptr, w.c_str(), file, 0, nullptr) != S_OK)
  		{
  			DeleteFileW(file);
  			fathom::fail(line, "I couldn't get the web page \"" + address + "\".");
  		}
  		std::ifstream in(file, std::ios::binary);
  		std::ostringstream all;
  		all << in.rdbuf();
  		in.close();
  		DeleteFileW(file);
  		return all.str();
  	}
  	inline std::wstring wide(const std::string& s)
  	{
  		std::wstring w(MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0), L'\0');
  		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), w.data(), (int)w.size());
  		return w;
  	}
  	inline void download(const std::string& address, const std::string& name, int line)
  	{
  		std::wstring w = wide(address);
  		DeleteUrlCacheEntryW(w.c_str());
  		if (URLDownloadToFileW(nullptr, w.c_str(), wide(name).c_str(), 0, nullptr) != S_OK)
  			fathom::fail(line, "I couldn't download \"" + address + "\".");
  	}
  	inline std::string send(const std::string& address, const std::string& body, int line)
  	{
  		std::wstring w = wide(address);
  		URL_COMPONENTSW parts{sizeof parts};
  		wchar_t host[256] = {}, path[2048] = {};
  		parts.lpszHostName = host;
  		parts.dwHostNameLength = 256;
  		parts.lpszUrlPath = path;
  		parts.dwUrlPathLength = 2048;
  		std::string all;
  		bool ok = false;
  		if (InternetCrackUrlW(w.c_str(), 0, 0, &parts))
  		{
  			HINTERNET net = InternetOpenW(L"Fathom", INTERNET_OPEN_TYPE_PRECONFIG, nullptr, nullptr, 0);
  			HINTERNET site = net ? InternetConnectW(net, host, parts.nPort, nullptr, nullptr, INTERNET_SERVICE_HTTP, 0, 0) : nullptr;
  			DWORD flags = INTERNET_FLAG_RELOAD | (parts.nScheme == INTERNET_SCHEME_HTTPS ? INTERNET_FLAG_SECURE : 0);
  			HINTERNET ask = site ? HttpOpenRequestW(site, L"POST", path, nullptr, nullptr, nullptr, flags, 0) : nullptr;
  			const wchar_t* header = L"Content-Type: text/plain; charset=utf-8\r\n";
  			if (ask && HttpSendRequestW(ask, header, (DWORD)-1, (void*)body.data(), (DWORD)body.size()))
  			{
  				DWORD status = 0, size = sizeof status;
  				HttpQueryInfoW(ask, HTTP_QUERY_STATUS_CODE | HTTP_QUERY_FLAG_NUMBER, &status, &size, nullptr);
  				char chunk[4096];
  				for (DWORD got = 0; InternetReadFile(ask, chunk, sizeof chunk, &got) && got > 0;)
  					all.append(chunk, got);
  				ok = status < 400;
  			}
  			for (HINTERNET h : {ask, site, net})
  				if (h)
  					InternetCloseHandle(h);
  		}
  		if (!ok)
  			fathom::fail(line, "I couldn't send to the web page \"" + address + "\".");
  		return all;
  	}
  	inline double last_status = 0;
  	inline std::string last_headers;
  	inline std::string header_in(const std::string& raw, const std::string& name)  // one header's value, any capitals
  	{
  		std::istringstream lines(raw);
  		std::string want = fathom::lower(name) + ":";
  		for (std::string h; std::getline(lines, h);)
  			if (fathom::lower(h.substr(0, want.size())) == want)
  			{
  				std::string v = h.substr(want.size());
  				size_t a = v.find_first_not_of(" \t"), b = v.find_last_not_of(" \t\r");
  				return a == std::string::npos ? "" : v.substr(a, b - a + 1);
  			}
  		return "";
  	}
  	inline std::string ask(const std::string& address, const std::string& way, const std::string& message, const std::string& headers, int line)
  	{
  		URL_COMPONENTSW parts{sizeof parts};
  		wchar_t host[256] = {}, path[2048] = {}, extra[2048] = {};
  		parts.lpszHostName = host;
  		parts.dwHostNameLength = 256;
  		parts.lpszUrlPath = path;
  		parts.dwUrlPathLength = 2048;
  		parts.lpszExtraInfo = extra;  // the ?query after the path
  		parts.dwExtraInfoLength = 2048;
  		std::wstring sent;
  		bool typed = false;
  		std::istringstream lines(headers);
  		for (std::string h; std::getline(lines, h);)
  			if (!h.empty())
  			{
  				typed = typed || h.rfind("Content-Type", 0) == 0 || h.rfind("content-type", 0) == 0;
  				sent += wide(h) + L"\r\n";
  			}
  		if (!message.empty() && !typed)
  			sent += L"Content-Type: text/plain; charset=utf-8\r\n";
  		std::string all;
  		bool ok = false;
  		if (InternetCrackUrlW(wide(address).c_str(), 0, 0, &parts))
  		{
  			std::wstring target = std::wstring(path) + extra;
  			HINTERNET net = InternetOpenW(L"Fathom", INTERNET_OPEN_TYPE_PRECONFIG, nullptr, nullptr, 0);
  			HINTERNET site = net ? InternetConnectW(net, host, parts.nPort, nullptr, nullptr, INTERNET_SERVICE_HTTP, 0, 0) : nullptr;
  			DWORD flags = INTERNET_FLAG_RELOAD | (parts.nScheme == INTERNET_SCHEME_HTTPS ? INTERNET_FLAG_SECURE : 0);
  			HINTERNET ask = site ? HttpOpenRequestW(site, wide(way).c_str(), target.c_str(), nullptr, nullptr, nullptr, flags, 0) : nullptr;
  			if (ask && HttpSendRequestW(ask, sent.empty() ? nullptr : sent.c_str(), (DWORD)-1, (void*)message.data(), (DWORD)message.size()))
  			{
  				DWORD status = 0, size = sizeof status;
  				HttpQueryInfoW(ask, HTTP_QUERY_STATUS_CODE | HTTP_QUERY_FLAG_NUMBER, &status, &size, nullptr);
  				DWORD head_size = 0;
  				HttpQueryInfoA(ask, HTTP_QUERY_RAW_HEADERS_CRLF, nullptr, &head_size, nullptr);
  				last_headers.assign(head_size, '\0');
  				if (!head_size || !HttpQueryInfoA(ask, HTTP_QUERY_RAW_HEADERS_CRLF, last_headers.data(), &head_size, nullptr))
  					last_headers.clear();
  				last_headers.resize(head_size);
  				char chunk[4096];
  				for (DWORD got = 0; InternetReadFile(ask, chunk, sizeof chunk, &got) && got > 0;)
  					all.append(chunk, got);
  				last_status = status;
  				ok = true;
  			}
  			for (HINTERNET h : {ask, site, net})
  				if (h)
  					InternetCloseHandle(h);
  		}
  		if (!ok)
  			fathom::fail(line, "I couldn't reach the web page \"" + address + "\".");
  		return all;
  	}
  }
  #endif

python:
  import urllib.request
  def get(address):
      try:
          request = urllib.request.Request(address, headers={"User-Agent": "Fathom"})
          with urllib.request.urlopen(request, timeout=30) as reply:
              return reply.read().decode("utf-8", errors="replace")
      except Exception:
          raise RunError(0, f'I couldn\'t get the web page "{address}".')
  def download(address, name):
      try:
          request = urllib.request.Request(address, headers={"User-Agent": "Fathom"})
          with urllib.request.urlopen(request, timeout=60) as reply, open(name, "wb") as out:
              out.write(reply.read())
      except Exception:
          raise RunError(0, f'I couldn\'t download "{address}".')
  def send(address, message):
      try:
          request = urllib.request.Request(address, data=message.encode("utf-8"), method="POST",
                                           headers={"User-Agent": "Fathom", "Content-Type": "text/plain; charset=utf-8"})
          with urllib.request.urlopen(request, timeout=30) as reply:
              return reply.read().decode("utf-8", errors="replace")
      except Exception:
          raise RunError(0, f'I couldn\'t send to the web page "{address}".')
  last_status = [0.0]
  last_headers = [{}]
  def last_header(name):
      return last_headers[0].get(name.lower(), "")
  def ask(address, way, message, headers):
      sent = {"User-Agent": "Fathom"}
      for h in headers.splitlines():
          if ":" in h:
              sent[h.split(":", 1)[0].strip()] = h.split(":", 1)[1].strip()
      if message and not any(k.lower() == "content-type" for k in sent):
          sent["Content-Type"] = "text/plain; charset=utf-8"
      request = urllib.request.Request(address, data=message.encode("utf-8") if message else None, method=way, headers=sent)
      try:
          with urllib.request.urlopen(request, timeout=30) as reply:
              last_status[0] = float(reply.status)
              last_headers[0] = {k.lower(): v for k, v in reply.headers.items()}
              return reply.read().decode("utf-8", errors="replace")
      except urllib.error.HTTPError as reply:  # 404 and the like are answers too
          last_status[0] = float(reply.code)
          last_headers[0] = {k.lower(): v for k, v in reply.headers.items()}
          return reply.read().decode("utf-8", errors="replace")
      except Exception:
          raise RunError(0, f'I couldn\'t reach the web page "{address}".')

to web page, given address (text), returning text = fathom_web::get({address}, {line})
  runs: get({address})
  web: (await fathom_web::get({address}, {line}))
to download, given address (text) and file (text) = fathom_web::download({address}, {file}, {line})
  runs: download({address}, {file})
  web: (await fathom_web::download({address}, {file}, {line}))
to send to the web page, given address (text) and message (text), returning text = fathom_web::send({address}, {message}, {line})
  runs: send({address}, {message})
  web: (await fathom_web::send({address}, {message}, {line}))
to ask the web, given address (text) and way (text) and message (text, usually "") and headers (text, usually ""), returning text = fathom_web::ask({address}, {way}, {message}, {headers}, {line})
  runs: ask({address}, {way}, {message}, {headers})
  web: (await fathom_web::ask({address}, {way}, {message}, {headers}, {line}))
the last web status = fathom_web::last_status, number, read only
  runs: last_status[0]
  web: fathom_web.status
to the last web header, given name (text), returning text = fathom_web::header_in(fathom_web::last_headers, {name})
  runs: last_header({name})
  web: fathom_web.header({name})

javascript:
  const fathom_web = {
    async fetched(address, options, line, problem) {
      try {
        const reply = await fetch(address, options);
        if (!reply.ok) throw new Error(String(reply.status));
        return reply;
      } catch {
        fathom.fail(line, problem);
      }
    },
    get: async (address, line) => (await fathom_web.fetched(address, {}, line, `I couldn't get the web page "${address}".`)).text(),
    async send(address, message, line) {
      const options = { method: "POST", headers: { "Content-Type": "text/plain; charset=utf-8" }, body: message };
      return (await fathom_web.fetched(address, options, line, `I couldn't send to the web page "${address}".`)).text();
    },
    status: 0,
    headers: new Map(),
    header: (name) => fathom_web.headers.get(name) ?? "",
    async ask(address, way, message, headers, line) {
      const sent = {};
      for (const h of headers.split(/\r?\n/)) if (h.includes(":")) sent[h.slice(0, h.indexOf(":")).trim()] = h.slice(h.indexOf(":") + 1).trim();
      if (message && !Object.keys(sent).some((k) => k.toLowerCase() === "content-type")) sent["Content-Type"] = "text/plain; charset=utf-8";
      let reply;
      try {
        reply = await fetch(address, { method: way, headers: sent, body: message || undefined });
      } catch {
        fathom.fail(line, `I couldn't reach the web page "${address}".`);
      }
      fathom_web.status = reply.status;
      fathom_web.headers = reply.headers;
      return reply.text();
    },
    async download(address, file, line) {
      const problem = `I couldn't download "${address}".`;
      const bytes = new Uint8Array(await (await fathom_web.fetched(address, {}, line, problem)).arrayBuffer());
      try {
        require("fs").writeFileSync(file, bytes);
      } catch {
        fathom.fail(line, problem);
      }
    },
  };
